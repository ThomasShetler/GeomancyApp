@using GeomancyWebUI.Client.Helpers

@*
    Inline SVG glyphs for aspects, classical perfection modes, and company types.
    Used in list rows and detail panel headers.
*@

<span class="perf-icon @CssClass @SizeClass" title="@Title" aria-hidden="true">
    @switch (EffectiveKind)
    {
        case PerfectionIconKind.Aspect:
            @RenderAspectSvg(EffectiveVariant)
            break;
        case PerfectionIconKind.Company:
            @RenderCompanySvg(EffectiveVariant)
            break;
        case PerfectionIconKind.Denial:
            @RenderDenialSvg()
            break;
        default:
            @RenderModeSvg(EffectiveVariant)
            break;
    }
</span>

@code {
    [Parameter] public PerfectionIconKind Kind { get; set; } = PerfectionIconKind.Mode;

    [Parameter] public string Variant { get; set; } = "generic";
    [Parameter] public string? Mode { get; set; }
    [Parameter] public string? AspectType { get; set; }
    [Parameter] public string? CompanyType { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Large { get; set; }

    private PerfectionIconKind EffectiveKind =>
        Mode != null || AspectType != null || CompanyType != null
            ? PerfectionIconHelper.ResolveKind(Mode, AspectType)
            : Kind;

    private string EffectiveVariant =>
        Mode != null || AspectType != null || CompanyType != null
            ? PerfectionIconHelper.ResolveVariant(Mode, AspectType, CompanyType)
            : Variant;

    private string CssClass =>
        Mode != null || AspectType != null || CompanyType != null
            ? PerfectionIconHelper.CssClass(Mode, AspectType, CompanyType)
            : Kind switch
            {
                PerfectionIconKind.Aspect => AspectDirectionHelper.AspectTypeClass(Variant),
                PerfectionIconKind.Company => $"icon-company icon-company-{Variant}",
                PerfectionIconKind.Denial => "icon-denial",
                _ => $"icon-mode icon-mode-{Variant}"
            };

    private string SizeClass => Large ? "perf-icon-lg" : string.Empty;

    private RenderFragment RenderAspectSvg(string variant) => variant switch
    {
        "sextile" => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 2L13.2 5V11L8 14L2.8 11V5L8 2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M8 2V14M2.8 5L13.2 11M13.2 5L2.8 11" stroke="currentColor" stroke-width="1.1" opacity="0.85"/>
        </svg>,
        "trine" => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 2.5L13.5 12H2.5L8 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <circle cx="8" cy="8.5" r="1.1" fill="currentColor"/>
        </svg>,
        "square" => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3.5" y="3.5" width="9" height="9" stroke="currentColor" stroke-width="1.4" rx="0.5"/>
            <path d="M3.5 3.5L12.5 12.5M12.5 3.5L3.5 12.5" stroke="currentColor" stroke-width="1.1" opacity="0.85"/>
        </svg>,
        "opposition" => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="4.5" cy="8" r="2.2" stroke="currentColor" stroke-width="1.3"/>
            <circle cx="11.5" cy="8" r="2.2" stroke="currentColor" stroke-width="1.3"/>
            <path d="M6.7 8H9.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>,
        "conjunction" => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="8" cy="8" r="4.5" stroke="currentColor" stroke-width="1.4"/>
            <circle cx="8" cy="8" r="1.4" fill="currentColor"/>
        </svg>,
        _ => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="8" cy="8" r="4.5" stroke="currentColor" stroke-width="1.3" stroke-dasharray="2 1.5"/>
        </svg>
    };

    private RenderFragment RenderModeSvg(string variant) => variant switch
    {
        "occupation" => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 7.5V13H13V7.5L8 4L3 7.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
            <path d="M6 13V9.5H10V13" stroke="currentColor" stroke-width="1.2"/>
            <circle cx="8" cy="8.2" r="1.1" fill="currentColor"/>
        </svg>,
        "conjunction" => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="6.2" cy="8" r="2.8" stroke="currentColor" stroke-width="1.3"/>
            <circle cx="9.8" cy="8" r="2.8" stroke="currentColor" stroke-width="1.3"/>
            <path d="M7.5 8H8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>,
        "translation" => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="3.5" cy="8" r="1.6" stroke="currentColor" stroke-width="1.2"/>
            <circle cx="8" cy="8" r="2.2" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="1.3"/>
            <circle cx="12.5" cy="8" r="1.6" stroke="currentColor" stroke-width="1.2"/>
            <path d="M5.1 8H5.8M10.2 8H10.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>,
        "mutation" => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 5.5L7 8.5L4 11.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 5.5L9 8.5L12 11.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M7.5 4.5L8.5 11.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.7"/>
        </svg>,
        _ => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="3" width="10" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
        </svg>
    };

    private RenderFragment RenderCompanySvg(string variant) => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="2.5" y="5" width="4.5" height="6" rx="0.8" stroke="currentColor" stroke-width="1.2"/>
        <rect x="9" y="5" width="4.5" height="6" rx="0.8" stroke="currentColor" stroke-width="1.2"/>
        <path d="M7 8H9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        @if (variant == "simple")
        {
            <circle cx="8" cy="8" r="1" fill="currentColor"/>
        }
        else if (variant == "demisimple")
        {
            <path d="M7.2 7.2L8.8 8.8M8.8 7.2L7.2 8.8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        }
        else if (variant == "compound")
        {
            <path d="M7 6.5L9 9.5M9 6.5L7 9.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        }
        else if (variant == "capitular")
        {
            <path d="M6.5 8H9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M8 6.5V9.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.7"/>
        }
    </svg>;

    private RenderFragment RenderDenialSvg() => @<svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.3"/>
        <path d="M5.5 5.5L10.5 10.5M10.5 5.5L5.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>;
}
