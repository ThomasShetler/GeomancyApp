@* One interactive boundary for the whole app shell (layout + pages) so Scoped
   services like ThemeService are not split across separate islands. Do not use
   a wrapper with ChildContent + @rendermode — RenderFragment cannot cross that boundary. *@
@rendermode InteractiveServer

<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Client._Imports).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Geofancy - Not Found</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="not-found" role="alert">
                <h1 class="not-found-title">Page not found</h1>
                <p class="not-found-lead">
                    There is no page at this address. Try the home page, the wiki, or cast a chart to open the workspace.
                </p>
                <ul class="not-found-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/wiki">Geomancy Wiki</a></li>
                    <li><a href="/workspace">Desktop workspace</a></li>
                    <li><a href="/mobile">Mobile workspace</a></li>
                </ul>
            </div>
        </LayoutView>
    </NotFound>
</Router>
