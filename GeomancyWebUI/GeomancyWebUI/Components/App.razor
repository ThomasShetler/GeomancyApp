<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="@Branding.AssetUrl("app.css")" />
    <link rel="stylesheet" href="@Branding.AssetUrl("chart-surface.css")" />
    <link rel="stylesheet" href="@Branding.AssetUrl("wiki.css")" />
    <link rel="stylesheet" href="@Branding.AssetUrl("casting-mobile-shell.css")" />
    <link rel="stylesheet" href="@Branding.AssetUrl("figure-dot-caster.css")" />
    <link rel="stylesheet" href="@Branding.AssetUrl("GeomancyWebUI.styles.css")" />
    <link rel="icon" type="image/png" href="@Branding.FaviconUrl" />
    <link rel="apple-touch-icon" href="@Branding.LogoAppleUrl" />
    <link rel="preload" href="@Branding.LogoUrl" as="image" type="image/png" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <!-- Fallback for crawlers before Blazor hydrates; per-page tags override via PageSeo. -->
    <meta name="description" content="Free geomancy software for shield and house charts, perfections, Way of Points, a live wiki, and interactive casting walkthroughs." />
    <meta name="keywords" content="geomancy, geofancy, shield chart, perfections, way of points, geomantic figures" />
    <meta property="og:site_name" content="Geofancy" />
    <meta property="og:locale" content="en_US" />
    <link rel="canonical" href="https://geofancy.up.railway.app/" />
    <script src="@Branding.AssetUrl("theme.js")"></script>
    <script>
        window.geofancyTheme.applyInitial();

        // Auto-route mobile viewports off /workspace (which enforces min-width
        // 1380px and breaks visually on phones). Runs synchronously before
        // Blazor boots, so phones never see a flash of the broken desktop
        // layout. The inverse redirect (mobile -> workspace) is intentionally
        // omitted: /mobile renders fine on desktop too, so a desktop user
        // who lands there - whether by clicking "Mobile View" in the nav,
        // pasting a deep link, or testing - stays put.
        (function () {
            var path = (window.location.pathname || '').toLowerCase();
            var isPhone = window.geofancyDevice && typeof window.geofancyDevice.isMobile === 'function' &&
                window.geofancyDevice.isMobile();
            if (path === '/workspace' && isPhone) {
                window.location.replace('/mobile' + window.location.search + window.location.hash);
            }
        })();
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Branding.AssetUrl("clipboard.js")"></script>
</body>

</html>
