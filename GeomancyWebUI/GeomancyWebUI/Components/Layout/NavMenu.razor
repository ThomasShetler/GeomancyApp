@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="@Branding.LogoUrl" alt="" class="navbar-brand-logo" width="32" height="32" decoding="async" aria-hidden="true" />
            <span class="navbar-brand-text">Geofancy</span>
        </a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler"
       aria-label="Open navigation menu" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column" aria-label="Main navigation">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/wiki" Match="NavLinkMatch.Prefix">
                <span class="oi oi-book" aria-hidden="true"></span> Wiki
            </NavLink>
        </div>

        <div class="nav-item px-3" @onclick:stopPropagation="true">
            <button type="button" class="nav-link nav-link-button" @onclick="GoToWorkspaceAsync">
                <span class="oi oi-grid-three-up" aria-hidden="true"></span> Workspace
            </button>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/mobile" Match="NavLinkMatch.Prefix">
                <span class="oi oi-phone" aria-hidden="true"></span> Mobile workspace
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/about" Match="NavLinkMatch.All">
                <span class="oi oi-info" aria-hidden="true"></span> About
            </NavLink>
        </div>

        <div class="nav-item px-3 nav-theme-item" @onclick:stopPropagation="true">
            <ThemeToggleButton />
        </div>
    </nav>
</div>

@code {
    private async Task GoToWorkspaceAsync()
    {
        var isMobile = await JS.InvokeAsync<bool>("geofancyDeviceIsMobile");
        Nav.NavigateTo(isMobile ? "/mobile" : "/workspace");
    }
}
