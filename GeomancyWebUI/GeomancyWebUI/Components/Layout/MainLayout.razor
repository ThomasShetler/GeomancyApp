@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main id="main-content">
        <a class="skip-link" href="#content-start">Skip to main content</a>
        <article id="content-start" class="content px-4">
            @Body
        </article>
        @if (!IsImmersiveRoute)
        {
            <SiteFooter />
        }
    </main>
</div>

@code {
    // Theme: Scoped ThemeService is one per circuit because Routes.razor uses
    // @rendermode InteractiveServer for the whole Router subtree (nav + @Body).

    /// <summary>Workspace, mobile, and interactive wiki flows are full-viewport; no global footer.</summary>
    private bool IsImmersiveRoute
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            if (string.IsNullOrEmpty(path))
                return false;
            if (path is "/mobile" or "/workspace" or "/chart")
                return true;
            return path.StartsWith("/wiki/how-to/", StringComparison.Ordinal)
                   && path.Contains("interactive", StringComparison.Ordinal);
        }
    }

}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
