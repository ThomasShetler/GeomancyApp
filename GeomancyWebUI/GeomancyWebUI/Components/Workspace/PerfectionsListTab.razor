@using GeomancyWebUI.Client.Models
@using GeomancyWebUI.Client.Helpers

@*
    Left column of the revamped Perfections tab.
*@

<div class="perfections-list">

    <div class="perf-dropdowns">
        <div class="perf-dropdown">
            <label>Querent</label>
            <select class="form-select"
                    value="@QuerentHouse"
                    @onchange="OnQuerentSelectChange">
                <option value="0">Select House</option>
                @foreach (var (n, text) in HouseOptions)
                {
                    <option value="@n">@text</option>
                }
            </select>
        </div>
        <div class="perf-dropdown">
            <label>Quesited</label>
            <select class="form-select"
                    value="@QuesitedHouse"
                    @onchange="OnQuesitedSelectChange">
                <option value="0">Select House</option>
                @foreach (var (n, text) in HouseOptions)
                {
                    <option value="@n">@text</option>
                }
            </select>
        </div>
    </div>

    @if (QuerentHouse == 0 || QuesitedHouse == 0)
    {
        <div class="perf-empty">
            <p>Pick a Querent and Quesited house to compute perfection.</p>
        </div>
    }
    else if (IsLoading || Analysis == null || !IsAnalysisCurrent)
    {
        <div class="perf-empty perf-loading">
            <p>Calculating favorable and unfavorable scores…</p>
        </div>
    }
    else if (!Analysis.Success)
    {
        <div class="perf-empty perf-error">
            <p>@(string.IsNullOrEmpty(Analysis.Message) ? "Could not analyze perfection." : Analysis.Message)</p>
        </div>
    }
    else
    {
        var verdictClass = Analysis.NetScore > 0
            ? "verdict-favorable"
            : Analysis.NetScore < 0 ? "verdict-unfavorable" : "verdict-neutral";
        var verdictLabel = Analysis.NetScore > 0
            ? "Favorable"
            : Analysis.NetScore < 0 ? "Unfavorable" : "Neutral";

        var classicalCount = CountByMode(IsClassicalPerfection);
        var companyCount = CountByMode(IsCompanyPerfection);

        <div class="perf-verdict @verdictClass">
            <div class="perf-verdict-score">
                <span class="score-sign">@(Analysis.NetScore > 0 ? "+" : "")</span>@Analysis.NetScore
            </div>
            <div class="perf-verdict-meta">
                <div class="perf-verdict-label">@verdictLabel</div>
                <div class="perf-verdict-sub">
                    <span class="favorable-text">+@Analysis.TotalFavorableScore</span>
                    <span class="separator">/</span>
                    <span class="unfavorable-text">@Analysis.TotalUnfavorableScore</span>
                </div>
            </div>
        </div>

        <div class="perf-counts">
            <span class="count-chip count-perfections">
                <span class="count-num">@Analysis.Perfections.Count</span>
                <span class="count-label">Perfections</span>
            </span>
            <span class="count-chip count-denials">
                <span class="count-num">@Analysis.Denials.Count</span>
                <span class="count-label">Denials</span>
            </span>
            <span class="count-chip count-positive">
                <span class="count-num">@Analysis.PositiveAspects.Count</span>
                <span class="count-label">+ Aspects</span>
            </span>
            <span class="count-chip count-negative">
                <span class="count-num">@Analysis.NegativeAspects.Count</span>
                <span class="count-label">- Aspects</span>
            </span>
        </div>

        <div class="perf-lists">

            <section class="perf-group">
                <h3 class="perf-group-title">
                    <span>Perfections</span>
                    <span class="perf-group-count">@(Analysis.Perfections.Count + Analysis.PositiveAspects.Count)</span>
                </h3>

                @if (Analysis.Perfections.Count == 0 && Analysis.PositiveAspects.Count == 0)
                {
                    <p class="perf-group-empty">None.</p>
                }
                else
                {
                    <div class="perf-subgroup">
                        <h4 class="perf-subgroup-title">
                            Classical Modes
                            <span class="perf-subgroup-count">@classicalCount</span>
                        </h4>
                        @if (classicalCount == 0)
                        {
                            <p class="perf-subgroup-empty">None.</p>
                        }
                        else
                        {
                            <ul class="perf-rows">
                                @for (var i = 0; i < Analysis.Perfections.Count; i++)
                                {
                                    var p = Analysis.Perfections[i];
                                    if (!IsClassicalPerfection(p)) continue;
                                    var idx = i;
                                    var sel = new PerfectionSelection(PerfectionEntryKind.Perfection, idx, p, null);
                                    <CompactPerfectionListRow IsSelected="@IsSelected(sel)"
                                                              RowVariant="perfection"
                                                              Mode="@p.Mode"
                                                              BaseMode="@p.BaseMode"
                                                              AspectType="@p.AspectBetweenSignificators"
                                                              AspectDirection="@p.AspectDirection"
                                                              CompanyType="@p.CompanyType"
                                                              FromHouse="@p.QuerentHouse"
                                                              ToHouse="@p.QuesitedHouse"
                                                              FromFigure="@p.QuerentFigure"
                                                              ToFigure="@p.QuesitedFigure"
                                                              Score="@(p.FavorableScore + p.UnfavorableScore)"
                                                              OnClick="@(() => RaiseSelect(sel))" />
                                }
                            </ul>
                        }
                    </div>

                    <div class="perf-subgroup">
                        <h4 class="perf-subgroup-title">
                            By Company
                            <span class="perf-subgroup-count">@companyCount</span>
                        </h4>
                        @if (companyCount == 0)
                        {
                            <p class="perf-subgroup-empty">None.</p>
                        }
                        else
                        {
                            <ul class="perf-rows">
                                @for (var i = 0; i < Analysis.Perfections.Count; i++)
                                {
                                    var p = Analysis.Perfections[i];
                                    if (!IsCompanyPerfection(p)) continue;
                                    var idx = i;
                                    var sel = new PerfectionSelection(PerfectionEntryKind.Perfection, idx, p, null);
                                    <CompactPerfectionListRow IsSelected="@IsSelected(sel)"
                                                              RowVariant="perfection"
                                                              Mode="@p.Mode"
                                                              BaseMode="@p.BaseMode"
                                                              AspectType="@p.AspectBetweenSignificators"
                                                              AspectDirection="@p.AspectDirection"
                                                              CompanyType="@p.CompanyType"
                                                              FromHouse="@p.QuerentHouse"
                                                              ToHouse="@p.QuesitedHouse"
                                                              FromFigure="@p.QuerentFigure"
                                                              ToFigure="@p.QuesitedFigure"
                                                              Score="@(p.FavorableScore + p.UnfavorableScore)"
                                                              OnClick="@(() => RaiseSelect(sel))" />
                                }
                            </ul>
                        }
                    </div>

                    <div class="perf-subgroup">
                        <h4 class="perf-subgroup-title">
                            Positive Aspects
                            <span class="perf-subgroup-count">@Analysis.PositiveAspects.Count</span>
                        </h4>
                        @if (Analysis.PositiveAspects.Count == 0)
                        {
                            <p class="perf-subgroup-empty">None.</p>
                        }
                        else
                        {
                            <ul class="perf-rows">
                                @for (var i = 0; i < Analysis.PositiveAspects.Count; i++)
                                {
                                    var idx = i;
                                    var a = Analysis.PositiveAspects[idx];
                                    var sel = new PerfectionSelection(PerfectionEntryKind.PositiveAspect, idx, null, a);
                                    <CompactPerfectionListRow IsSelected="@IsSelected(sel)"
                                                              RowVariant="aspect-positive"
                                                              AspectType="@a.AspectType"
                                                              AspectDirection="@a.Direction"
                                                              FromHouse="@a.FromHouse"
                                                              ToHouse="@a.ToHouse"
                                                              FromFigure="@GetHouseFigureName(a.FromHouse)"
                                                              ToFigure="@GetHouseFigureName(a.ToHouse)"
                                                              IsMajorAspect="@a.IsMajorAspect"
                                                              Score="@a.FavorableScore"
                                                              OnClick="@(() => RaiseSelect(sel))" />
                                }
                            </ul>
                        }
                    </div>
                }
            </section>

            <section class="perf-group">
                <h3 class="perf-group-title">
                    <span>Denials</span>
                    <span class="perf-group-count">@(Analysis.Denials.Count + Analysis.NegativeAspects.Count)</span>
                </h3>
                @if (Analysis.Denials.Count == 0 && Analysis.NegativeAspects.Count == 0)
                {
                    <p class="perf-group-empty">None.</p>
                }
                else
                {
                    @if (Analysis.Denials.Count > 0)
                    {
                        <ul class="perf-rows">
                            @for (var i = 0; i < Analysis.Denials.Count; i++)
                            {
                                var idx = i;
                                var d = Analysis.Denials[idx];
                                var sel = new PerfectionSelection(PerfectionEntryKind.Denial, idx, d, null);
                                <CompactPerfectionListRow IsSelected="@IsSelected(sel)"
                                                          RowVariant="denial"
                                                          Mode="@d.Mode"
                                                          BaseMode="@d.BaseMode"
                                                          AspectType="@d.AspectBetweenSignificators"
                                                          AspectDirection="@d.AspectDirection"
                                                          CompanyType="@d.CompanyType"
                                                          FromHouse="@d.QuerentHouse"
                                                          ToHouse="@d.QuesitedHouse"
                                                          FromFigure="@d.QuerentFigure"
                                                          ToFigure="@d.QuesitedFigure"
                                                          Score="@(d.FavorableScore + d.UnfavorableScore)"
                                                          OnClick="@(() => RaiseSelect(sel))" />
                            }
                        </ul>
                    }

                    <div class="perf-subgroup">
                        <h4 class="perf-subgroup-title">
                            Negative Aspects
                            <span class="perf-subgroup-count">@Analysis.NegativeAspects.Count</span>
                        </h4>
                        @if (Analysis.NegativeAspects.Count == 0)
                        {
                            <p class="perf-subgroup-empty">None.</p>
                        }
                        else
                        {
                            <ul class="perf-rows">
                                @for (var i = 0; i < Analysis.NegativeAspects.Count; i++)
                                {
                                    var idx = i;
                                    var a = Analysis.NegativeAspects[idx];
                                    var sel = new PerfectionSelection(PerfectionEntryKind.NegativeAspect, idx, null, a);
                                    <CompactPerfectionListRow IsSelected="@IsSelected(sel)"
                                                              RowVariant="aspect-negative"
                                                              AspectType="@a.AspectType"
                                                              AspectDirection="@a.Direction"
                                                              FromHouse="@a.FromHouse"
                                                              ToHouse="@a.ToHouse"
                                                              FromFigure="@GetHouseFigureName(a.FromHouse)"
                                                              ToFigure="@GetHouseFigureName(a.ToHouse)"
                                                              IsMajorAspect="@a.IsMajorAspect"
                                                              Score="@a.UnfavorableScore"
                                                              OnClick="@(() => RaiseSelect(sel))" />
                                }
                            </ul>
                        }
                    </div>
                }
            </section>

        </div>
    }
</div>

@code {
    [Parameter] public HouseChartModel? Chart { get; set; }
    [Parameter] public PerfectionAnalysisModel? Analysis { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int QuerentHouse { get; set; }
    [Parameter] public int QuesitedHouse { get; set; }
    [Parameter] public List<(int Number, string DisplayText)> HouseOptions { get; set; } = new();
    [Parameter] public PerfectionSelection? Selected { get; set; }
    [Parameter] public EventCallback<int> OnQuerentChanged { get; set; }
    [Parameter] public EventCallback<int> OnQuesitedChanged { get; set; }
    [Parameter] public EventCallback<PerfectionSelection> OnSelect { get; set; }

    private bool IsAnalysisCurrent =>
        Analysis != null
        && Analysis.QuerentHouse == QuerentHouse
        && Analysis.QuesitedHouse == QuesitedHouse;

    private async Task OnQuerentSelectChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
            await OnQuerentChanged.InvokeAsync(n);
    }

    private async Task OnQuesitedSelectChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
            await OnQuesitedChanged.InvokeAsync(n);
    }

    private async Task RaiseSelect(PerfectionSelection sel) =>
        await OnSelect.InvokeAsync(sel);

    private bool IsSelected(PerfectionSelection sel) =>
        Selected != null && Selected.Kind == sel.Kind && Selected.Index == sel.Index;

    private int CountByMode(Func<PerfectionModel, bool> predicate) =>
        Analysis?.Perfections.Count(predicate) ?? 0;

    private static bool IsClassicalPerfection(PerfectionModel p) =>
        p.Mode is "Occupation" or "Conjunction" or "Translation" or "Mutation";

    private static bool IsCompanyPerfection(PerfectionModel p) =>
        string.Equals(p.Mode, "Company", StringComparison.OrdinalIgnoreCase);

    private string GetHouseFigureName(int houseNumber)
    {
        if (Chart?.Houses == null || houseNumber <= 0) return string.Empty;
        var house = Chart.Houses.FirstOrDefault(h => h.HouseNumber == houseNumber);
        return house?.Figure?.Name ?? string.Empty;
    }
}
