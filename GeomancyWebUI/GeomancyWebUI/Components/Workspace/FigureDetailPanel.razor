@using System.Linq
@using GeomancyWebUI.Client.Models

<div class="figure-detail-panel @(Selection?.Figure == null ? "is-empty" : "")">
    @if (Selection?.Figure == null)
    {
        <div class="detail-empty-state">
            <p>Select a house or court row to inspect its occupant figure.</p>
        </div>
    }
    else
    {
        var fig = Selection.Figure;
        var planetSymbol = GetPlanetSymbol(fig.Planet);
        var zodiacSymbol = GetZodiacSymbol(fig.Sign);
        var strengthLabel = GetStrengthLabel(fig.HouseStrength);
        var inSlot = ResolveInSlotText(fig);
        var houseEntry = ResolveHouseEntry();
        var courtEntry = ResolveCourtEntry();
        var showInterpretation = HasInterpretationContent(fig);
        var showReference = houseEntry != null || courtEntry != null;
        var showSources = fig.TraditionalSources?.Any() == true;
        var openInterpretation = IsInterpretationOpenByDefault(inSlot);
        var openReference = IsReferenceOpenByDefault(houseEntry, courtEntry);
        var openCorrespondences = IsCorrespondencesOpenByDefault(inSlot);

        <div class="detail-sticky-shell">
            <header class="detail-header">
                <div class="detail-header-titles">
                    <p class="slot-eyebrow">@FormatSlotLabel(Selection)</p>
                    <h2 class="figure-name-display">@fig.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(fig.EnglishName))
                    {
                        <p class="english-name">@fig.EnglishName</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(fig.OtherNames))
                    {
                        <p class="other-names">a.k.a. @fig.OtherNames</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(fig.Tagline))
                    {
                        <p class="figure-tagline">@fig.Tagline</p>
                    }
                </div>
                <div class="detail-header-strength @GetStrengthCssClass(fig.HouseStrength)">@strengthLabel</div>
            </header>

            <div class="chip-row compact-chips">
                @if (!string.IsNullOrWhiteSpace(fig.Planet))
                {
                    <span class="chip chip-planet"><span class="chip-glyph">@planetSymbol</span><span>@fig.Planet</span></span>
                }
                @if (!string.IsNullOrWhiteSpace(fig.Sign))
                {
                    <span class="chip chip-sign"><span class="chip-glyph">@zodiacSymbol</span><span>@fig.Sign</span></span>
                }
                @if (!string.IsNullOrWhiteSpace(fig.Quality)) { <span class="chip chip-quality">@fig.Quality</span> }
                @if (!string.IsNullOrWhiteSpace(fig.Keyword)) { <span class="chip chip-keyword">@fig.Keyword</span> }
                @if (!string.IsNullOrWhiteSpace(fig.Humor))
                {
                    <span class="chip chip-humor" title="Traditional humor">@fig.Humor</span>
                }
            </div>

            <nav class="section-jump-nav" aria-label="Figure detail sections">
                <a href="#section-context">Context</a>
                <a href="#section-verdict">Verdict</a>
                @if (showInterpretation) { <a href="#section-interpretation">Interpretation</a> }
                <a href="#section-correspondences">Correspondences</a>
                @if (showReference) { <a href="#section-reference">Reference</a> }
                @if (showSources) { <a href="#section-sources">Sources</a> }
            </nav>
        </div>

        <section id="section-context" class="detail-card">
            <h3 class="card-title">Immediate Context</h3>
            @if (inSlot != null)
            {
                <div class="context-block is-slot-context">
                    <p class="in-slot-eyebrow">@inSlot.Eyebrow</p>
                    <h4 class="in-slot-title">@inSlot.Title</h4>
                    <p class="prose-text">@inSlot.Body</p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(fig.DivinatoryMeaning))
            {
                <div class="context-block">
                    <h4 class="subheading">Divinatory Meaning</h4>
                    <p class="prose-text">@fig.DivinatoryMeaning</p>
                </div>
            }
            @if (fig.CoreMeaning?.Any() == true)
            {
                <div class="pill-row">
                    @foreach (var tag in fig.CoreMeaning)
                    {
                        <span class="meaning-pill">@tag</span>
                    }
                </div>
            }
        </section>

        <section id="section-verdict" class="detail-card">
            <h3 class="card-title">Reading Verdict</h3>
            <div class="verdict-grid">
                <div class="verdict-col is-favorable">
                    <h4>Favorable</h4>
                    @if (fig.FavorableFor?.Any() == true)
                    {
                        <ul class="bullet-list compact">
                            @foreach (var x in fig.FavorableFor) { <li>@x</li> }
                        </ul>
                    }
                    else
                    {
                        <p class="mini-empty">No entries.</p>
                    }
                </div>
                <div class="verdict-col is-unfavorable">
                    <h4>Unfavorable</h4>
                    @if (fig.UnfavorableFor?.Any() == true)
                    {
                        <ul class="bullet-list compact">
                            @foreach (var x in fig.UnfavorableFor) { <li>@x</li> }
                        </ul>
                    }
                    else
                    {
                        <p class="mini-empty">No entries.</p>
                    }
                </div>
            </div>
        </section>

        @if (showInterpretation)
        {
            <section id="section-interpretation" class="detail-card">
                <details open="@openInterpretation">
                <summary class="details-summary">Interpretation &amp; Imagery</summary>
                <div class="details-body">
                    @if (!string.IsNullOrWhiteSpace(fig.Imagery) || fig.TraditionalImagery?.Any() == true)
                    {
                        <div class="context-block">
                            <h4 class="subheading">Imagery</h4>
                            @if (!string.IsNullOrWhiteSpace(fig.Imagery))
                            {
                                <p class="prose-text">@fig.Imagery</p>
                            }
                            @if (fig.TraditionalImagery?.Any() == true)
                            {
                                <ul class="bullet-list compact">
                                    @foreach (var im in fig.TraditionalImagery) { <li>@im</li> }
                                </ul>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(fig.ElementalSynthesis))
                    {
                        <div class="context-block">
                            <h4 class="subheading">Elemental Synthesis</h4>
                            <p class="prose-text">@fig.ElementalSynthesis</p>
                        </div>
                    }
                    @if (fig.Interpretation?.Any() == true)
                    {
                        <div class="context-block">
                            <h4 class="subheading">Structured Interpretation</h4>
                            @foreach (var para in fig.Interpretation)
                            {
                                <p class="prose-text">@para</p>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(fig.Commentary))
                    {
                        <div class="context-block">
                            <h4 class="subheading">Commentary</h4>
                            <p class="prose-text">@fig.Commentary</p>
                        </div>
                    }
                    @if (fig.ModernExamples?.Any() == true)
                    {
                        <div class="context-block">
                            <h4 class="subheading">Modern Examples</h4>
                            <ul class="bullet-list compact">
                                @foreach (var ex in fig.ModernExamples) { <li>@ex</li> }
                            </ul>
                        </div>
                    }
                </div>
                </details>
            </section>
        }

        <section id="section-correspondences" class="detail-card">
            <details open="@openCorrespondences">
                <summary class="details-summary">Body, Elements &amp; Correspondences</summary>
                <div class="details-body">
                    <div class="elements-strip">
                        @foreach (var el in BuildElements(fig))
                        {
                            <span class="element-pill @el.CssClass @(el.IsActive ? "is-active" : "is-dormant")">
                                <span>@el.Symbol</span><span>@el.Name</span><span>@el.Value</span>
                            </span>
                        }
                    </div>
                    <dl class="kv-grid">
                        @if (!string.IsNullOrWhiteSpace(fig.InnerEl)) { <dt>Inner Element</dt><dd>@fig.InnerEl</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.OuterEl)) { <dt>Outer Element</dt><dd>@fig.OuterEl</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.ElementalPattern)) { <dt>Pattern</dt><dd>@fig.ElementalPattern</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.Anatomy)) { <dt>Anatomy</dt><dd>@fig.Anatomy</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.Colors)) { <dt>Colors</dt><dd>@fig.Colors</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.BodyType)) { <dt>Body (Modern)</dt><dd>@fig.BodyType</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.TraditionalBodyType)) { <dt>Body (Traditional)</dt><dd>@fig.TraditionalBodyType</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.CharacterType)) { <dt>Character (Modern)</dt><dd>@fig.CharacterType</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.TraditionalCharacterType)) { <dt>Character (Traditional)</dt><dd>@fig.TraditionalCharacterType</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.PlanetaryIntelligence)) { <dt>Planetary Intelligence</dt><dd>@fig.PlanetaryIntelligence</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.PlanetarySpirit)) { <dt>Planetary Spirit</dt><dd>@fig.PlanetarySpirit</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.PlanetaryAngel)) { <dt>Planetary Angel</dt><dd>@fig.PlanetaryAngel</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.StrongHouse)) { <dt>Strong House</dt><dd>@fig.StrongHouse</dd> }
                        @if (!string.IsNullOrWhiteSpace(fig.WeakHouse)) { <dt>Weak House</dt><dd>@fig.WeakHouse</dd> }
                    </dl>
                </div>
            </details>
        </section>

        @if (showReference)
        {
            <section id="section-reference" class="detail-card">
                <details open="@openReference">
                <summary class="details-summary">Slot Reference</summary>
                <div class="details-body">
                    @if (houseEntry != null)
                    {
                        <h4 class="subheading">House Reference · @houseEntry.House</h4>
                        @if (!string.IsNullOrWhiteSpace(houseEntry.TraditionalName)) { <p class="prose-text">@houseEntry.TraditionalName</p> }
                        @if (!string.IsNullOrWhiteSpace(houseEntry.InterpretiveEssence)) { <p class="prose-text">@houseEntry.InterpretiveEssence</p> }
                        @if (houseEntry.Governs?.Any() == true)
                        {
                            <ul class="bullet-list compact two-col-bullets">
                                @foreach (var g in houseEntry.Governs) { <li>@g</li> }
                            </ul>
                        }
                        @if (!string.IsNullOrWhiteSpace(houseEntry.SignificatorOfQuesitedWhen))
                        {
                            <p class="prose-text"><strong>Quesited when:</strong> @houseEntry.SignificatorOfQuesitedWhen</p>
                        }
                        @if (houseEntry.ExampleQuestions?.Any() == true)
                        {
                            <h4 class="subheading">Example Questions</h4>
                            <ul class="bullet-list compact">
                                @foreach (var q in houseEntry.ExampleQuestions) { <li>@q</li> }
                            </ul>
                        }
                    }
                    @if (courtEntry != null)
                    {
                        <h4 class="subheading">Court Reference · @courtEntry.Placement</h4>
                        @if (!string.IsNullOrWhiteSpace(courtEntry.TraditionalName)) { <p class="prose-text">@courtEntry.TraditionalName</p> }
                        @if (courtEntry.Meaning?.Any() == true)
                        {
                            <ul class="bullet-list compact">
                                @foreach (var m in courtEntry.Meaning) { <li>@m</li> }
                            </ul>
                        }
                        @if (!string.IsNullOrWhiteSpace(courtEntry.UtilityInReading))
                        {
                            <p class="prose-text"><strong>Utility:</strong> @courtEntry.UtilityInReading</p>
                        }
                    }
                </div>
                </details>
            </section>
        }

        @if (showSources)
        {
            <section id="section-sources" class="detail-card">
                <details>
                <summary class="details-summary">Sources</summary>
                <div class="details-body">
                    <ul class="sources-list">
                        @foreach (var s in fig.TraditionalSources!)
                        {
                            <li>
                                <span class="src-author">@s.Author</span>
                                <span class="src-work"> — @s.Work</span>
                                @if (!string.IsNullOrWhiteSpace(s.Section)) { <span class="src-sec"> (@s.Section)</span> }
                                @if (s.Year.HasValue) { <span class="src-year"> @s.Year</span> }
                                @if (!string.IsNullOrWhiteSpace(s.Note))
                                {
                                    <p class="src-note">@s.Note</p>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </details>
        </section>
        }
    }
</div>

@code {
    [Parameter] public SlotSelection? Selection { get; set; }
    [Parameter] public IReadOnlyList<HouseDirectoryEntry> Houses { get; set; } = Array.Empty<HouseDirectoryEntry>();
    [Parameter] public IReadOnlyList<CourtDirectoryEntry> Courts { get; set; } = Array.Empty<CourtDirectoryEntry>();

    private record ElementInfo(string Name, string Symbol, string Value, bool IsActive, string CssClass);

    private record InSlotInfo(string Eyebrow, string Title, string Body);

    private static bool HasInterpretationContent(FigureModel fig) =>
        !string.IsNullOrWhiteSpace(fig.Imagery)
        || fig.TraditionalImagery?.Any() == true
        || !string.IsNullOrWhiteSpace(fig.ElementalSynthesis)
        || fig.Interpretation?.Any() == true
        || !string.IsNullOrWhiteSpace(fig.Commentary)
        || fig.ModernExamples?.Any() == true;

    private static bool IsInterpretationOpenByDefault(InSlotInfo? inSlot) =>
        inSlot == null;

    private static bool IsReferenceOpenByDefault(
        HouseDirectoryEntry? houseEntry,
        CourtDirectoryEntry? courtEntry) =>
        houseEntry != null || courtEntry != null;

    private static bool IsCorrespondencesOpenByDefault(InSlotInfo? inSlot) =>
        inSlot == null;

    private InSlotInfo? ResolveInSlotText(FigureModel fig)
    {
        if (Selection == null) return null;

        // Court slots: look up "RightWitness" / "LeftWitness" / "Judge" / "Reconciler"
        // in the new InCourtRoles dictionary.
        var courtKey = Selection.Kind switch
        {
            SlotKind.RightWitness => "RightWitness",
            SlotKind.LeftWitness  => "LeftWitness",
            SlotKind.Judge        => "Judge",
            SlotKind.Sentence     => "Reconciler",
            _ => null
        };
        if (courtKey != null)
        {
            if (fig.InCourtRoles != null
                && fig.InCourtRoles.TryGetValue(courtKey, out var courtBody)
                && !string.IsNullOrWhiteSpace(courtBody))
            {
                var title = courtKey switch
                {
                    "RightWitness" => "As Right Witness",
                    "LeftWitness"  => "As Left Witness",
                    "Judge"        => "As Judge",
                    "Reconciler"   => "As Reconciler",
                    _              => "In this slot"
                };
                return new InSlotInfo("This figure in this court slot", title, courtBody);
            }
            return null;
        }

        // House slots: look up the house number as a string in InHouses.
        if (Selection.Kind == SlotKind.House && Selection.HouseNumber.HasValue)
        {
            var n = Selection.HouseNumber.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (fig.InHouses != null
                && fig.InHouses.TryGetValue(n, out var houseBody)
                && !string.IsNullOrWhiteSpace(houseBody))
            {
                return new InSlotInfo("This figure in this house slot", $"In House {n}", houseBody);
            }
        }

        return null;
    }

    private string FormatSlotLabel(SlotSelection s)
    {
        if (s.Kind == SlotKind.House && s.HouseNumber.HasValue)
        {
            var entry = Houses.FirstOrDefault(h => h.Id == s.HouseNumber.Value);
            // Already formatted by caller (e.g. "House 11 (Benefacta)"). Append the
            // ordinal directory name if we have it for extra context.
            return entry != null
                ? $"{s.SlotLabel} · {entry.House} House"
                : s.SlotLabel;
        }
        return s.SlotLabel;
    }

    private HouseDirectoryEntry? ResolveHouseEntry()
    {
        if (Selection?.Kind != SlotKind.House || Selection.HouseNumber == null) return null;
        return Houses.FirstOrDefault(h => h.Id == Selection.HouseNumber.Value);
    }

    private CourtDirectoryEntry? ResolveCourtEntry()
    {
        if (Selection == null) return null;
        var key = Selection.Kind switch
        {
            SlotKind.RightWitness => "Right Witness",
            SlotKind.LeftWitness => "Left Witness",
            SlotKind.Judge => "The Judge",
            SlotKind.Sentence => "The Reconciler",
            _ => null
        };
        if (key == null) return null;
        return Courts.FirstOrDefault(c =>
            string.Equals(c.Placement, key, StringComparison.OrdinalIgnoreCase));
    }

    private static IEnumerable<ElementInfo> BuildElements(FigureModel fig)
    {
        yield return MakeElement("Fire",  "🜂", fig.FireElement,  "fire");
        yield return MakeElement("Air",   "🜁", fig.AirElement,   "air");
        yield return MakeElement("Water", "🜄", fig.WaterElement, "water");
        yield return MakeElement("Earth", "🜃", fig.EarthElement, "earth");
    }

    private static ElementInfo MakeElement(string name, string symbol, string raw, string cssClass)
    {
        var trimmed = (raw ?? string.Empty).Trim();
        // Treat empty / "0" / "None" / "Inactive" / "Passive" as dormant; everything
        // else (including "Active", "1", "Yes", a count, etc.) lights up the badge.
        var dormant = string.IsNullOrEmpty(trimmed)
            || trimmed.Equals("0", StringComparison.OrdinalIgnoreCase)
            || trimmed.Equals("none", StringComparison.OrdinalIgnoreCase)
            || trimmed.Equals("inactive", StringComparison.OrdinalIgnoreCase)
            || trimmed.Equals("passive", StringComparison.OrdinalIgnoreCase)
            || trimmed.Equals("false", StringComparison.OrdinalIgnoreCase);
        return new ElementInfo(name, symbol, string.IsNullOrEmpty(trimmed) ? "—" : trimmed, !dormant, cssClass);
    }

    private static string GetPlanetSymbol(string planet) => planet?.Trim().ToLowerInvariant() switch
    {
        "sun"            => "☉",
        "moon"           => "☽",
        "mercury"        => "☿",
        "venus"          => "♀",
        "mars"           => "♂",
        "jupiter"        => "♃",
        "saturn"         => "♄",
        "uranus"         => "♅",
        "neptune"        => "♆",
        "pluto"          => "♇",
        "north node"     => "☊",
        "ascending node" => "☊",
        "south node"     => "☋",
        "descending node" => "☋",
        "dragon's head"   => "☊",
        "dragon's tail"   => "☋",
        _                 => "✦"
    };

    private static string GetZodiacSymbol(string sign) => sign?.Trim().ToLowerInvariant() switch
    {
        "aries"       => "♈",
        "taurus"      => "♉",
        "gemini"      => "♊",
        "cancer"      => "♋",
        "leo"         => "♌",
        "virgo"       => "♍",
        "libra"       => "♎",
        "scorpio"     => "♏",
        "sagittarius" => "♐",
        "capricorn"   => "♑",
        "aquarius"    => "♒",
        "pisces"      => "♓",
        _             => "✧"
    };

    private static string GetStrengthLabel(FigureInHouseStrength s) => s switch
    {
        FigureInHouseStrength.StrongInHouse => "Strong",
        FigureInHouseStrength.WeakInHouse   => "Weak",
        _                                   => "Neutral"
    };

    private static string GetStrengthCssClass(FigureInHouseStrength s) => s switch
    {
        FigureInHouseStrength.StrongInHouse => "strength-strong",
        FigureInHouseStrength.WeakInHouse   => "strength-weak",
        _                                   => "strength-neutral"
    };
}
