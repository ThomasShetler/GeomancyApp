@using System.Text.RegularExpressions
@using GeomancyApp
@using GeomancyWebUI.Client.Models
@using GeomancyWebUI.Client.Helpers

@*
    Relationship-reading detail panel for the Perfections tab.

    Spine (Perfection / Denial / Aspect):
      Header (mode + glossary) → Parties (Q | X) → Formation (path/cast + steps)
      → Participants (corpus chips) → Reading (interpretation) → Meta (score)
*@

<div class="perf-detail-panel @(Selection == null ? "is-empty" : "")">
    @if (Selection == null)
    {
        <div class="perf-detail-empty">
            <p>Select a perfection, denial, or aspect on the left to see its details.</p>
        </div>
    }
    else if (Selection.Kind == PerfectionEntryKind.Perfection || Selection.Kind == PerfectionEntryKind.Denial)
    {
        var p = Selection.Perfection;
        if (p == null)
        {
            <div class="perf-detail-empty">
                <p>Selected entry has no data.</p>
            </div>
        }
        else
        {
            var isDenial = Selection.Kind == PerfectionEntryKind.Denial;
            var totalScore = p.FavorableScore + p.UnfavorableScore;
            var headerEyebrow = isDenial ? "Denial" : "Perfection";
            var modeTitle = ResolveModeTitle(p);
            var companyDisplay = GetCompanyTypeDisplay(p);
            var companyEntry = LookupCompanyType(p.CompanyType);
            var companyPair = ResolveCompanyPairHouses(p);
            var glossary = GetModeGlossary(p);
            var noteParts = ParseNotes(p.Notes);
            var explanation = BuildRelationshipExplanation(p);
            var listPath = ResolveListPath(p);
            var castVis = explanation.HasStructuredCast
                ? AspectDirectionHelper.Resolve(explanation.Cast!.Direction, explanation.Cast.AspectType)
                : AspectDirectionHelper.Resolve(p.AspectDirection, p.AspectBetweenSignificators);
            var pathRelation = DescribeHouseRelation(
                listPath.HasPath ? listPath.FromHouse : 0,
                listPath.HasPath ? listPath.ToHouse : 0,
                p.Mode,
                p.BaseMode,
                p.AspectBetweenSignificators,
                p.AspectDirection);
            var pathRelationHint = listPath.HasPath
                ? GeomanticAspects.DescribeAspect(
                    listPath.FromHouse,
                    listPath.ToHouse,
                    p.AspectBetweenSignificators,
                    p.AspectDirection)
                : string.Empty;
            var aspectEmphasized = IsAspectRelationship(p);

            <header class="perf-detail-header">
                <div class="header-titles">
                    <p class="kind-eyebrow @(isDenial ? "is-denial" : "is-perfection")">@headerEyebrow</p>
                    <h2 class="kind-title kind-title-with-icon @(aspectEmphasized ? AspectDirectionHelper.AspectTypeClass(p.AspectBetweenSignificators) : "")">
                        <PerfectionIcon Mode="@p.Mode"
                                        AspectType="@p.AspectBetweenSignificators"
                                        CompanyType="@p.CompanyType"
                                        Large="true" />
                        <span>@modeTitle</span>
                    </h2>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(glossary))
            {
                <p class="glossary-tagline">@glossary</p>
            }

            @if (!string.IsNullOrEmpty(companyDisplay) || companyPair.Item1 > 0)
            {
                @RenderCompanyCover(
                    companyDisplay,
                    companyEntry,
                    companyPair.Item1,
                    companyPair.Item2,
                    GetHouseFigureName(companyPair.Item1),
                    GetHouseFigureName(companyPair.Item2),
                    p.CompanyType,
                    p.CompanyTypeDescription,
                    p.QuerentHouse,
                    p.QuesitedHouse,
                    CompanyTypesDirectory?.Overview)
            }

            <section class="detail-card parties-card">
                <h3 class="card-title">Parties</h3>
                <div class="parties-grid">
                    <div class="sig-cell">
                        <span class="sig-eyebrow">Querent</span>
                        <span class="sig-house">House @p.QuerentHouse</span>
                        <span class="sig-house-sub">@FigureDisplayHelper.GetHouseName(p.QuerentHouse)</span>
                        <span class="sig-figure">@(string.IsNullOrEmpty(p.QuerentFigure) ? "—" : p.QuerentFigure)</span>
                        @{
                            var qSubtitle = FormatHouseSubtitle(p.QuerentHouse);
                        }
                        @if (!string.IsNullOrEmpty(qSubtitle))
                        {
                            <span class="house-relation-subtitle">@qSubtitle</span>
                        }
                    </div>
                    <div class="sig-cell">
                        <span class="sig-eyebrow">Quesited</span>
                        <span class="sig-house">House @p.QuesitedHouse</span>
                        <span class="sig-house-sub">@FigureDisplayHelper.GetHouseName(p.QuesitedHouse)</span>
                        <span class="sig-figure">@(string.IsNullOrEmpty(p.QuesitedFigure) ? "—" : p.QuesitedFigure)</span>
                        @{
                            var xSubtitle = FormatHouseSubtitle(p.QuesitedHouse);
                        }
                        @if (!string.IsNullOrEmpty(xSubtitle))
                        {
                            <span class="house-relation-subtitle">@xSubtitle</span>
                        }
                    </div>
                </div>
            </section>

            @if (explanation.HasFormation)
            {
                <section class="detail-card formation-card @(explanation.HasStructuredCast ? AspectDirectionHelper.AspectTypeClass(explanation.Cast!.AspectType) : "")">
                    <h3 class="card-title">
                        <span class="card-title-icon">⚙</span> @explanation.Title
                    </h3>

                    @if (listPath.HasPath)
                    {
                        <div class="formation-path-block">
                            <div class="formation-path-flow">
                                @if (!string.IsNullOrEmpty(listPath.ActorPrefix))
                                {
                                    <span class="flow-actor">@listPath.ActorPrefix</span>
                                }
                                <span class="flow-house-num">H@(listPath.FromHouse)</span>
                                <span class="flow-arrow @castVis.CssClass" title="@castVis.Hint">@(string.IsNullOrEmpty(castVis.Glyph) ? "→" : castVis.Glyph)</span>
                                <span class="flow-house-num">H@(listPath.ToHouse)</span>
                                @if (!string.IsNullOrEmpty(listPath.FromFigure) || !string.IsNullOrEmpty(listPath.ToFigure))
                                {
                                    <span class="flow-figures">
                                        @if (!string.IsNullOrEmpty(listPath.FromFigure) && !string.IsNullOrEmpty(listPath.ToFigure))
                                        {
                                            <span>@listPath.FromFigure</span>
                                            <span class="flow-fig-sep">·</span>
                                            <span>@listPath.ToFigure</span>
                                        }
                                        else
                                        {
                                            <span>@(string.IsNullOrEmpty(listPath.FromFigure) ? listPath.ToFigure : listPath.FromFigure)</span>
                                        }
                                    </span>
                                }
                            </div>

                            <div class="house-relation-grid">
                                @RenderHouseRelationCell(listPath.FromHouse, "From")
                                <div class="house-relation-mid">
                                    <span class="house-relation-arrow">↔</span>
                                    @if (!string.IsNullOrEmpty(pathRelation))
                                    {
                                        <span class="house-relation-label" title="@pathRelationHint">@pathRelation</span>
                                    }
                                </div>
                                @RenderHouseRelationCell(listPath.ToHouse, "To")
                            </div>
                        </div>
                    }

                    @if (explanation.HasStructuredCast)
                    {
                        <div class="significators-grid cast-grid">
                            <div class="sig-cell">
                                <span class="sig-eyebrow">Cast from</span>
                                <span class="sig-house">House @explanation.Cast!.FromHouse</span>
                                <span class="sig-house-sub">@FigureDisplayHelper.GetHouseName(explanation.Cast.FromHouse)</span>
                                @if (!string.IsNullOrEmpty(explanation.Cast.FromFigure))
                                {
                                    <span class="sig-figure">@explanation.Cast.FromFigure</span>
                                }
                            </div>
                            <div class="sig-arrow @castVis.CssClass" title="@castVis.Hint">
                                @castVis.Glyph
                            </div>
                            <div class="sig-cell">
                                <span class="sig-eyebrow">Cast to</span>
                                <span class="sig-house">House @explanation.Cast.ToHouse</span>
                                <span class="sig-house-sub">@FigureDisplayHelper.GetHouseName(explanation.Cast.ToHouse)</span>
                                @if (!string.IsNullOrEmpty(explanation.Cast.ToFigure))
                                {
                                    <span class="sig-figure">@explanation.Cast.ToFigure</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(explanation.DirectionHint))
                        {
                            <p class="cast-direction-hint">@explanation.DirectionHint</p>
                        }
                    }

                    @if (explanation.Steps.Count > 0)
                    {
                        <ol class="mechanism-list mechanism-steps">
                            @for (var si = 0; si < explanation.Steps.Count; si++)
                            {
                                <li class="mechanism-item">
                                    <span class="mechanism-step-num">@(si + 1)</span>
                                    <span class="mechanism-text">@HighlightTokens(explanation.Steps[si])</span>
                                </li>
                            }
                        </ol>
                    }
                </section>
            }

            @if (explanation.Participants.Count > 0)
            {
                <section class="detail-card participants-card">
                    <h3 class="card-title">Participants</h3>
                    <ul class="participant-list">
                        @foreach (var part in explanation.Participants)
                        {
                            var fig = ResolveFigure(part.House, part.FigureName);
                            var blurb = fig != null && part.House > 0
                                ? FigureDisplayHelper.GetFigureInHouseText(fig, part.House)
                                : fig?.Tagline;
                            var houseContext = part.House > 0 ? FormatHouseContext(part.House) : null;
                            <li class="participant-item">
                                <div class="participant-header">
                                    <span class="participant-role">@part.Role</span>
                                    @if (part.House > 0)
                                    {
                                        <span class="participant-house">House @(part.House)</span>
                                        <span class="participant-house-name">@FigureDisplayHelper.GetHouseName(part.House)</span>
                                    }
                                    <span class="participant-name">@(string.IsNullOrEmpty(part.FigureName) ? "—" : part.FigureName)</span>
                                </div>
                                @if (!string.IsNullOrEmpty(houseContext))
                                {
                                    <p class="participant-house-context">@houseContext</p>
                                }
                                @if (fig != null)
                                {
                                    <div class="participant-chips">
                                        @if (!string.IsNullOrWhiteSpace(fig.Planet))
                                        {
                                            <span class="chip chip-planet">
                                                <span class="chip-glyph">@FigureDisplayHelper.GetPlanetSymbol(fig.Planet)</span>
                                                @fig.Planet
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(fig.OuterEl))
                                        {
                                            <span class="chip chip-element @FigureDisplayHelper.GetElementCssClass(fig.OuterEl)">
                                                <span class="chip-glyph">@FigureDisplayHelper.GetElementSymbol(fig.OuterEl)</span>
                                                @fig.OuterEl
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(blurb))
                                    {
                                        <p class="participant-blurb">@blurb</p>
                                    }
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (noteParts.InterpretationTips.Count > 0)
            {
                <section class="detail-card interpretation-card">
                    <h3 class="card-title">
                        <span class="card-title-icon">✦</span> Reading
                    </h3>
                    <div class="interpretation-tips">
                        @for (int i = 0; i < noteParts.InterpretationTips.Count; i++)
                        {
                            var tip = noteParts.InterpretationTips[i];
                            <div class="interpretation-tip @(i == 0 ? "tip-lead" : "tip-context")">
                                <span class="tip-bullet">✦</span>
                                <p class="tip-text">@RenderTipText(tip)</p>
                            </div>
                        }
                    </div>
                </section>
            }

            <section class="detail-card meta-card">
                <h3 class="card-title">Score</h3>
                <div class="score-breakdown">
                    <div class="score-cell">
                        <span class="score-cell-label">Favorable</span>
                        <span class="score-cell-value score-positive-text">+@p.FavorableScore</span>
                    </div>
                    <div class="score-cell">
                        <span class="score-cell-label">Unfavorable</span>
                        <span class="score-cell-value score-negative-text">@p.UnfavorableScore</span>
                    </div>
                    <div class="score-cell score-cell-net">
                        <span class="score-cell-label">Net</span>
                        <span class="score-cell-value @ScoreTextClass(totalScore)">@FormatScore(totalScore)</span>
                    </div>
                </div>
                @if (p.Indentation != null)
                {
                    <details class="meta-details">
                        <summary>Indentation</summary>
                        <div class="indent-grid">
                            <div class="indent-cell">
                                <span class="indent-label">Querent</span>
                                <span class="indent-value">@p.Indentation.QuerentHouse</span>
                            </div>
                            <div class="indent-cell">
                                <span class="indent-label">Quesited</span>
                                <span class="indent-value">@p.Indentation.QuesitedHouse</span>
                            </div>
                            <div class="indent-cell">
                                <span class="indent-label">Index</span>
                                <span class="indent-value">@p.Indentation.Index</span>
                            </div>
                            <div class="indent-cell">
                                <span class="indent-label">Bonus</span>
                                <span class="indent-value">@p.Indentation.Bonus</span>
                            </div>
                            <div class="indent-cell indent-total">
                                <span class="indent-label">Total</span>
                                <span class="indent-value">@p.Indentation.Total</span>
                            </div>
                        </div>
                    </details>
                }
            </section>
        }
    }
    else
    {
        var a = Selection.Aspect;
        if (a == null)
        {
            <div class="perf-detail-empty">
                <p>Selected entry has no data.</p>
            </div>
        }
        else
        {
            var isPositive = Selection.Kind == PerfectionEntryKind.PositiveAspect;
            var headerEyebrow = isPositive ? "Positive Aspect" : "Negative Aspect";
            var totalScore = isPositive ? a.FavorableScore : a.UnfavorableScore;
            var aspectGlossary = GetAspectGlossary(a.AspectType, a.Direction);
            var companyEntry = a.MadeThroughCompany ? LookupCompanyType(a.CompanyType) : null;
            var companyDisplay = a.MadeThroughCompany
                ? (string.IsNullOrEmpty(PerfectionDetailCopy.FormatCompanyType(a.CompanyType))
                    ? "Via Company"
                    : PerfectionDetailCopy.FormatCompanyType(a.CompanyType))
                : string.Empty;
            var companyPair = a.MadeThroughCompany
                ? ResolveCompanyPairHousesForAspect(a, Analysis?.QuerentHouse ?? 0, Analysis?.QuesitedHouse ?? 0)
                : (0, 0);
            var aDirectionVis = AspectDirectionHelper.Resolve(a.Direction, a.AspectType);
            var aspectTypeClass = AspectDirectionHelper.AspectTypeClass(a.AspectType);
            var aNoteParts = ParseDescription(a.Description);
            var explanation = BuildAspectRelationshipExplanation(a);
            var querentHouse = Analysis?.QuerentHouse ?? 0;
            var quesitedHouse = Analysis?.QuesitedHouse ?? 0;
            var querentFigureName = GetHouseFigureName(querentHouse);
            var quesitedFigureName = GetHouseFigureName(quesitedHouse);
            var listPath = new PerfectionPathDisplay.ListRowPath
            {
                FromHouse = a.FromHouse,
                ToHouse = a.ToHouse,
                FromFigure = GetHouseFigureName(a.FromHouse),
                ToFigure = string.Empty,
                ActorPrefix = string.Empty
            };
            var pathRelation = DescribeHouseRelation(
                a.FromHouse,
                a.ToHouse,
                "Aspect",
                string.Empty,
                a.AspectType,
                a.Direction);
            var pathRelationHint = GeomanticAspects.DescribeAspect(
                a.FromHouse, a.ToHouse, a.AspectType, a.Direction);

            <header class="perf-detail-header">
                <div class="header-titles">
                    <p class="kind-eyebrow @(isPositive ? "is-positive" : "is-negative")">
                        @(a.MadeThroughCompany ? $"{headerEyebrow} · via company" : headerEyebrow)
                    </p>
                    <h2 class="kind-title kind-title-with-icon @aspectTypeClass">
                        <PerfectionIcon AspectType="@a.AspectType" Large="true" />
                        <span>@a.AspectType</span>
                    </h2>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(aspectGlossary))
            {
                <p class="glossary-tagline">@aspectGlossary</p>
            }

            @if (a.MadeThroughCompany)
            {
                @RenderCompanyCover(
                    companyDisplay,
                    companyEntry,
                    companyPair.Item1,
                    companyPair.Item2,
                    GetHouseFigureName(companyPair.Item1),
                    GetHouseFigureName(companyPair.Item2),
                    a.CompanyType,
                    string.Empty,
                    Analysis?.QuerentHouse ?? 0,
                    Analysis?.QuesitedHouse ?? 0,
                    CompanyTypesDirectory?.Overview)
            }

            @if (querentHouse > 0 || quesitedHouse > 0)
            {
                <section class="detail-card parties-card">
                    <h3 class="card-title">Parties</h3>
                    <div class="parties-grid">
                        <div class="sig-cell">
                            <span class="sig-eyebrow">Querent</span>
                            <span class="sig-house">House @querentHouse</span>
                            <span class="sig-figure">@(string.IsNullOrEmpty(querentFigureName) ? "—" : querentFigureName)</span>
                        </div>
                        <div class="sig-cell">
                            <span class="sig-eyebrow">Quesited</span>
                            <span class="sig-house">House @quesitedHouse</span>
                            <span class="sig-figure">@(string.IsNullOrEmpty(quesitedFigureName) ? "—" : quesitedFigureName)</span>
                        </div>
                    </div>
                </section>
            }

            @if (explanation.HasFormation)
            {
                <section class="detail-card formation-card @aspectTypeClass">
                    <h3 class="card-title">
                        <span class="card-title-icon">⚙</span> @explanation.Title
                    </h3>

                    @if (listPath.HasPath)
                    {
                        <div class="formation-path-block">
                            <div class="formation-path-flow">
                                <span class="flow-house-num">H@(listPath.FromHouse)</span>
                                <span class="flow-arrow @aDirectionVis.CssClass" title="@aDirectionVis.Hint">@(string.IsNullOrEmpty(aDirectionVis.Glyph) ? "→" : aDirectionVis.Glyph)</span>
                                <span class="flow-house-num">H@(listPath.ToHouse)</span>
                                @if (!string.IsNullOrEmpty(listPath.FromFigure))
                                {
                                    <span class="flow-figures"><span>@listPath.FromFigure</span></span>
                                }
                            </div>

                            <div class="house-relation-grid">
                                @RenderHouseRelationCell(listPath.FromHouse, "From")
                                <div class="house-relation-mid">
                                    <span class="house-relation-arrow">↔</span>
                                    @if (!string.IsNullOrEmpty(pathRelation))
                                    {
                                        <span class="house-relation-label" title="@pathRelationHint">@pathRelation</span>
                                    }
                                </div>
                                @RenderHouseRelationCell(listPath.ToHouse, "To")
                            </div>
                        </div>
                    }

                    @if (explanation.HasStructuredCast)
                    {
                        <div class="significators-grid cast-grid">
                            <div class="sig-cell">
                                <span class="sig-eyebrow">Cast from</span>
                                <span class="sig-house">House @explanation.Cast!.FromHouse</span>
                                <span class="sig-house-sub">@FigureDisplayHelper.GetHouseName(explanation.Cast.FromHouse)</span>
                                @if (!string.IsNullOrEmpty(explanation.Cast.FromFigure))
                                {
                                    <span class="sig-figure">@explanation.Cast.FromFigure</span>
                                }
                            </div>
                            <div class="sig-arrow @aDirectionVis.CssClass" title="@aDirectionVis.Hint">
                                @aDirectionVis.Glyph
                            </div>
                            <div class="sig-cell">
                                <span class="sig-eyebrow">Cast to</span>
                                <span class="sig-house">House @explanation.Cast.ToHouse</span>
                                <span class="sig-house-sub">@FigureDisplayHelper.GetHouseName(explanation.Cast.ToHouse)</span>
                                @if (!string.IsNullOrEmpty(explanation.Cast.ToFigure))
                                {
                                    <span class="sig-figure">@explanation.Cast.ToFigure</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(explanation.DirectionHint))
                        {
                            <p class="cast-direction-hint">@explanation.DirectionHint</p>
                        }
                    }

                    @if (explanation.Steps.Count > 0)
                    {
                        <ol class="mechanism-list mechanism-steps">
                            @for (var si = 0; si < explanation.Steps.Count; si++)
                            {
                                <li class="mechanism-item">
                                    <span class="mechanism-step-num">@(si + 1)</span>
                                    <span class="mechanism-text">@HighlightTokens(explanation.Steps[si])</span>
                                </li>
                            }
                        </ol>
                    }
                </section>
            }

            @if (explanation.Participants.Count > 0)
            {
                <section class="detail-card participants-card">
                    <h3 class="card-title">Participants</h3>
                    <ul class="participant-list">
                        @foreach (var part in explanation.Participants)
                        {
                            var fig = ResolveFigure(part.House, part.FigureName);
                            var blurb = fig != null && part.House > 0
                                ? FigureDisplayHelper.GetFigureInHouseText(fig, part.House)
                                : fig?.Tagline;
                            var houseContext = part.House > 0 ? FormatHouseContext(part.House) : null;
                            <li class="participant-item">
                                <div class="participant-header">
                                    <span class="participant-role">@part.Role</span>
                                    @if (part.House > 0)
                                    {
                                        <span class="participant-house">House @(part.House)</span>
                                        <span class="participant-house-name">@FigureDisplayHelper.GetHouseName(part.House)</span>
                                    }
                                    <span class="participant-name">@(string.IsNullOrEmpty(part.FigureName) ? "—" : part.FigureName)</span>
                                </div>
                                @if (!string.IsNullOrEmpty(houseContext))
                                {
                                    <p class="participant-house-context">@houseContext</p>
                                }
                                @if (fig != null)
                                {
                                    <div class="participant-chips">
                                        @if (!string.IsNullOrWhiteSpace(fig.Planet))
                                        {
                                            <span class="chip chip-planet">
                                                <span class="chip-glyph">@FigureDisplayHelper.GetPlanetSymbol(fig.Planet)</span>
                                                @fig.Planet
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(fig.OuterEl))
                                        {
                                            <span class="chip chip-element @FigureDisplayHelper.GetElementCssClass(fig.OuterEl)">
                                                <span class="chip-glyph">@FigureDisplayHelper.GetElementSymbol(fig.OuterEl)</span>
                                                @fig.OuterEl
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(blurb))
                                    {
                                        <p class="participant-blurb">@blurb</p>
                                    }
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (aNoteParts.InterpretationTips.Count > 0)
            {
                <section class="detail-card interpretation-card">
                    <h3 class="card-title">
                        <span class="card-title-icon">✦</span> Reading
                    </h3>
                    <div class="interpretation-tips">
                        @for (int i = 0; i < aNoteParts.InterpretationTips.Count; i++)
                        {
                            var tip = aNoteParts.InterpretationTips[i];
                            <div class="interpretation-tip @(i == 0 ? "tip-lead" : "tip-context")">
                                <span class="tip-bullet">✦</span>
                                <p class="tip-text">@RenderTipText(tip)</p>
                            </div>
                        }
                    </div>
                </section>
            }

            <section class="detail-card meta-card">
                <h3 class="card-title">Score</h3>
                <div class="score-breakdown score-breakdown-two">
                    <div class="score-cell">
                        <span class="score-cell-label">Favorable</span>
                        <span class="score-cell-value score-positive-text">+@a.FavorableScore</span>
                    </div>
                    <div class="score-cell">
                        <span class="score-cell-label">Unfavorable</span>
                        <span class="score-cell-value score-negative-text">@a.UnfavorableScore</span>
                    </div>
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter] public PerfectionSelection? Selection { get; set; }
    [Parameter] public PerfectionAnalysisModel? Analysis { get; set; }
    [Parameter] public HouseChartModel? Chart { get; set; }
    [Parameter] public IReadOnlyList<HouseDirectoryEntry> HousesDirectory { get; set; } = Array.Empty<HouseDirectoryEntry>();
    [Parameter] public CompanyTypeDirectory? CompanyTypesDirectory { get; set; }

    private CompanyTypeEntry? LookupCompanyType(string? companyType)
    {
        if (string.IsNullOrWhiteSpace(companyType)
            || string.Equals(companyType, "None", StringComparison.OrdinalIgnoreCase)
            || CompanyTypesDirectory?.CompanyTypes == null
            || CompanyTypesDirectory.CompanyTypes.Count == 0)
        {
            return null;
        }

        static string Normalize(string id) =>
            id.Trim().Replace("-", string.Empty).Replace(" ", string.Empty);

        var needle = Normalize(companyType);
        return CompanyTypesDirectory.CompanyTypes.FirstOrDefault(e =>
            string.Equals(Normalize(e.Id), needle, StringComparison.OrdinalIgnoreCase)
            || string.Equals(e.ShortLabel, companyType.Trim(), StringComparison.OrdinalIgnoreCase)
            || string.Equals(e.Name, companyType.Trim(), StringComparison.OrdinalIgnoreCase));
    }

