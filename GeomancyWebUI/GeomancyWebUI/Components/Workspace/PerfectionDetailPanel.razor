    private static string DescribeHouseRelation(
        int fromHouse,
        int toHouse,
        string mode,
        string baseMode,
        string aspectType,
        string aspectDirection)
    {
        if (fromHouse <= 0 || toHouse <= 0) return string.Empty;

        var effective = string.Equals(mode, "Company", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(baseMode)
            ? baseMode
            : mode;

        if (string.Equals(effective, "Aspect", StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(aspectType)
                && !aspectType.Equals("None", StringComparison.OrdinalIgnoreCase)))
        {
            var dir = (aspectDirection ?? string.Empty).Trim();
            var type = (aspectType ?? string.Empty).Trim();
            if (string.IsNullOrEmpty(type) || type.Equals("None", StringComparison.OrdinalIgnoreCase))
            {
                var (a, d) = GeomanticAspects.GetAspectWithDirection(fromHouse, toHouse);
                if (a != AspectType.None)
                {
                    type = a.ToString();
                    dir = d;
                }
            }

            if (!string.IsNullOrEmpty(type) && !type.Equals("None", StringComparison.OrdinalIgnoreCase))
            {
                var described = GeomanticAspects.DescribeAspect(fromHouse, toHouse, type, dir);
                if (!string.IsNullOrEmpty(described))
                    return GeomanticAspects.ShortLabel(type, dir);
                var shortLabel = GeomanticAspects.ShortLabel(type, dir);
                if (!string.IsNullOrEmpty(shortLabel))
                    return shortLabel;
                return type;
            }
        }

        if (string.Equals(effective, "Conjunction", StringComparison.OrdinalIgnoreCase)
            || string.Equals(effective, "Translation", StringComparison.OrdinalIgnoreCase)
            || string.Equals(effective, "Mutation", StringComparison.OrdinalIgnoreCase)
            || AreAdjacentHouses(fromHouse, toHouse))
        {
            return AreAdjacentHouses(fromHouse, toHouse)
                ? "Adjacent houses"
                : "Pass relationship";
        }

        if (string.Equals(effective, "Occupation", StringComparison.OrdinalIgnoreCase))
            return "Shared occupation";

        var (aspect, direction) = GeomanticAspects.GetAspectWithDirection(fromHouse, toHouse);
        if (aspect != AspectType.None)
        {
            var shortLabel = GeomanticAspects.ShortLabel(aspect, direction);
            return string.IsNullOrEmpty(shortLabel) ? aspect.ToString() : shortLabel;
        }

        return "House link";
    }

    private (int sig, int companion) ResolveCompanyPairHouses(PerfectionModel p)
    {
        var hasCompany = p.MadeThroughCompany
            || string.Equals(p.Mode, "Company", StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(p.CompanyType)
                && !p.CompanyType.Equals("None", StringComparison.OrdinalIgnoreCase));
        if (!hasCompany)
            return (0, 0);

        var hint = p.AspectFromHouse > 0 ? p.AspectFromHouse
            : (p.PathFromHouse > 0 ? p.PathFromHouse : p.PathToHouse);
        return ResolveCompanyPairFromHint(p.QuerentHouse, p.QuesitedHouse, hint, p.PathActor);
    }

    private static (int sig, int companion) ResolveCompanyPairHousesForAspect(
        AspectRecordModel a, int querentHouse, int quesitedHouse)
    {
        if (!a.MadeThroughCompany) return (0, 0);
        return ResolveCompanyPairFromHint(querentHouse, quesitedHouse, a.FromHouse, string.Empty);
    }

    private static (int sig, int companion) ResolveCompanyPairFromHint(
        int querentHouse, int quesitedHouse, int companionHint, string? pathActor)
    {
        static int Pair(int h) => h < 1 || h > 12 ? 0 : (h % 2 == 1 ? h + 1 : h - 1);

        if (companionHint == Pair(querentHouse) && querentHouse > 0)
            return (querentHouse, companionHint);
        if (companionHint == Pair(quesitedHouse) && quesitedHouse > 0)
            return (quesitedHouse, companionHint);
        if (querentHouse > 0 && (companionHint == querentHouse
            || string.Equals(pathActor, "Q.", StringComparison.OrdinalIgnoreCase)))
            return (querentHouse, Pair(querentHouse));
        if (quesitedHouse > 0 && (companionHint == quesitedHouse
            || (pathActor ?? string.Empty).StartsWith("Qst", StringComparison.OrdinalIgnoreCase)))
            return (quesitedHouse, Pair(quesitedHouse));
        if (querentHouse > 0)
            return (querentHouse, Pair(querentHouse));
        return (0, 0);
    }

    private static bool AreAdjacentHouses(int a, int b)
    {
        if (a < 1 || a > 12 || b < 1 || b > 12) return false;
        var diff = Math.Abs(a - b);
        return diff == 1 || diff == 11;
    }

    private string GetHouseFigureName(int houseNumber)
    {
        if (Chart?.Houses == null || houseNumber <= 0) return string.Empty;
        var house = Chart.Houses.FirstOrDefault(h => h.HouseNumber == houseNumber);
        return house?.Figure?.Name ?? string.Empty;
    }

    private FigureModel? ResolveFigure(int houseNumber, string figureName)
    {
        if (Chart?.Houses != null && houseNumber > 0)
        {
            var house = Chart.Houses.FirstOrDefault(h => h.HouseNumber == houseNumber);
            if (house?.Figure != null)
                return house.Figure;
        }

        if (Chart?.Houses == null || string.IsNullOrWhiteSpace(figureName))
            return null;

        return Chart.Houses
            .Select(h => h.Figure)
            .FirstOrDefault(f => f != null
                && string.Equals(f.Name, figureName, StringComparison.OrdinalIgnoreCase));
    }

    private PerfectionMechanismHelper.MechanismExplanation BuildRelationshipExplanation(PerfectionModel p)
    {
        var aspectFromFigure = GetHouseFigureName(p.AspectFromHouse);
        var aspectToFigure = GetHouseFigureName(p.AspectToHouse);
        if (string.IsNullOrEmpty(aspectFromFigure) && !string.IsNullOrEmpty(p.PathFigure))
            aspectFromFigure = p.PathFigure;
        if (string.IsNullOrEmpty(aspectToFigure) && p.AspectToHouse == p.QuesitedHouse)
            aspectToFigure = p.QuesitedFigure;
        if (string.IsNullOrEmpty(aspectToFigure) && p.AspectToHouse == p.QuerentHouse)
            aspectToFigure = p.QuerentFigure;

        return PerfectionMechanismHelper.ExplainRelationship(
            p.Mode,
            p.BaseMode,
            p.QuerentHouse,
            p.QuesitedHouse,
            p.QuerentFigure,
            p.QuesitedFigure,
            p.PathFromHouse,
            p.PathToHouse,
            p.PathFigure,
            p.PathSecondaryFigure,
            p.PathActor,
            p.TranslatorHouse,
            p.TranslatorHouseSecondary,
            string.IsNullOrEmpty(p.TranslatorFigure) ? p.PathFigure : p.TranslatorFigure,
            p.AspectFromHouse,
            p.AspectToHouse,
            aspectFromFigure,
            aspectToFigure,
            p.AspectBetweenSignificators,
            p.AspectDirection,
            p.MadeThroughCompany,
            p.CompanyType,
            p.CompanyTypeDescription);
    }

    private PerfectionMechanismHelper.MechanismExplanation BuildAspectRelationshipExplanation(AspectRecordModel a)
    {
        var querent = Analysis?.QuerentHouse ?? 0;
        var quesited = Analysis?.QuesitedHouse ?? 0;
        var fromFig = GetHouseFigureName(a.FromHouse);
        var toFig = GetHouseFigureName(a.ToHouse);

        return PerfectionMechanismHelper.ExplainRelationship(
            mode: "Aspect",
            baseMode: string.Empty,
            querentHouse: querent,
            quesitedHouse: quesited,
            querentFigure: GetHouseFigureName(querent),
            quesitedFigure: GetHouseFigureName(quesited),
            pathFromHouse: a.FromHouse,
            pathToHouse: a.ToHouse,
            pathFigure: fromFig,
            pathSecondaryFigure: string.Empty,
            pathActor: string.Empty,
            translatorHouse: 0,
            translatorHouseSecondary: 0,
            translatorFigure: string.Empty,
            aspectFromHouse: a.FromHouse,
            aspectToHouse: a.ToHouse,
            aspectFromFigure: fromFig,
            aspectToFigure: toFig,
            aspectType: a.AspectType,
            aspectDirection: a.Direction,
            madeThroughCompany: a.MadeThroughCompany,
            companyType: a.CompanyType ?? string.Empty,
            companyTypeDescription: string.Empty);
    }

