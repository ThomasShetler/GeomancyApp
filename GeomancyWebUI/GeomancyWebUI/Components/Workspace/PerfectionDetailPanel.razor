    private HouseDirectoryEntry? FindHouseEntry(int houseNumber)
    {
        if (houseNumber <= 0 || HousesDirectory == null || HousesDirectory.Count == 0)
            return null;
        return HousesDirectory.FirstOrDefault(h => h.Id == houseNumber);
    }

    private string FormatHouseContext(int houseNumber)
    {
        if (houseNumber <= 0) return string.Empty;
        var ordinal = FigureDisplayHelper.GetHouseName(houseNumber);
        var subtitle = FormatHouseSubtitle(houseNumber);
        return string.IsNullOrEmpty(subtitle) ? $"{ordinal} house" : $"{ordinal} · {subtitle}";
    }

    private string FormatHouseSubtitle(int houseNumber)
    {
        var entry = FindHouseEntry(houseNumber);
        if (entry == null) return string.Empty;

        if (!string.IsNullOrWhiteSpace(entry.TraditionalName))
            return entry.TraditionalName.Trim();

        var govern = entry.Governs?.FirstOrDefault(g => !string.IsNullOrWhiteSpace(g));
        if (!string.IsNullOrWhiteSpace(govern))
            return govern!.Trim();

        if (!string.IsNullOrWhiteSpace(entry.InterpretiveEssence))
        {
            var essence = entry.InterpretiveEssence.Trim();
            return essence.Length > 90 ? essence[..87] + "..." : essence;
        }

        return string.Empty;
    }

