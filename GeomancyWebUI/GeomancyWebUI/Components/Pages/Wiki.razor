@page "/wiki"
@rendermode InteractiveServer

<PageTitle>Geofancy - Wiki</PageTitle>

<WikiArticleShell Title="Geomancy Wiki"
                  Lead="Reference library for casting, reading, and using Geofancy. Live glossaries draw from the same corpus as the workspace detail panels.">

    <section class="wiki-section" style="margin-top: 0; padding-top: 0; border-top: none;">
        <h2 class="wiki-section-title">Getting Started</h2>
        <div class="wiki-topic-grid">
            <WikiTopicCard Href="/wiki/how-to/generate-figures"
                           Title="How to Generate the Figures"
                           Description="Marking dots, forming the four Mothers, and naming the sixteen figures."
                           IsLive="true" />
            <WikiTopicCard Href="/wiki/how-to/shield-chart"
                           Title="How to Cast a Shield Chart"
                           Description="From Mothers through Daughters, Nieces, Witnesses, Judge, and Reconciler."
                           IsLive="true" />
            <WikiTopicCard Href="/wiki/how-to/house-chart"
                           Title="How to Cast a House Chart"
                           Description="Projecting the shield into twelve houses — traditional and dawn-style layouts."
                           IsLive="false" />
            <WikiTopicCard Href="/wiki/how-to/use-the-app"
                           Title="How to Use the App"
                           Description="Workspace tabs, mobile layout, sharing charts, and reading the detail panels."
                           IsLive="false" />
        </div>
    </section>

    <section class="wiki-section">
        <h2 class="wiki-section-title">Glossaries</h2>
        <div class="wiki-topic-grid">
            <WikiTopicCard Href="/wiki/glossary/figures"
                           Title="Figure Glossary"
                           Description="All sixteen geomantic figures with divinatory meaning, verdicts, elements, and sources."
                           IsLive="true" />
            <WikiTopicCard Href="/wiki/glossary/houses"
                           Title="House Glossary"
                           Description="Twelve astrological houses — what each governs, reading craft, and example questions."
                           IsLive="true" />
        </div>
    </section>

    <section class="wiki-section">
        <h2 class="wiki-section-title">Interpretation Methods</h2>
        <div class="wiki-topic-grid">
            <WikiTopicCard Href="/wiki/methods/perfections-and-aspects"
                           Title="Perfections &amp; Aspects"
                           Description="Classical modes, company, denials, aspect scoring, and significator perfection."
                           IsLive="false" />
            <WikiTopicCard Href="/wiki/methods/way-of-points"
                           Title="Way of Points"
                           Description="Elemental paths, path types, and the Way of the Light / Classic Way of Points."
                           IsLive="false" />
        </div>
    </section>

</WikiArticleShell>
