@page "/wiki/glossary/figures/{Slug}"
@rendermode InteractiveServer
@using GeomancyWebUI.Client.Helpers
@using GeomancyWebUI.Client.Models
@using GeomancyWebUI.Client.Services
@using GeomancyWebUI.Services
@inject IGeomancyService GeomancyService

<PageSeo Title="@FigureSeoTitle"
          Description="@FigureSeoDescription"
          CanonicalPath="@FigureCanonicalPath"
          Keywords="@FigureSeoKeywords"
          OgType="article" />

<WikiArticleShell Title="@(_figure?.Name ?? "Figure not found")"
                  Lead="@(_figure?.Tagline)"
                  ParentHref="/wiki/glossary/figures"
                  ParentLabel="Figures">

    @if (_loading)
    {
        <p class="wiki-loading">Loading…</p>
    }
    else if (_figure == null)
    {
        <div class="wiki-not-found">
            <p>No figure matches this link.</p>
            <p><a href="/wiki/glossary/figures">Browse all figures</a></p>
        </div>
    }
    else
    {
        <WikiFigureHeader Figure="@_figure" />
        <WikiFigureCorpusSections Figure="@_figure" />
    }

</WikiArticleShell>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private FigureModel? _figure;
    private bool _loading = true;

    private string FigureSeoTitle => _figure?.Name is { } name ? $"{name} · Geomantic Figure" : "Figure · Geomancy Wiki";
    private string FigureSeoDescription => _figure is null
        ? "Geomantic figure reference in the Geofancy wiki."
        : SeoSite.Truncate($"{_figure.Name} ({_figure.EnglishName}): {_figure.Tagline}. Elements, verdicts, houses, and corpus notes for Western geomancy.");
    private string FigureCanonicalPath => $"/wiki/glossary/figures/{Slug}";
    private string FigureSeoKeywords => _figure?.Name is { } name
        ? $"{name.ToLowerInvariant()} geomancy, geomantic figure {name.ToLowerInvariant()}, {_figure.Planet?.ToLowerInvariant()} figure"
        : "geomantic figure, geomancy glossary";

    protected override async Task OnInitializedAsync()
    {
        var all = await GeomancyService.GetAllFiguresAsync();
        _figure = WikiFigureSlug.Resolve(all, Slug);
        _loading = false;
    }
}
