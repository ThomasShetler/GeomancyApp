@page "/wiki/how-to/generate-figures"
@rendermode InteractiveServer
@using GeomancyWebUI.Client.Components
@using GeomancyWebUI.Client.Models
@inject IJSRuntime JSRuntime

<PageTitle>Geofancy Wiki - Generate Figures</PageTitle>

<WikiArticleShell Title="How to Generate the Figures"
                  Lead="Mark dots in four horizontal rows (stick-and-surface) to form the four Mothers and name the sixteen geomantic figures."
                  ParentHref="/wiki"
                  ParentLabel="Wiki">

    <section class="wiki-casting-section">
        <h2 class="wiki-casting-section-title">Introduction</h2>
        <p class="wiki-casting-section-lead">
            A geomantic figure has four lines — Head (fire), Neck (air), Body (water), and Foot (earth).
            Each line is either <strong>active</strong> (one dot) or <strong>passive</strong> (two dots).
            Sixteen unique patterns map to the traditional figure names in the
            <a href="/wiki/glossary/figures">Figure Glossary</a>.
        </p>
        <div class="wiki-casting-callout">
            In Geofancy, active lines are stored as <code>1</code> (single ◆) and passive lines as
            <code>2</code> (double ◆ ◆). The app names each figure from the corpus once the four lines are known.
        </div>
    </section>

    <section class="wiki-casting-section">
        <h2 class="wiki-casting-section-title">Mark the dots</h2>
        <p class="wiki-casting-section-lead">
            In the traditional stick-and-surface method you make <strong>four horizontal rows</strong> of
            random dots — Head (fire) on top through Foot (earth) on the bottom. When you are ready, pair
            dots off two at a time in each row, <strong>left to right</strong>. If one dot remains, that
            line is active (single); if zero or two remain, the line is passive (double). Reading the four
            finished rows top to bottom gives you one figure.
        </p>
        <FigureDotCaster MotherLabel="Practice figure"
                         MobileProgressiveRows="@(_useMobileWikiCasting == true)"
                         MobileActionsFirst="@(_useMobileWikiCasting == true)" />
    </section>

    <section class="wiki-casting-section wiki-casting-section--mothers-walkthrough">
        <h2 class="wiki-casting-section-title">Form the four Mothers</h2>
        <p class="wiki-casting-section-lead">
            A full chart requires four Mother figures. Cast the <strong>First Mother</strong>,
            <strong>Vita (house 1)</strong>, into the rightmost slot first, then Lucrum (2), Fratres (3), and
            Genitor (4). The top row reads <strong>8, 7, 6, 5, 4, 3, 2, 1</strong> left to right — each Mother
            goes into the slot with the <strong>same house number</strong>.
        </p>
        @if (_useMobileWikiCasting == true)
        {
            <CastingMobileShell @ref="mobileShell"
                                Walkthrough="@mothersWalkthrough"
                                MothersOnlyPreview="true">
                <ChartCastingWalkthrough @ref="mothersWalkthrough"
                                         Mode="ChartCastingMode.MothersOnly"
                                         ShowChartColumn="false"
                                         HostMode="ChartCastingHostMode.WikiMobile"
                                         OnMothersPreviewChanged="HandleMothersPreviewChangedAsync" />
            </CastingMobileShell>
        }
        else if (_useMobileWikiCasting == false)
        {
            <ChartCastingWalkthrough Mode="ChartCastingMode.MothersOnly" />
        }
    </section>

    <section class="wiki-casting-section">
        <h2 class="wiki-casting-section-title">Other ways to enter figures</h2>
        <p class="wiki-casting-section-lead">
            Geofancy does not randomize marks for you — the randomization stays with your hands.
            Once you know the four lines, you can also enter them directly in the
            <a href="/workspace">Workspace</a> or <a href="/mobile">Mobile View</a> by tapping each line
            on the Mother figures to toggle between single and double dots.
        </p>
        <p class="wiki-casting-section-lead">
            When your four Mothers are set, continue to
            <a href="/wiki/how-to/shield-chart">How to Cast a Shield Chart</a> to derive the rest of the chart.
        </p>
    </section>

</WikiArticleShell>

@code {
    private bool? _useMobileWikiCasting;
    private CastingMobileShell? mobileShell;
    private ChartCastingWalkthrough? mothersWalkthrough;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _useMobileWikiCasting.HasValue)
        {
            return;
        }

        try
        {
            _useMobileWikiCasting = await JSRuntime.InvokeAsync<bool>("geofancyDeviceIsMobile");
        }
        catch
        {
            _useMobileWikiCasting = false;
        }

        StateHasChanged();
    }

    private Task HandleMothersPreviewChangedAsync(MothersPreviewChangedEventArgs args) =>
        mobileShell?.ApplyMothersPreviewAsync(args) ?? Task.CompletedTask;
}
