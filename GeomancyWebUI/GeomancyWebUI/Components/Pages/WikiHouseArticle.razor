@page "/wiki/glossary/houses/{HouseId:int}"
@rendermode InteractiveServer
@using GeomancyWebUI.Client.Models
@using GeomancyWebUI.Client.Services
@using GeomancyWebUI.Services
@inject IGeomancyService GeomancyService

<PageSeo Title="@HouseSeoTitle"
          Description="@HouseSeoDescription"
          CanonicalPath="@HouseCanonicalPath"
          Keywords="@HouseSeoKeywords"
          OgType="article" />

<WikiArticleShell Title="@(_house != null ? $"House {_house.Id} · {_house.House}" : "House not found")"
                  Lead="@(_house?.TraditionalName)"
                  ParentHref="/wiki/glossary/houses"
                  ParentLabel="Houses">

    @if (_loading)
    {
        <p class="wiki-loading">Loading…</p>
    }
    else if (_house == null)
    {
        <div class="wiki-not-found">
            <p>No house matches this link. Use ids 1–12.</p>
            <p><a href="/wiki/glossary/houses">Browse all houses</a></p>
        </div>
    }
    else
    {
        <WikiHouseReferenceStack House="@_house" />
    }

</WikiArticleShell>

@code {
    [Parameter] public int HouseId { get; set; }

    private HouseDirectoryEntry? _house;
    private bool _loading = true;

    private string HouseSeoTitle => _house is null ? "House · Geomancy Wiki" : $"House {_house.Id} · {_house.House}";
    private string HouseSeoDescription => _house is null
        ? "Geomantic house reference in the Geofancy wiki."
        : SeoSite.Truncate($"House {_house.Id} ({_house.House}): {_house.TraditionalName}. Topics, example questions, and reading notes for geomancy.");
    private string HouseCanonicalPath => $"/wiki/glossary/houses/{HouseId}";
    private string HouseSeoKeywords => _house is null
        ? "geomancy houses, house glossary"
        : $"geomancy house {_house.Id}, {_house.House?.ToLowerInvariant()}, astrological house geomancy";

    protected override async Task OnInitializedAsync()
    {
        var houses = await GeomancyService.GetHousesDirectoryAsync();
        _house = houses.FirstOrDefault(h => h.Id == HouseId);
        _loading = false;
    }
}
