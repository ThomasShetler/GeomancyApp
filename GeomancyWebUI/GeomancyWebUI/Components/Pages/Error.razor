@page "/Error"
@using System.Diagnostics

<PageTitle>Geofancy - Error</PageTitle>

<div class="error-page" role="alert">
    <h1 class="error-page-title">Something went wrong</h1>
    <p class="error-page-lead">
        Geofancy hit an unexpected error while handling your request. Reload the page to try again,
        or return home and reopen your chart from a share link if you had one open.
    </p>

    @if (ShowRequestId)
    {
        <p class="error-page-request">
            <strong>Request ID:</strong> <code>@RequestId</code>
            <span class="error-page-request-hint"> — include this if you report the issue on GitHub.</span>
        </p>
    }

    <ul class="error-page-links">
        <li><a href="/">Home</a></li>
        <li><a href="/wiki">Wiki</a></li>
        <li><a href="https://github.com/ThomasShetler/GeomancyApp/issues" target="_blank" rel="noopener noreferrer">Report on GitHub</a></li>
    </ul>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
