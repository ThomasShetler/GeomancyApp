@using Microsoft.AspNetCore.Components.Web

@if (Visible)
{
    <div class="cast-entry-backdrop"
         @onclick="Close"
         @onkeydown="OnKeyDown">
        <div class="cast-entry-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="cast-entry-title"
             @onclick:stopPropagation="true">
            <h2 id="cast-entry-title" class="cast-entry-title">Cast a chart</h2>
            <p class="cast-entry-lead">How would you like to start?</p>

            <div class="cast-entry-options">
                <button type="button"
                        class="cast-entry-option"
                        @onclick="() => Choose(CastChartEntryChoice.HasMothers)">
                    <span class="cast-entry-option-title">I have generated the four Mothers</span>
                    <span class="cast-entry-option-desc">Open the workspace with the chart and reading tools.</span>
                </button>

                <button type="button"
                        class="cast-entry-option"
                        @onclick="() => Choose(CastChartEntryChoice.NeedMothers)">
                    <span class="cast-entry-option-title">I have not generated the four Mothers yet</span>
                    <span class="cast-entry-option-desc">Mark dots to form each Mother, then continue into the full chart.</span>
                </button>

                <button type="button"
                        class="cast-entry-option"
                        @onclick="() => Choose(CastChartEntryChoice.LearnInteractive)">
                    <span class="cast-entry-option-title">I am new to geomancy and want to learn how the chart works</span>
                    <span class="cast-entry-option-desc">Step through an interactive shield walkthrough.</span>
                </button>
            </div>

            <button type="button" class="cast-entry-cancel" @onclick="Close">Cancel</button>
        </div>
    </div>
}

@code {
    public enum CastChartEntryChoice
    {
        HasMothers,
        NeedMothers,
        LearnInteractive
    }

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CastChartEntryChoice> OnChoice { get; set; }

    private Task Close() => OnClose.InvokeAsync();

    private Task Choose(CastChartEntryChoice choice) => OnChoice.InvokeAsync(choice);

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _ = Close();
        }
    }
}
