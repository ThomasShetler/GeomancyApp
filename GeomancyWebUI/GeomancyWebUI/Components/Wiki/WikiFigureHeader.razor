@using GeomancyWebUI.Client.Components
@using GeomancyWebUI.Client.Helpers
@using GeomancyWebUI.Client.Models

@if (Figure != null)
{
    var fig = Figure;
    var planetSymbol = FigureDisplayHelper.GetPlanetSymbol(fig.Planet);
    var zodiacSymbol = FigureDisplayHelper.GetZodiacSymbol(fig.Sign);
    var qualityChipClass = FigureDisplayHelper.GetQualityChipClass(fig.Quality);

    <header class="wiki-figure-header">
        <div class="wiki-figure-header-text">
            <h2 class="wiki-figure-name">@fig.Name</h2>
            @if (!string.IsNullOrWhiteSpace(fig.EnglishName))
            {
                <p class="wiki-figure-english">@fig.EnglishName</p>
            }
            @if (!string.IsNullOrWhiteSpace(fig.OtherNames))
            {
                <p class="wiki-figure-aliases">a.k.a. @fig.OtherNames</p>
            }
            @if (!string.IsNullOrWhiteSpace(fig.Tagline))
            {
                <p class="wiki-figure-tagline">@fig.Tagline</p>
            }
        </div>
        <div class="wiki-figure-emblem" aria-hidden="true">
            <FigureContainer Figure="@fig"
                             IsInteractive="false"
                             ShowFigureName="false"
                             ShowHouseStrength="false" />
        </div>
    </header>

    <div class="chip-row compact-chips wiki-figure-chips">
        @if (!string.IsNullOrWhiteSpace(fig.Planet))
        {
            <span class="chip chip-planet">
                <span class="chip-glyph">@planetSymbol</span>
                <span class="chip-text">@fig.Planet</span>
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(fig.Sign))
        {
            <span class="chip chip-sign">
                <span class="chip-glyph">@zodiacSymbol</span>
                <span class="chip-text">@fig.Sign</span>
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(fig.Quality))
        {
            <span class="chip @qualityChipClass">@fig.Quality</span>
        }
        @if (!string.IsNullOrWhiteSpace(fig.Keyword))
        {
            <span class="chip chip-keyword">"@fig.Keyword"</span>
        }
        @if (!string.IsNullOrWhiteSpace(fig.Humor))
        {
            <span class="chip chip-humor">@fig.Humor</span>
        }
    </div>
}

@code {
    [Parameter] public FigureModel? Figure { get; set; }
}
