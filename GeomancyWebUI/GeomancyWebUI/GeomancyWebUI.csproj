<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GeomancyApp.ServiceDefaults\GeomancyApp.ServiceDefaults.csproj" />
    <ProjectReference Include="..\GeomancyWebUI.Client\GeomancyWebUI.Client.csproj" />
    <ProjectReference Include="..\..\Geomancy.Core\Geomancy.Core.csproj" />
    <ProjectReference Include="..\..\Geomancy.Api.Contracts\Geomancy.Api.Contracts.csproj" />
    <ProjectReference Include="..\..\Geomancy.Api.Handlers\Geomancy.Api.Handlers.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.17" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\databank\FigureCorpus\Figures.json">
      <Link>databank\FigureCorpus\Figures.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\databank\HouseAndCourtDirectory\HouseData.json">
      <Link>databank\HouseAndCourtDirectory\HouseData.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\databank\HouseAndCourtDirectory\CourtData.json">
      <Link>databank\HouseAndCourtDirectory\CourtData.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\databank\WayOfPointsDirectory\ElementData.json">
      <Link>databank\WayOfPointsDirectory\ElementData.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\databank\WayOfPointsDirectory\PathTypeData.json">
      <Link>databank\WayOfPointsDirectory\PathTypeData.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Stable filename for WASM client scoped CSS (FigureDetailPanel, charts, walkthrough). -->
  <Target Name="LinkClientScopedCssBundle" AfterTargets="Build">
    <ItemGroup>
      <_ClientScopedBundle Include="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\staticwebassets\GeomancyWebUI.Client.*.bundle.scp.css" />
      <_ClientScopedBundle Include="$(MSBuildProjectDirectory)\..\GeomancyWebUI.Client\obj\$(Configuration)\$(TargetFramework)\scopedcss\projectbundle\GeomancyWebUI.Client.bundle.scp.css" />
    </ItemGroup>
    <Copy Condition="'@(_ClientScopedBundle)' != ''"
          SourceFiles="@(_ClientScopedBundle)"
          DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\GeomancyWebUI.Client.bundle.scp.css"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="LinkClientScopedCssBundlePublish" AfterTargets="Publish">
    <ItemGroup>
      <_PubClientBundle Include="$(PublishDir)wwwroot\GeomancyWebUI.Client.*.bundle.scp.css" />
    </ItemGroup>
    <Copy Condition="'@(_PubClientBundle)' != ''"
          SourceFiles="@(_PubClientBundle)"
          DestinationFiles="$(PublishDir)wwwroot\GeomancyWebUI.Client.bundle.scp.css"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
