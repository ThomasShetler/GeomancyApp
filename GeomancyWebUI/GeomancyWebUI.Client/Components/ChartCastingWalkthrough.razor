    {
        WalkthroughStage.Witnesses => TotalWitnessMicroSteps,
        WalkthroughStage.Judge => TotalJudgeMicroSteps,
        WalkthroughStage.Fallout => TotalFalloutMicroSteps,
        _ => 1
    };

    private void PreviousCourtMicroStep()
    {
        if (_activeStage == WalkthroughStage.Witnesses && _witnessMicroStepIndex > 0)
        {
            _witnessMicroStepIndex--;
        }
        else if (_activeStage == WalkthroughStage.Judge && _judgeMicroStepIndex > 0)
        {
            _judgeMicroStepIndex--;
        }
        else if (_activeStage == WalkthroughStage.Fallout && _falloutMicroStepIndex > 0)
        {
            _falloutMicroStepIndex--;
        }
        else
        {
            return;
        }

        ApplyActiveStageState();
        OnActiveStageMicroStepChanged();
    }

    private void NextCourtMicroStep()
    {
        if (_activeStage == WalkthroughStage.Witnesses && _witnessMicroStepIndex < TotalWitnessMicroSteps - 1)
        {
            _witnessMicroStepIndex++;
        }
        else if (_activeStage == WalkthroughStage.Judge && _judgeMicroStepIndex < TotalJudgeMicroSteps - 1)
        {
            _judgeMicroStepIndex++;
        }
        else if (_activeStage == WalkthroughStage.Fallout && _falloutMicroStepIndex < TotalFalloutMicroSteps - 1)
        {
            _falloutMicroStepIndex++;
        }
        else
        {
            return;
        }

        ApplyActiveStageState();
        OnActiveStageMicroStepChanged();
    }

    private string GetCourtMicroStepIndicator() => _activeStage switch
    {
        WalkthroughStage.Witnesses => $"Witness {(GetActiveWitnessBuildIndex() + 1)}/2 - line {GetActiveWitnessLine()}/4",
        WalkthroughStage.Judge => $"Judge line step {GetActiveJudgeLine()}/4",
        WalkthroughStage.Fallout => $"Fallout line step {GetActiveFalloutLine()}/4",
        _ => string.Empty
    };

    private string GetCourtBuildTitle() => _activeStage switch
    {
        WalkthroughStage.Witnesses => $"Building {WitnessBuildTargets[GetActiveWitnessBuildIndex()].Label} from houses {WitnessBuildTargets[GetActiveWitnessBuildIndex()].SourceHouseA}+{WitnessBuildTargets[GetActiveWitnessBuildIndex()].SourceHouseB}",
        WalkthroughStage.Judge => "Building the Judge from the two Witnesses",
        WalkthroughStage.Fallout => "Building Fallout from the Judge and Mother 1",
        _ => string.Empty
    };

    private string GetCourtBuildLead()
    {
        if (_activeStage == WalkthroughStage.Witnesses)
        {
            var build = WitnessBuildTargets[GetActiveWitnessBuildIndex()];
            var line = GetActiveWitnessLine();
            var a = GetHouseLineValue(build.SourceHouseA, line);
            var b = GetHouseLineValue(build.SourceHouseB, line);
            var sum = a + b;
            var parity = sum % 2 == 0 ? "even -> double dot" : "odd -> single dot";
            return $"Combine line {line} from House {build.SourceHouseA} and House {build.SourceHouseB} into the {build.Label}. {a} + {b} = {sum} ({parity}).";
        }

        if (_activeStage == WalkthroughStage.Judge)
        {
            var line = GetActiveJudgeLine();
            var right = GetCourtLineValue(ChartHighlightCourt.RightWitness, line);
            var left = GetCourtLineValue(ChartHighlightCourt.LeftWitness, line);
            var sum = right + left;
            var parity = sum % 2 == 0 ? "even -> double dot" : "odd -> single dot";
            return $"Combine line {line} from Right Witness and Left Witness into the Judge. {right} + {left} = {sum} ({parity}).";
        }

        var falloutLine = GetActiveFalloutLine();
        var judge = GetCourtLineValue(ChartHighlightCourt.Judge, falloutLine);
        var motherOne = GetHouseLineValue(1, falloutLine);
        var falloutSum = judge + motherOne;
        var falloutParity = falloutSum % 2 == 0 ? "even -> double dot" : "odd -> single dot";
        return $"Combine line {falloutLine} from the Judge and House 1 (Vita) into Fallout. {judge} + {motherOne} = {falloutSum} ({falloutParity}).";
    }

