    private string GetWalkthroughRootClass()
    {
        var classes = new List<string>();
        if (!ShowChartColumn)
        {
            classes.Add("no-chart-column");
        }

        if (HostMode == ChartCastingHostMode.EmbeddedWorkspace)
        {
            classes.Add("is-embedded-workspace");
            if (ShowChartColumn)
            {
                classes.Add("is-embedded-workspace-with-chart");
            }

            if (EmbeddedMobileMothers)
            {
                classes.Add("is-embedded-mobile-mothers");
            }
        }

        if (HostMode == ChartCastingHostMode.WikiMobile)
        {
            classes.Add("is-embedded-workspace");
            classes.Add("is-embedded-mobile-mothers");
            if (Mode == ChartCastingMode.Full)
            {
                classes.Add("is-wiki-mobile-full");
            }

            if (GetMobileDrawerPhase() == WalkthroughMobileDrawerPhase.Generation)
            {
                classes.Add("is-wiki-mobile-generation");
            }

            if (GetMobileDrawerPhase() == WalkthroughMobileDrawerPhase.FigureReveal)
            {
                classes.Add("is-wiki-mobile-generation");
                classes.Add("is-wiki-mobile-figure-reveal");
            }
        }

        if (HostMode == ChartCastingHostMode.Standalone)
        {
            classes.Add("is-standalone-walkthrough");
        }

        if (!UseEmbeddedMobileMothers)
        {
            classes.Add("is-desktop-mothers-casting");
        }

        return string.Join(' ', classes);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeMotherSlots();
        _shieldSteps = BuildShieldSteps();
        _activeStage = WalkthroughStage.Mothers;
        _maxUnlockedStageIndex = (int)WalkthroughStage.Mothers;
        try
        {
            _housesDirectory = await GeomancyService.GetHousesDirectoryAsync();
            _courtsDirectory = await GeomancyService.GetCourtsDirectoryAsync();
            _greerFigures = await GeomancyService.GetGreerFiguresDirectoryAsync();
            _greerHousesDirectory = await GeomancyService.GetGreerHousesDirectoryAsync();
        }
        catch
        {
            _housesDirectory = Array.Empty<HouseDirectoryEntry>();
            _courtsDirectory = Array.Empty<CourtDirectoryEntry>();
            _greerFigures = Array.Empty<GreerFigureModel>();
            _greerHousesDirectory = new GreerHouseDirectory();
        }
        ApplyActiveStageState();
        _ = NotifyMobileChartPreviewAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncMothersCastHeightAsync();
    }

    private bool ShouldSyncMothersCastHeight() =>
        ShowChartColumn
        && !UseEmbeddedMobileMothers
        && _activeStage == WalkthroughStage.Mothers
        && _currentMotherIndex >= 0
        && _currentMotherIndex < _motherSlots.Length;

    private async Task SyncMothersCastHeightAsync()
    {
        if (!ShouldSyncMothersCastHeight())
        {
            if (_mothersCastSyncActive)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("geofancyMothersCastSync.stop", _mothersCastSyncKey);
                }
                catch (JSDisconnectedException)
                {
                }

                _mothersCastSyncActive = false;
            }

            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "geofancyMothersCastSync.start",
                _mothersCastSyncKey,
                _chartPreviewRoot,
                _mothersWorkpanel,
                _mothersCastAlign);
            _mothersCastSyncActive = true;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
            // Script may not be ready on first paint.
        }
    }

    public void Dispose()
    {
        if (_mothersCastSyncActive)
        {
            _ = JSRuntime.InvokeVoidAsync("geofancyMothersCastSync.stop", _mothersCastSyncKey);
            _mothersCastSyncActive = false;
        }
    }

    private FigureModel? GetMotherOrNull(int houseNumber) =>
        _motherByHouse.TryGetValue(houseNumber, out var figure) ? figure : null;

    private static string GetMotherSlotTargetText(int houseNumber) => houseNumber switch
    {
        1 => "Cast Mother 1 (Vita) into the rightmost top-row slot, labeled 1.",
        2 => "Cast Mother 2 (Lucrum) into the slot labeled 2.",
        3 => "Cast Mother 3 (Fratres) into the slot labeled 3.",
        4 => "Cast Mother 4 (Genitor) into the slot labeled 4.",
        _ => string.Empty
    };

    private bool IsStageUnlocked(WalkthroughStage stage) => (int)stage <= _maxUnlockedStageIndex;

    private void SelectStage(WalkthroughStage stage)
    {
        if (!IsStageUnlocked(stage))
        {
            return;
        }

        _activeStage = stage;
        _mobileAwaitingSummaryAck = false;
        _showStageCompletionSummary = IsStageGenerationComplete(stage) && IsAtLastMicroStepForStage(stage);
        ApplyActiveStageState();
        _ = NotifyWalkthroughChartPreviewAsync();
    }

    private IReadOnlyList<SlotSelection> GetCurrentStageSelectableSlots()
    {
        if (_activeStage == WalkthroughStage.Mothers)
        {
            return Enumerable.Range(1, 4)
                .Select(h => new SlotSelection(
                    SlotKind.House,
                    h,
                    $"House {h} ({GetLatinHouseName(h)})",
                    GetMotherOrNull(h)))
                .ToList();
        }

        if (_activeStage == WalkthroughStage.Daughters)
        {
            return Enumerable.Range(5, 4)
                .Select(h => new SlotSelection(
                    SlotKind.House,
                    h,
                    $"House {h} ({GetLatinHouseName(h)})",
                    GetFigureForHouse(h)))
                .ToList();
        }

        if (_activeStage == WalkthroughStage.Nieces)
        {
            return Enumerable.Range(9, 4)
                .Select(h => new SlotSelection(
                    SlotKind.House,
                    h,
                    $"House {h} ({GetLatinHouseName(h)})",
                    GetFigureForHouse(h)))
                .ToList();
        }

        if (IsCourtMicroStepStage(_activeStage))
        {
            return new List<SlotSelection>
            {
                new(SlotKind.RightWitness, null, "Right Witness", GetFigureForCourt(ChartHighlightCourt.RightWitness)),
                new(SlotKind.LeftWitness, null, "Left Witness", GetFigureForCourt(ChartHighlightCourt.LeftWitness)),
                new(SlotKind.Judge, null, "Judge", GetFigureForCourt(ChartHighlightCourt.Judge)),
                new(SlotKind.Sentence, null, "Sentence (Fallout)", GetFigureForCourt(ChartHighlightCourt.Sentence))
            };
        }

        return Array.Empty<SlotSelection>();
    }

    private bool ShouldShowStageInspector() => _activeStage switch
    {
        WalkthroughStage.Mothers => _motherSlots.Length == 4 && _motherSlots.All(s => s.Figure != null),
        WalkthroughStage.Daughters => _chart != null && IsStageGenerationComplete(WalkthroughStage.Daughters),
        WalkthroughStage.Nieces => _chart != null && IsStageGenerationComplete(WalkthroughStage.Nieces),
        WalkthroughStage.Witnesses => _chart != null && IsStageGenerationComplete(WalkthroughStage.Witnesses),
        WalkthroughStage.Judge => _chart != null && IsStageGenerationComplete(WalkthroughStage.Judge),
        WalkthroughStage.Fallout => _chart != null && IsStageGenerationComplete(WalkthroughStage.Fallout),
        _ => false
    };

    private bool ShouldShowStageCompletionSummary() =>
        ShouldShowStageInspector() && _showStageCompletionSummary && IsAtLastMicroStepForActiveStage();

    private bool IsActiveStageGenerationComplete() => IsStageGenerationComplete(_activeStage);

    private bool IsStageGenerationComplete(WalkthroughStage stage) => _stageGenerationCompleted.Contains(stage);

    private bool IsAtLastMicroStepForActiveStage() => IsAtLastMicroStepForStage(_activeStage);

    private bool IsAtLastMicroStepForStage(WalkthroughStage stage) => stage switch
    {
        WalkthroughStage.Daughters => _daughterMicroStepIndex >= TotalDaughterMicroSteps - 1,
        WalkthroughStage.Nieces => _nieceMicroStepIndex >= TotalNieceMicroSteps - 1,
        WalkthroughStage.Witnesses => _witnessMicroStepIndex >= TotalWitnessMicroSteps - 1,
        WalkthroughStage.Judge => _judgeMicroStepIndex >= TotalJudgeMicroSteps - 1,
        WalkthroughStage.Fallout => _falloutMicroStepIndex >= TotalFalloutMicroSteps - 1,
        _ => true
    };

    private void MarkActiveStageGenerationComplete() => _stageGenerationCompleted.Add(_activeStage);

    private void ReviewActiveStageGenerationSteps()
    {
        _showStageCompletionSummary = false;
        _mobileAwaitingSummaryAck = false;
        ResetActiveStageMicroStepToStart();
        ApplyActiveStageState();
        _ = NotifyWalkthroughChartPreviewAsync();
        StateHasChanged();
    }

    private void ResetActiveStageMicroStepToStart()
    {
        switch (_activeStage)
        {
            case WalkthroughStage.Daughters:
                _daughterMicroStepIndex = 0;
                break;
            case WalkthroughStage.Nieces:
                _nieceMicroStepIndex = 0;
                break;
            case WalkthroughStage.Witnesses:
                _witnessMicroStepIndex = 0;
                break;
            case WalkthroughStage.Judge:
                _judgeMicroStepIndex = 0;
                break;
            case WalkthroughStage.Fallout:
                _falloutMicroStepIndex = 0;
                break;
        }
    }

    private void OnActiveStageMicroStepChanged()
    {
        if (IsAtLastMicroStepForActiveStage())
        {
            MarkActiveStageGenerationComplete();
            if (HostMode == ChartCastingHostMode.WikiMobile && Mode == ChartCastingMode.Full)
            {
                _mobileAwaitingSummaryAck = true;
                _showStageCompletionSummary = false;
            }
            else
            {
                _showStageCompletionSummary = true;
            }
        }
        else
        {
            _showStageCompletionSummary = false;
            _mobileAwaitingSummaryAck = false;
        }

        _ = NotifyWalkthroughChartPreviewAsync();
        StateHasChanged();
    }

