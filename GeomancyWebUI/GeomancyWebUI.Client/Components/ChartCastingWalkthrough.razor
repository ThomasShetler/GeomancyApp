    };

    public async Task<bool> TryRestoreMothersFromSeedAsync(string seed)
    {
        if (!ChartSeedCodec.TryDecode(seed, out var mothers))
        {
            return false;
        }

        _motherByHouse.Clear();
        for (var house = 1; house <= 4; house++)
        {
            var lines = mothers[house - 1];
            var figure = await GeomancyService.GetFigureAsync(lines.Head, lines.Neck, lines.Body, lines.Foot);
            _motherByHouse[house] = figure;
        }

        foreach (var slot in _motherSlots)
        {
            slot.Figure = _motherByHouse[slot.HouseNumber];
            slot.IsCurrent = false;
        }

        _currentMotherIndex = _motherSlots.Length;
        _workspaceSharePath = ChartSeedCodec.BuildSharePath(
            WorkspaceBasePath,
            _motherByHouse[1],
            _motherByHouse[2],
            _motherByHouse[3],
            _motherByHouse[4]);

        if (Mode == ChartCastingMode.Full && _chart == null)
        {
            await BeginShieldTutorialAsync();
        }
        else
        {
            ApplyActiveStageState();
            await NotifyMobileChartPreviewAsync();
            StateHasChanged();
        }

        return true;
    }

    private async Task PersistCompletedMothersSeedAsync()
    {
        if (_motherByHouse.Count < 4
            || !_motherByHouse.ContainsKey(1)
            || !_motherByHouse.ContainsKey(2)
            || !_motherByHouse.ContainsKey(3)
            || !_motherByHouse.ContainsKey(4))
        {
            return;
        }

        try
        {
            await ChartSeedStorage.SaveAsync(
                JSRuntime,
                _motherByHouse[1],
                _motherByHouse[2],
                _motherByHouse[3],
                _motherByHouse[4],
                ResolveSeedStorageSource());
        }
        catch
        {
            // Non-fatal if localStorage is unavailable.
        }
    }

    private string ResolveSeedStorageSource() => HostMode switch
    {
        ChartCastingHostMode.EmbeddedWorkspace when WorkspaceBasePath.Contains("mobile", StringComparison.OrdinalIgnoreCase) => "mobile-mothers",
        ChartCastingHostMode.EmbeddedWorkspace => "workspace-mothers",
        ChartCastingHostMode.WikiMobile => "wiki-mobile",
        _ => "wiki"
    };

