    private string GetMobileNextButtonLabel() =>
        _mobileAwaitingSummaryAck ? "View summary" : "Next";

    private bool GetMobileCanStepPrevious()
    {
        if (_mobileAwaitingSummaryAck)
        {
            return true;
        }

        return _activeStage switch
        {
            WalkthroughStage.Daughters => _daughterMicroStepIndex > 0,
            WalkthroughStage.Nieces => _nieceMicroStepIndex > 0,
            WalkthroughStage.Witnesses => _witnessMicroStepIndex > 0,
            WalkthroughStage.Judge => _judgeMicroStepIndex > 0,
            WalkthroughStage.Fallout => _falloutMicroStepIndex > 0,
            _ => false
        };
    }

    private bool GetMobileCanStepNext()
    {
        if (_mobileAwaitingSummaryAck)
        {
            return true;
        }

        return _activeStage switch
        {
            WalkthroughStage.Daughters => _daughterMicroStepIndex < TotalDaughterMicroSteps - 1,
            WalkthroughStage.Nieces => _nieceMicroStepIndex < TotalNieceMicroSteps - 1,
            WalkthroughStage.Witnesses => _witnessMicroStepIndex < TotalWitnessMicroSteps - 1,
            WalkthroughStage.Judge => _judgeMicroStepIndex < TotalJudgeMicroSteps - 1,
            WalkthroughStage.Fallout => _falloutMicroStepIndex < TotalFalloutMicroSteps - 1,
            _ => false
        };
    }

    public Task MobileStepPreviousAsync()
    {
        if (_mobileAwaitingSummaryAck)
        {
            _mobileAwaitingSummaryAck = false;
            StepBackOneMicroStepForActiveStage();
            ApplyActiveStageState();
            _ = NotifyWalkthroughChartPreviewAsync();
            StateHasChanged();
            return Task.CompletedTask;
        }

        switch (_activeStage)
        {
            case WalkthroughStage.Daughters:
                PreviousDaughterMicroStep();
                break;
            case WalkthroughStage.Nieces:
                PreviousNieceMicroStep();
                break;
            case WalkthroughStage.Witnesses:
            case WalkthroughStage.Judge:
            case WalkthroughStage.Fallout:
                PreviousCourtMicroStep();
                break;
        }

        return Task.CompletedTask;
    }

    public Task MobileStepNextAsync()
    {
        if (_mobileAwaitingSummaryAck)
        {
            _mobileAwaitingSummaryAck = false;
            _showStageCompletionSummary = true;
            _ = NotifyWalkthroughChartPreviewAsync();
            StateHasChanged();
            return Task.CompletedTask;
        }

        switch (_activeStage)
        {
            case WalkthroughStage.Daughters:
                NextDaughterMicroStep();
                break;
            case WalkthroughStage.Nieces:
                NextNieceMicroStep();
                break;
            case WalkthroughStage.Witnesses:
            case WalkthroughStage.Judge:
            case WalkthroughStage.Fallout:
                NextCourtMicroStep();
                break;
        }

        return Task.CompletedTask;
    }

    private void StepBackOneMicroStepForActiveStage()
    {
        switch (_activeStage)
        {
            case WalkthroughStage.Daughters:
                if (_daughterMicroStepIndex > 0)
                {
                    _daughterMicroStepIndex--;
                }
                break;
            case WalkthroughStage.Nieces:
                if (_nieceMicroStepIndex > 0)
                {
                    _nieceMicroStepIndex--;
                }
                break;
            case WalkthroughStage.Witnesses:
                if (_witnessMicroStepIndex > 0)
                {
                    _witnessMicroStepIndex--;
                }
                break;
            case WalkthroughStage.Judge:
                if (_judgeMicroStepIndex > 0)
                {
                    _judgeMicroStepIndex--;
                }
                break;
            case WalkthroughStage.Fallout:
                if (_falloutMicroStepIndex > 0)
                {
                    _falloutMicroStepIndex--;
                }
                break;
        }
    }

    private async Task ContinueToWorkspaceAsync()
    {
        if (!_motherSlots.All(s => s.Figure != null) || !OnMothersCompleted.HasDelegate)
        {
            return;
        }

        _isContinuingToWorkspace = true;
        StateHasChanged();

        try
        {
            var args = new MothersCompletedEventArgs
            {
                House1 = _motherByHouse[1],
                House2 = _motherByHouse[2],
                House3 = _motherByHouse[3],
                House4 = _motherByHouse[4]
            };
            await OnMothersCompleted.InvokeAsync(args);
        }
        finally
        {
            _isContinuingToWorkspace = false;
            StateHasChanged();
        }
    }

    private async Task BeginShieldTutorialAsync()
    {
        _isLoadingChart = true;
        _chartError = null;
        StateHasChanged();

        try
        {
            var request = BuildChartRequest();
            _chart = await GeomancyService.GenerateChartAsync(request);
            UnlockStage(WalkthroughStage.Daughters);
            _activeStage = WalkthroughStage.Daughters;
            _daughterMicroStepIndex = 0;
            _showStageCompletionSummary = false;
            _mobileAwaitingSummaryAck = false;
            ApplyActiveStageState();
            await NotifyWalkthroughChartPreviewAsync();
            await PersistCompletedMothersSeedAsync();
        }
        catch
        {
            _chartError = "Could not build the chart. Check your connection and try again.";
        }
        finally
        {
            _isLoadingChart = false;
            StateHasChanged();
        }
    }

