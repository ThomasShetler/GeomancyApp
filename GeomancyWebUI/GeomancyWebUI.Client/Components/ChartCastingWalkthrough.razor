    {
        WalkthroughStage.Witnesses => _witnessMicroStepIndex,
        WalkthroughStage.Judge => _judgeMicroStepIndex,
        WalkthroughStage.Fallout => _falloutMicroStepIndex,
        _ => 0
    };

