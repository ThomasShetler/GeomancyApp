    private GenerateFourFiguresRequest BuildChartRequest() => new()
    {
        House1 = ToRequest(_motherByHouse[1]),
        House2 = ToRequest(_motherByHouse[2]),
        House3 = ToRequest(_motherByHouse[3]),
        House4 = ToRequest(_motherByHouse[4])
    };

    private static GenerateFigureRequest ToRequest(FigureModel figure) => new()
    {
        HeadLine = figure.HeadLine,
        NeckLine = figure.NeckLine,
