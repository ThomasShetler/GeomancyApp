    private async Task OnMotherFigureCompleted(FigureModel figure)
    {
        if (_currentMotherIndex < 0 || _currentMotherIndex >= _motherSlots.Length)
        {
            return;
        }

        var slot = _motherSlots[_currentMotherIndex];
        slot.Figure = figure;
        slot.IsCurrent = false;
        _motherByHouse[slot.HouseNumber] = figure;

        _currentMotherIndex++;
        if (_currentMotherIndex < _motherSlots.Length)
        {
            _motherSlots[_currentMotherIndex].IsCurrent = true;
            ApplyActiveStageState();
            await NotifyMobileChartPreviewAsync(slot.HouseNumber);
            StateHasChanged();
            return;
        }

        _workspaceSharePath = ChartSeedCodec.BuildSharePath(
            WorkspaceBasePath,
            _motherByHouse[1],
            _motherByHouse[2],
            _motherByHouse[3],
            _motherByHouse[4]);
        await PersistCompletedMothersSeedAsync();
        ApplyActiveStageState();
        await NotifyMobileChartPreviewAsync(slot.HouseNumber);

        // Desktop workspace mothers flow: go straight to the seeded chart workspace
        // instead of the intermediate stage-complete / wiki-style summary panel.
        if (HostMode == ChartCastingHostMode.EmbeddedWorkspace && OnMothersCompleted.HasDelegate)
        {
            await ContinueToWorkspaceAsync();
            return;
        }

        StateHasChanged();
    }

    private async Task NotifyMobileChartPreviewAsync(int? justCompletedHouseNumber = null)
    {
        if (ShowChartColumn || !IsMobileChartHost())
        {
            return;
        }

        if (Mode == ChartCastingMode.MothersOnly)
        {
            var motherStatus = BuildMotherDrawerStatus(justCompletedHouseNumber);
            var mothersArgs = new MothersPreviewChangedEventArgs
            {
                House1 = GetMotherOrNull(1),
                House2 = GetMotherOrNull(2),
                House3 = GetMotherOrNull(3),
                House4 = GetMotherOrNull(4),
                HighlightedHouseNumbers = GetMotherDrawerHighlights(justCompletedHouseNumber),
                JustCompletedHouseNumber = justCompletedHouseNumber,
                AllMothersComplete = _motherSlots.All(s => s.Figure != null),
                MotherStatusTitle = motherStatus.Title,
                MotherStatusDetail = motherStatus.Detail,
                MotherFigureInsight = motherStatus.Insight,
                MotherActionLabel = motherStatus.ActionLabel
            };

            if (OnMothersPreviewChanged.HasDelegate)
            {
                await OnMothersPreviewChanged.InvokeAsync(mothersArgs);
            }
        }

        await NotifyWalkthroughChartPreviewAsync(justCompletedHouseNumber);
    }

    private async Task NotifyMothersPreviewAsync(int? justCompletedHouseNumber = null) =>
        await NotifyMobileChartPreviewAsync(justCompletedHouseNumber);

    private bool IsMobileChartHost() =>
        HostMode is ChartCastingHostMode.EmbeddedWorkspace or ChartCastingHostMode.WikiMobile;

    private async Task NotifyWalkthroughChartPreviewAsync(int? justCompletedHouseNumber = null)
    {
        if (ShowChartColumn
            || Mode != ChartCastingMode.Full
            || HostMode != ChartCastingHostMode.WikiMobile
            || !OnWalkthroughChartPreviewChanged.HasDelegate)
        {
            return;
        }

        var drawerPhase = GetMobileDrawerPhase();
        var motherStatus = BuildMotherDrawerStatus(justCompletedHouseNumber);
        var args = new WalkthroughChartPreviewChangedEventArgs
        {
            DrawerPhase = drawerPhase,
            IsMothersStage = _activeStage == WalkthroughStage.Mothers,
            House1 = GetMotherOrNull(1),
            House2 = GetMotherOrNull(2),
            House3 = GetMotherOrNull(3),
            House4 = GetMotherOrNull(4),
            Chart = _chart,
            ShowCourtFigures = ShouldShowCourtFigures(),
            VisibleHouseNumbers = GetVisibleHousesForActiveStage(),
            HighlightedHouseNumbers = _activeStage == WalkthroughStage.Mothers
                ? GetMotherDrawerHighlights(justCompletedHouseNumber)
                : _activeHouseHighlights,
            HighlightedCourt = _activeCourtHighlights,
            HouseHighlightedLines = GetLineHighlightsForActiveStage(),
            HouseRevealLineCounts = GetRevealCountsForActiveStage(),
            HouseLineHighlightThemes = GetHighlightThemesForActiveStage(),
            CourtHighlightedLines = GetCourtLineHighlightsForActiveStage(),
            CourtRevealLineCounts = GetCourtRevealCountsForActiveStage(),
            CourtLineHighlightThemes = GetCourtHighlightThemesForActiveStage(),
            JustCompletedHouseNumber = justCompletedHouseNumber,
            AllMothersComplete = _motherSlots.All(s => s.Figure != null),
            StepIndicator = GetMobileStepIndicator(),
            StepTitle = GetMobileStepTitle(),
            StepLead = GetMobileStepLead(),
            StepCallout = GetMobileStepCallout(),
            CanStepPrevious = GetMobileCanStepPrevious(),
            CanStepNext = GetMobileCanStepNext(),
            CollapseDrawer = drawerPhase == WalkthroughMobileDrawerPhase.StageSummary,
            AwaitingSummaryAck = _mobileAwaitingSummaryAck,
            NextButtonLabel = GetMobileNextButtonLabel(),
            MotherStatusTitle = motherStatus.Title,
            MotherStatusDetail = motherStatus.Detail,
            MotherFigureInsight = motherStatus.Insight,
            MotherActionLabel = motherStatus.ActionLabel
        };
        await OnWalkthroughChartPreviewChanged.InvokeAsync(args);
    }

    public Task OnMobileMotherDrawerCollapsedAsync() =>
        NotifyMobileChartPreviewAsync();

    private IReadOnlySet<int>? GetMotherDrawerHighlights(int? justCompletedHouseNumber)
    {
        if (_activeStage != WalkthroughStage.Mothers)
        {
            return _activeHouseHighlights;
        }

        if (justCompletedHouseNumber is int completedHouse)
        {
            return new HashSet<int> { completedHouse };
        }

        if (_currentMotherIndex >= 0 && _currentMotherIndex < _motherSlots.Length)
        {
            return new HashSet<int> { _motherSlots[_currentMotherIndex].HouseNumber };
        }

        if (_motherSlots.Length > 0 && _motherSlots.All(s => s.Figure != null))
        {
            return new HashSet<int> { 1, 2, 3, 4 };
        }

        return null;
    }

    private (string? Title, string? Detail, string? Insight, string? ActionLabel) BuildMotherDrawerStatus(int? justCompletedHouseNumber)
    {
        var allComplete = _motherSlots.All(s => s.Figure != null);
        if (allComplete)
        {
            return (
                "Four Mothers on the shield",
                "All four Mothers are placed in houses 1–4.",
                null,
                "Collapse chart to continue below");
        }

        if (justCompletedHouseNumber is int completedHouse)
        {
            var figure = GetMotherOrNull(completedHouse);
            var latin = MotherNames.GetValueOrDefault(completedHouse).Short;
            var figureName = string.IsNullOrWhiteSpace(figure?.Name) ? "Figure" : figure!.Name;
            var houseName = FigureDisplayHelper.GetHouseName(completedHouse);
            var inHouseText = figure != null ? FigureDisplayHelper.GetFigureInHouseText(figure, completedHouse) : null;
            string? insight = null;
            if (!string.IsNullOrWhiteSpace(inHouseText))
            {
                insight =
                    $"It is said that when {figureName} is in the {houseName} House, it traditionally indicates {inHouseText}";
            }

            string? actionLabel = null;
            if (_currentMotherIndex >= 0 && _currentMotherIndex < _motherSlots.Length)
            {
                var nextHouse = _motherSlots[_currentMotherIndex].HouseNumber;
                var nextLatin = MotherNames.GetValueOrDefault(nextHouse).Short;
                actionLabel = $"Collapse chart and generate Mother {nextHouse} / {nextLatin} ({nextHouse})";
            }

            return (
                $"You got {figureName} in {latin} (House {completedHouse})",
                "Highlighted on the chart above.",
                insight,
                actionLabel);
        }

        if (_currentMotherIndex >= 0 && _currentMotherIndex < _motherSlots.Length)
        {
            var house = _motherSlots[_currentMotherIndex].HouseNumber;
            var latin = MotherNames.GetValueOrDefault(house).Short;
            return (
                $"Cast Mother {house} ({latin})",
                GetMotherSlotTargetText(house),
                null,
                "Show Mother on chart");
        }

        return (
            "Cast the four Mothers",
            "Mark dots below. The chart opens when you finish each Mother.",
            null,
            "Show chart");
    }

    private WalkthroughMobileDrawerPhase GetMobileDrawerPhase()
    {
        if (_activeStage == WalkthroughStage.Mothers)
        {
            return WalkthroughMobileDrawerPhase.Mothers;
        }

        if (_chart == null)
        {
            return WalkthroughMobileDrawerPhase.Mothers;
        }

        if (ShouldShowStageCompletionSummary())
        {
            return WalkthroughMobileDrawerPhase.StageSummary;
        }

        if (_mobileAwaitingSummaryAck)
        {
            return WalkthroughMobileDrawerPhase.FigureReveal;
        }

        return WalkthroughMobileDrawerPhase.Generation;
    }

