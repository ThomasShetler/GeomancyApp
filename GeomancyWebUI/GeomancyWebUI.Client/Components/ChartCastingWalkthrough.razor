    private void ApplyActiveStageState()
    {
        if (_activeStage == WalkthroughStage.Mothers)
        {
            ApplyMotherStageHighlights();
            EnsureSelectedSlotForStage();
            return;
        }

        if (_activeStage == WalkthroughStage.Daughters)
        {
            ApplyDaughterMicroStepState();
            EnsureSelectedSlotForStage();
            return;
        }

        if (_activeStage == WalkthroughStage.Nieces)
        {
            ApplyNieceMicroStepState();
            EnsureSelectedSlotForStage();
            return;
        }

        if (_activeStage == WalkthroughStage.Witnesses)
        {
            ApplyWitnessMicroStepState();
            EnsureSelectedSlotForStage();
            return;
        }

        if (_activeStage == WalkthroughStage.Judge)
        {
            ApplyJudgeMicroStepState();
            EnsureSelectedSlotForStage();
            return;
        }

        if (_activeStage == WalkthroughStage.Fallout)
        {
            ApplyFalloutMicroStepState();
            EnsureSelectedSlotForStage();
            return;
        }

        ApplyShieldStageHighlights(_activeStage);
        EnsureSelectedSlotForStage();
    }

    private void ApplyDaughterMicroStepState()
    {
        _activeCourtHighlights = null;
        _activeHouseHighlights = null;

        _daughterRevealLineCounts.Clear();
        _daughterHighlightedLines.Clear();
        _daughterHighlightThemes.Clear();
        _daughterVisibleHouses.Clear();

        foreach (var house in Houses1To4)
        {
            _daughterVisibleHouses.Add(house);
        }

        var stepIndex = Math.Clamp(_daughterMicroStepIndex, 0, TotalDaughterMicroSteps - 1);
        var activeBuildIndex = GetActiveDaughterBuildIndex();
        var activeSourceOffset = GetActiveSourceOffset();
        var activeTargetHouse = DaughterBuildTargets[activeBuildIndex].HouseNumber;
        var activeSourceLine = (int)DaughterBuildTargets[activeBuildIndex].SourceLine;
        var activeTheme = DaughterBuildTargets[activeBuildIndex].Theme;

        for (var build = 0; build < DaughterBuildTargets.Length; build++)
        {
            var targetHouse = DaughterBuildTargets[build].HouseNumber;
            var maxRevealForBuild = Math.Min(stepIndex - (build * 4), 3);

            if (maxRevealForBuild < 0)
            {
                continue;
            }

            _daughterVisibleHouses.Add(targetHouse);
            _daughterRevealLineCounts[targetHouse] = maxRevealForBuild + 1;
        }

        var activeSourceHouse = activeSourceOffset + 1;
        var activeTargetLine = activeSourceOffset + 1;
        _activeHouseHighlights = new HashSet<int> { activeTargetHouse };
        _daughterHighlightedLines[activeTargetHouse] = activeTargetLine;
        _daughterHighlightedLines[activeSourceHouse] = activeSourceLine;
        _daughterHighlightThemes[activeTargetHouse] = activeTheme;
        _daughterHighlightThemes[activeSourceHouse] = activeTheme;

        _daughterCompletionNarrative = BuildLatestDaughterNarrative(stepIndex);
    }

    private void ApplyNieceMicroStepState()
    {
        _activeCourtHighlights = null;
        _activeHouseHighlights = null;

        _nieceRevealLineCounts.Clear();
        _nieceHighlightedLines.Clear();
        _nieceHighlightThemes.Clear();
        _nieceVisibleHouses.Clear();

        foreach (var house in Houses1To8)
        {
            _nieceVisibleHouses.Add(house);
        }

        var stepIndex = Math.Clamp(_nieceMicroStepIndex, 0, TotalNieceMicroSteps - 1);
        var activeBuildIndex = GetActiveNieceBuildIndex();
        var activeSourceOffset = GetActiveNieceSourceOffset();
        var activeTarget = NieceBuildTargets[activeBuildIndex];
        var activeTargetHouse = activeTarget.HouseNumber;
        var activeLine = activeSourceOffset + 1;
        var activeTheme = GetThemeForLine(activeLine);

        for (var build = 0; build < NieceBuildTargets.Length; build++)
        {
            var targetHouse = NieceBuildTargets[build].HouseNumber;
            var maxRevealForBuild = Math.Min(stepIndex - (build * 4), 3);
            if (maxRevealForBuild < 0)
            {
                continue;
            }

            _nieceVisibleHouses.Add(targetHouse);
            _nieceRevealLineCounts[targetHouse] = maxRevealForBuild + 1;
        }

        _activeHouseHighlights = new HashSet<int> { activeTargetHouse };
        _nieceHighlightedLines[activeTargetHouse] = activeLine;
        _nieceHighlightedLines[activeTarget.SourceHouseA] = activeLine;
        _nieceHighlightedLines[activeTarget.SourceHouseB] = activeLine;
        _nieceHighlightThemes[activeTargetHouse] = activeTheme;
        _nieceHighlightThemes[activeTarget.SourceHouseA] = activeTheme;
        _nieceHighlightThemes[activeTarget.SourceHouseB] = activeTheme;

        _nieceCompletionNarrative = BuildLatestNieceNarrative(stepIndex);
    }

    private void ResetCourtStageVisualState()
    {
        _activeHouseHighlights = null;
        _activeCourtHighlights = null;
        _courtHighlightedLines.Clear();
        _courtRevealLineCounts.Clear();
        _courtHighlightThemes.Clear();
        _courtSourceHouseHighlightedLines.Clear();
        _courtSourceHouseHighlightThemes.Clear();
    }

    private void ApplyWitnessMicroStepState()
    {
        ResetCourtStageVisualState();
        var stepIndex = Math.Clamp(_witnessMicroStepIndex, 0, TotalWitnessMicroSteps - 1);
        var buildIndex = GetActiveWitnessBuildIndex();
        var activeLine = GetActiveWitnessLine();
        var target = WitnessBuildTargets[buildIndex];
        var theme = GetThemeForLine(activeLine);

        for (var build = 0; build < WitnessBuildTargets.Length; build++)
        {
            var targetCourt = WitnessBuildTargets[build].TargetCourt;
            var maxRevealForBuild = Math.Min(stepIndex - (build * 4), 3);
            if (maxRevealForBuild < 0)
            {
                continue;
            }

            _courtRevealLineCounts[targetCourt] = maxRevealForBuild + 1;
        }

        _activeCourtHighlights = new HashSet<ChartHighlightCourt> { target.TargetCourt };
        _courtHighlightedLines[target.TargetCourt] = activeLine;
        _courtHighlightThemes[target.TargetCourt] = theme;
        _courtSourceHouseHighlightedLines[target.SourceHouseA] = activeLine;
        _courtSourceHouseHighlightedLines[target.SourceHouseB] = activeLine;
        _courtSourceHouseHighlightThemes[target.SourceHouseA] = theme;
        _courtSourceHouseHighlightThemes[target.SourceHouseB] = theme;
        _courtCompletionNarrative = BuildWitnessNarrative(stepIndex);
    }

    private void ApplyJudgeMicroStepState()
    {
        ResetCourtStageVisualState();
        var stepIndex = Math.Clamp(_judgeMicroStepIndex, 0, TotalJudgeMicroSteps - 1);
        var activeLine = GetActiveJudgeLine();
        var theme = GetThemeForLine(activeLine);

        _courtRevealLineCounts[ChartHighlightCourt.Judge] = Math.Clamp(stepIndex + 1, 1, 4);
        _activeCourtHighlights = new HashSet<ChartHighlightCourt> { ChartHighlightCourt.Judge };
        _courtHighlightedLines[ChartHighlightCourt.Judge] = activeLine;
        _courtHighlightedLines[ChartHighlightCourt.RightWitness] = activeLine;
        _courtHighlightedLines[ChartHighlightCourt.LeftWitness] = activeLine;
        _courtHighlightThemes[ChartHighlightCourt.Judge] = theme;
        _courtHighlightThemes[ChartHighlightCourt.RightWitness] = theme;
        _courtHighlightThemes[ChartHighlightCourt.LeftWitness] = theme;
        _courtCompletionNarrative = stepIndex >= TotalJudgeMicroSteps - 1 ? BuildCourtRoleNarrative(ChartHighlightCourt.Judge) : null;
    }

    private void ApplyFalloutMicroStepState()
    {
        ResetCourtStageVisualState();
        var stepIndex = Math.Clamp(_falloutMicroStepIndex, 0, TotalFalloutMicroSteps - 1);
        var activeLine = GetActiveFalloutLine();
        var theme = GetThemeForLine(activeLine);

        _courtRevealLineCounts[ChartHighlightCourt.Sentence] = Math.Clamp(stepIndex + 1, 1, 4);
        _activeCourtHighlights = new HashSet<ChartHighlightCourt> { ChartHighlightCourt.Sentence };
        _courtHighlightedLines[ChartHighlightCourt.Sentence] = activeLine;
        _courtHighlightedLines[ChartHighlightCourt.Judge] = activeLine;
        _courtHighlightThemes[ChartHighlightCourt.Sentence] = theme;
        _courtHighlightThemes[ChartHighlightCourt.Judge] = theme;
        _courtSourceHouseHighlightedLines[1] = activeLine;
        _courtSourceHouseHighlightThemes[1] = theme;
        _activeHouseHighlights = new HashSet<int> { 1 };
        _courtCompletionNarrative = stepIndex >= TotalFalloutMicroSteps - 1 ? BuildCourtRoleNarrative(ChartHighlightCourt.Sentence) : null;
    }

    private int GetActiveDaughterBuildIndex() => Math.Clamp(_daughterMicroStepIndex / 4, 0, DaughterBuildTargets.Length - 1);

    private int GetActiveSourceOffset() => Math.Clamp(_daughterMicroStepIndex % 4, 0, 3);

    private int GetActiveNieceBuildIndex() => Math.Clamp(_nieceMicroStepIndex / 4, 0, NieceBuildTargets.Length - 1);

    private int GetActiveNieceSourceOffset() => Math.Clamp(_nieceMicroStepIndex % 4, 0, 3);

    private int GetActiveWitnessBuildIndex() => Math.Clamp(_witnessMicroStepIndex / 4, 0, WitnessBuildTargets.Length - 1);

    private int GetActiveWitnessLine() => Math.Clamp((_witnessMicroStepIndex % 4) + 1, 1, 4);

    private int GetActiveJudgeLine() => Math.Clamp(_judgeMicroStepIndex + 1, 1, 4);

    private int GetActiveFalloutLine() => Math.Clamp(_falloutMicroStepIndex + 1, 1, 4);

    private static string GetThemeForLine(int lineNumber) => lineNumber switch
    {
        1 => "fire",
        2 => "air",
        3 => "water",
        _ => "earth"
    };

    private int GetHouseLineValue(int houseNumber, int lineNumber)
    {
        var figure = GetFigureForHouse(houseNumber);
        if (figure == null)
        {
            return 2;
        }

        return lineNumber switch
        {
            1 => figure.HeadLine,
            2 => figure.NeckLine,
            3 => figure.BodyLine,
            _ => figure.FootLine
        };
    }

    private FigureModel? GetFigureForHouse(int houseNumber)
    {
        if (houseNumber <= 4)
        {
            return GetMotherOrNull(houseNumber);
        }

        return _chart?.Houses?.FirstOrDefault(h => h.HouseNumber == houseNumber)?.Figure;
    }

    private static string GetLatinHouseName(int houseNumber) =>
        HouseLatinNames.TryGetValue(houseNumber, out var name) ? name : $"House {houseNumber}";

    private void EnsureSelectedSlotForStage()
    {
        if (!ShouldShowStageInspector())
        {
            _selectedSlot = null;
            return;
        }

        var stageSlots = GetCurrentStageSelectableSlots();
        if (stageSlots.Count == 0)
        {
            _selectedSlot = null;
            return;
        }

        if (_selectedSlot != null)
        {
            var stillPresent = stageSlots.FirstOrDefault(s =>
                s.Kind == _selectedSlot.Kind &&
                s.HouseNumber == _selectedSlot.HouseNumber &&
                s.SlotLabel == _selectedSlot.SlotLabel);

            if (stillPresent != null)
            {
                _selectedSlot = stillPresent;
                return;
            }
        }

        _selectedSlot = stageSlots.FirstOrDefault(s => s.Figure != null) ?? stageSlots[0];
    }

    private FigureModel? GetFigureForCourt(ChartHighlightCourt court) => court switch
    {
        ChartHighlightCourt.RightWitness => _chart?.RightWitness,
        ChartHighlightCourt.LeftWitness => _chart?.LeftWitness,
        ChartHighlightCourt.Judge => _chart?.Judge,
        ChartHighlightCourt.Sentence => _chart?.Sentence,
        _ => null
    };

    private int GetCourtLineValue(ChartHighlightCourt court, int lineNumber)
    {
        var figure = GetFigureForCourt(court);
        if (figure == null)
        {
            return 2;
        }

        return lineNumber switch
        {
            1 => figure.HeadLine,
            2 => figure.NeckLine,
            3 => figure.BodyLine,
            _ => figure.FootLine
        };
    }

    private string? BuildLatestDaughterNarrative(int microStep)
    {
        if (_chart == null)
        {
            return null;
        }

        var latestCompletedBuild = microStep / 4;
        if (microStep % 4 != 3)
        {
            latestCompletedBuild--;
        }

        if (latestCompletedBuild < 0 || latestCompletedBuild >= DaughterBuildTargets.Length)
        {
            return null;
        }

        var houseNumber = DaughterBuildTargets[latestCompletedBuild].HouseNumber;
        var figure = _chart.Houses?.FirstOrDefault(h => h.HouseNumber == houseNumber)?.Figure;
        if (figure == null)
        {
            return null;
        }

        figure.InHouses.TryGetValue(houseNumber.ToString(), out var houseMeaning);
        var safeMeaning = string.IsNullOrWhiteSpace(houseMeaning)
            ? "its in-house emphasis follows the same daughter-building logic."
            : houseMeaning.Trim();
        var nextHouse = houseNumber < 8 ? houseNumber + 1 : (int?)null;
        var transition = nextHouse.HasValue
            ? $"Continue with House {nextHouse.Value} by moving to the next source line."
            : "All four Daughters are now generated line by line from the Mothers.";

        return $"You got {figure.Name} in House {houseNumber}. It is sometimes thought to mean {safeMeaning} {transition}";
    }

    private string? BuildLatestNieceNarrative(int microStep)
    {
        if (_chart == null)
        {
            return null;
        }

        var latestCompletedBuild = microStep / 4;
        if (microStep % 4 != 3)
        {
            latestCompletedBuild--;
        }

        if (latestCompletedBuild < 0 || latestCompletedBuild >= NieceBuildTargets.Length)
        {
            return null;
        }

        var target = NieceBuildTargets[latestCompletedBuild];
        var houseNumber = target.HouseNumber;
        var figure = _chart.Houses?.FirstOrDefault(h => h.HouseNumber == houseNumber)?.Figure;
        if (figure == null)
        {
            return null;
        }

        figure.InHouses.TryGetValue(houseNumber.ToString(), out var houseMeaning);
        var safeMeaning = string.IsNullOrWhiteSpace(houseMeaning)
            ? "its house emphasis follows from the paired-source parity build."
            : houseMeaning.Trim();
        var nextHouse = houseNumber < 12 ? houseNumber + 1 : (int?)null;
        var transition = nextHouse.HasValue
            ? $"Continue with House {nextHouse.Value} using the next adjacent source pair."
            : "All four Nieces are now built and the Witnesses can be derived.";

        return $"House {houseNumber} resolves as {figure.Name}. It is sometimes thought to mean {safeMeaning} {transition}";
    }

    private string? BuildWitnessNarrative(int microStep)
    {
        if (_chart == null)
        {
            return null;
        }

        var latestCompletedBuild = microStep / 4;
        if (microStep % 4 != 3)
        {
            latestCompletedBuild--;
        }

        if (latestCompletedBuild < 0 || latestCompletedBuild >= WitnessBuildTargets.Length)
        {
            return null;
        }

        var targetCourt = WitnessBuildTargets[latestCompletedBuild].TargetCourt;
        var figure = GetFigureForCourt(targetCourt);
        if (figure == null)
        {
            return null;
        }

        var nextLabel = latestCompletedBuild == 0
            ? "Next: Left Witness from houses 11 and 12."
            : "Both Witnesses are set. Continue to the Judge.";
        var meaning = GetCourtRoleMeaning(figure, targetCourt);
        return $"{WitnessBuildTargets[latestCompletedBuild].Label} is {figure.Name}. {meaning} {nextLabel}";
    }

    private string BuildCourtRoleNarrative(ChartHighlightCourt court)
    {
        var figure = GetFigureForCourt(court);
        if (figure == null)
        {
            return string.Empty;
        }

        var roleMeaning = GetCourtRoleMeaning(figure, court);
        var stageTransition = court switch
        {
            ChartHighlightCourt.Judge => "Continue to Fallout (Judge + House 1).",
            ChartHighlightCourt.Sentence => "The court sequence is complete.",
            _ => string.Empty
        };

        return $"{GetCourtDisplayName(court)} is {figure.Name}. {roleMeaning} {stageTransition}".Trim();
    }

    private FigureModel? GetCurrentStageResultFigure()
    {
        if (_activeStage == WalkthroughStage.Daughters)
        {
            var target = DaughterBuildTargets[GetActiveDaughterBuildIndex()];
            return GetFigureForHouse(target.HouseNumber);
        }

        if (_activeStage == WalkthroughStage.Nieces)
        {
            var target = NieceBuildTargets[GetActiveNieceBuildIndex()];
            return GetFigureForHouse(target.HouseNumber);
        }

        if (_activeStage == WalkthroughStage.Witnesses)
        {
            var target = WitnessBuildTargets[GetActiveWitnessBuildIndex()];
            return GetFigureForCourt(target.TargetCourt);
        }

        if (_activeStage == WalkthroughStage.Judge)
        {
            return GetFigureForCourt(ChartHighlightCourt.Judge);
        }

        if (_activeStage == WalkthroughStage.Fallout)
        {
            return GetFigureForCourt(ChartHighlightCourt.Sentence);
        }

        return null;
    }

    private string GetCurrentStageResultTitle() => _activeStage switch
    {
        WalkthroughStage.Daughters => $"Current Daughter Result - House {DaughterBuildTargets[GetActiveDaughterBuildIndex()].HouseNumber}",
        WalkthroughStage.Nieces => $"Current Niece Result - House {NieceBuildTargets[GetActiveNieceBuildIndex()].HouseNumber}",
        WalkthroughStage.Witnesses => $"Current Court Result - {WitnessBuildTargets[GetActiveWitnessBuildIndex()].Label}",
        WalkthroughStage.Judge => "Current Court Result - Judge",
        WalkthroughStage.Fallout => "Current Court Result - Fallout",
        _ => "Current Result"
    };

    private string? GetCurrentStageResultMeaning()
    {
        var figure = GetCurrentStageResultFigure();
        if (figure == null)
        {
            return null;
        }

        if (_activeStage == WalkthroughStage.Daughters)
        {
            var house = DaughterBuildTargets[GetActiveDaughterBuildIndex()].HouseNumber;
            return GetHouseMeaning(figure, house);
        }

        if (_activeStage == WalkthroughStage.Nieces)
        {
            var house = NieceBuildTargets[GetActiveNieceBuildIndex()].HouseNumber;
            return GetHouseMeaning(figure, house);
        }

        if (_activeStage == WalkthroughStage.Witnesses)
        {
            return GetCourtRoleMeaning(figure, WitnessBuildTargets[GetActiveWitnessBuildIndex()].TargetCourt);
        }

        if (_activeStage == WalkthroughStage.Judge)
        {
            return GetCourtRoleMeaning(figure, ChartHighlightCourt.Judge);
        }

        if (_activeStage == WalkthroughStage.Fallout)
        {
            return GetCourtRoleMeaning(figure, ChartHighlightCourt.Sentence);
        }

        return null;
    }

    private static string? GetHouseMeaning(FigureModel figure, int houseNumber)
    {
        figure.InHouses.TryGetValue(houseNumber.ToString(), out var meaning);
        if (!string.IsNullOrWhiteSpace(meaning))
        {
            return meaning.Trim();
        }

        return null;
    }

    private string GetCourtRoleMeaning(FigureModel figure, ChartHighlightCourt court)
    {
        var roleKeys = court switch
        {
            ChartHighlightCourt.RightWitness => new[] { "rightWitness", "right_witness", "witness_right" },
            ChartHighlightCourt.LeftWitness => new[] { "leftWitness", "left_witness", "witness_left" },
            ChartHighlightCourt.Judge => new[] { "judge" },
            ChartHighlightCourt.Sentence => new[] { "sentence", "fallout", "reconciler" },
            _ => Array.Empty<string>()
        };

        foreach (var key in roleKeys)
        {
            if (figure.InCourtRoles.TryGetValue(key, out var meaning) && !string.IsNullOrWhiteSpace(meaning))
            {
                return meaning.Trim();
            }
        }

        return $"Derived by the same parity rules as the houses.";
    }

    private static string GetCourtDisplayName(ChartHighlightCourt court) => court switch
    {
        ChartHighlightCourt.RightWitness => "Right Witness",
        ChartHighlightCourt.LeftWitness => "Left Witness",
        ChartHighlightCourt.Judge => "Judge",
        ChartHighlightCourt.Sentence => "Fallout",
        _ => "Court figure"
    };

    private void ApplyMotherStageHighlights()
    {
        _activeCourtHighlights = null;

        if (_currentMotherIndex >= 0 && _currentMotherIndex < _motherSlots.Length)
        {
            _activeHouseHighlights = new HashSet<int> { _motherSlots[_currentMotherIndex].HouseNumber };
            return;
        }

        if (_motherSlots.Length > 0 && _motherSlots.All(s => s.Figure != null))
        {
            _activeHouseHighlights = new HashSet<int> { 1, 2, 3, 4 };
            return;
        }

        _activeHouseHighlights = null;
    }

    private void ApplyShieldStageHighlights(WalkthroughStage stage)
    {
        var step = _shieldSteps[(int)stage];
        _activeHouseHighlights = step.HouseHighlights;
        _activeCourtHighlights = step.CourtHighlights;
    }

