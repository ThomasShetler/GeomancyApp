@using System.Linq
@using GeomancyWebUI.Client.Components
@using GeomancyWebUI.Client.Helpers
@using GeomancyWebUI.Client.Models
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div @ref="_panelRef" class="figure-detail-panel @(Selection?.Figure == null ? "is-empty" : "") @( _contentReady ? "is-ready" : "")">
    @if (Selection?.Figure == null)
    {
        <div class="detail-empty-state">
            <p>Select a house or court row to inspect its occupant figure.</p>
        </div>
    }
    else
    {
        var baseFig = Selection.Figure;
        var greerFig = ResolveGreerFigure(baseFig);
        var figureBundle = GreerReferenceMergeHelper.MergeFigure(baseFig, greerFig, GreerReferenceMode);
        var fig = figureBundle.DisplayFigure;
        var greerRef = figureBundle.GreerFigure ?? greerFig;
        var showGreerAlongside = figureBundle.ShowGreerAlongside;
        var hideGeofancyOnly = figureBundle.HideGeofancyOnlySections;
        var showGreerAttribution = figureBundle.ShowGreerAttribution;
        var planetSymbol = GetPlanetSymbol(fig.Planet);
        var zodiacSymbol = GetZodiacSymbol(fig.Sign);
        var strengthLabel = GetStrengthLabel(fig.HouseStrength);
        var inSlot = hideGeofancyOnly ? null : ResolveInSlotText(baseFig);
        var houseEntry = ResolveHouseEntry();
        var greerHouse = ResolveGreerHouseEntry();
        var houseBundle = GreerReferenceMergeHelper.MergeHouse(houseEntry, greerHouse, GreerReferenceMode);
        var courtEntry = ResolveCourtEntry();
        var showInterpretation = hideGeofancyOnly
            ? HasInterpretationContent(fig)
            : HasInterpretationContent(fig) || (showGreerAlongside && GreerReferenceMergeHelper.HasGreerInterpretationContent(greerRef));
        var showHouse = houseEntry != null || greerHouse != null;
        var showGreerHousePrimary = houseBundle.UseGreerPrimary && greerHouse != null;
        var showCourt = courtEntry != null && !hideGeofancyOnly;
        var showSources = !hideGeofancyOnly && fig.TraditionalSources?.Any() == true;
        var criticalFlags = GreerCriticalContextHelper.Evaluate(GreerReferenceMode, Selection, Chart);
        var showCriticalContext = criticalFlags.Count > 0;
        var openInterpretation = IsInterpretationOpenByDefault(inSlot);
        var openHouse = IsHouseOpenByDefault(houseEntry) || showGreerHousePrimary;
        var openCourt = IsCourtOpenByDefault(courtEntry);
        var openCorrespondences = IsCorrespondencesOpenByDefault(inSlot);
        var hasContext = HasContextContent(fig, inSlot)
            || (showGreerAlongside && GreerReferenceMergeHelper.HasGreerContextContent(greerRef))
            || showCriticalContext;
        var showPerson = HasPersonContent(fig)
            || (showGreerAlongside && GreerReferenceMergeHelper.HasGreerPersonContent(greerRef));
        var showHouseAffinity = !string.IsNullOrWhiteSpace(fig.StrongHouse) || !string.IsNullOrWhiteSpace(fig.WeakHouse)
            || (showGreerAlongside && greerRef != null && (
                !string.IsNullOrWhiteSpace(greerRef.StrongHouse) || !string.IsNullOrWhiteSpace(greerRef.WeakHouse)));
        var qualityChipClass = GetQualityChipClass(fig.Quality);
        var showVerdict = !hideGeofancyOnly;
        var showTagline = !hideGeofancyOnly && !string.IsNullOrWhiteSpace(fig.Tagline);

        <div class="detail-summary-block">
            <header class="detail-header">
                <div class="detail-header-titles">
                    <p class="slot-eyebrow">@FormatSlotLabel(Selection)</p>
                    <h2 class="figure-name-display">@fig.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(fig.EnglishName))
                    {
                        <p class="english-name">@fig.EnglishName</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(fig.OtherNames))
                    {
                        <p class="other-names">a.k.a. @fig.OtherNames</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(fig.Tagline) && showTagline)
                    {
                        <p class="figure-tagline">@fig.Tagline</p>
                    }
                </div>
                <div class="detail-header-aside">
                    <div class="detail-figure-emblem @GetStrengthCssClass(fig.HouseStrength)" aria-label="@($"{fig.Name} figure configuration")">
                        <FigureContainer Figure="@fig"
                                         IsInteractive="false"
                                         ShowFigureName="false"
                                         ShowHouseStrength="false" />
                    </div>
                    <div class="detail-header-strength @GetStrengthCssClass(fig.HouseStrength)">@strengthLabel</div>
                </div>
            </header>

            <div class="chip-row compact-chips">
                @if (!string.IsNullOrWhiteSpace(fig.Planet))
                {
                    <span class="chip chip-planet">
                        <span class="chip-glyph">@planetSymbol</span>
                        <span class="chip-text">@fig.Planet</span>
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(fig.Sign))
                {
                    <span class="chip chip-sign">
                        <span class="chip-glyph">@zodiacSymbol</span>
                        <span class="chip-text">@fig.Sign</span>
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(fig.Quality))
                {
                    <span class="chip @qualityChipClass">@fig.Quality</span>
                }
                @if (!string.IsNullOrWhiteSpace(fig.Keyword))
                {
                    <span class="chip chip-keyword">"@fig.Keyword"</span>
                }
                @if (!string.IsNullOrWhiteSpace(fig.Humor))
                {
                    <span class="chip chip-humor" title="Traditional humor">@fig.Humor</span>
                }
            </div>
        </div>

        <nav class="section-jump-nav detail-sticky-tabs" aria-label="Figure detail sections">
                <button type="button" class="jump-chip @JumpClass("section-context")" aria-current="@JumpAria("section-context")" @onclick='() => ScrollToSection("section-context")'>Context</button>
                <button type="button" class="jump-chip @JumpClass("section-verdict")" aria-current="@JumpAria("section-verdict")" @onclick='() => ScrollToSection("section-verdict")'>Verdict</button>
                @if (showInterpretation)
                {
                    <button type="button" class="jump-chip @JumpClass("section-interpretation")" aria-current="@JumpAria("section-interpretation")" @onclick='() => ScrollToSection("section-interpretation")'>Interpretation</button>
                }
                <button type="button" class="jump-chip jump-chip-short @JumpClass("section-correspondences")" aria-current="@JumpAria("section-correspondences")" @onclick='() => ScrollToSection("section-correspondences")'>Elements</button>
                @if (showHouse)
                {
                    <button type="button" class="jump-chip @JumpClass("section-house")" aria-current="@JumpAria("section-house")" @onclick='() => ScrollToSection("section-house")'>House</button>
                }
                @if (showCourt)
                {
                    <button type="button" class="jump-chip @JumpClass("section-court")" aria-current="@JumpAria("section-court")" @onclick='() => ScrollToSection("section-court")'>Court</button>
                }
                @if (showSources)
                {
                    <button type="button" class="jump-chip @JumpClass("section-sources")" aria-current="@JumpAria("section-sources")" @onclick='() => ScrollToSection("section-sources")'>Sources</button>
                }
        </nav>

        <section id="section-context" class="detail-card detail-card-primary">
            <h3 class="card-title">Immediate Context</h3>
            @if (showCriticalContext)
            {
                <div class="critical-context-block" role="status">
                    <p class="critical-context-eyebrow">Critical Context · Greer (2009)</p>
                    @foreach (var flag in criticalFlags)
                    {
                        <div class="critical-context-flag">
                            <h4 class="critical-context-title">@flag.Title</h4>
                            <p class="prose-text">@flag.Message</p>
                            @if (flag.IncludeDestroyChartNote)
                            {
                                <p class="critical-context-action prose-text">@GreerCriticalContextHelper.DestroyChartNote</p>
                            }
                        </div>
                    }
                    <p class="critical-context-soft prose-text">@GreerCriticalContextHelper.SoftGuidanceNote</p>
                </div>
            }
            @if (inSlot != null)
            {
                <div class="in-slot-card">
                    <p class="in-slot-eyebrow">@inSlot.Eyebrow</p>
                    <h4 class="in-slot-title">@inSlot.Title</h4>
                    <p class="in-slot-body prose-text">@inSlot.Body</p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(fig.DivinatoryMeaning))
            {
                <div class="context-block divinatory-hero @(inSlot == null ? "is-lead" : "")">
                    <h4 class="prose-heading">Divinatory Meaning</h4>
                    <p class="prose-text divinatory-text">@fig.DivinatoryMeaning</p>
                </div>
            }
            @if (showGreerAlongside && !string.IsNullOrWhiteSpace(greerRef?.DivinatoryMeaning))
            {
                <div class="greer-reference-block">
                    <p class="greer-reference-eyebrow">Greer (2009) · Divinatory Meaning</p>
                    <p class="prose-text">@greerRef!.DivinatoryMeaning</p>
                </div>
            }
            @if (!hideGeofancyOnly && fig.CoreMeaning?.Any() == true)
            {
                <div class="context-block">
                    <h4 class="prose-heading">Core Meaning</h4>
                    <div class="pill-row">
                        @foreach (var tag in fig.CoreMeaning)
                        {
                            <span class="meaning-pill">@tag</span>
                        }
                    </div>
                </div>
            }
            @if (!hasContext)
            {
                <p class="mini-empty">No contextual reading data for this slot.</p>
            }
        </section>

        @if (showVerdict)
        {
        <section id="section-verdict" class="detail-card">
            <h3 class="card-title">Reading Verdict</h3>
            <div class="verdict-grid">
                <div class="verdict-col is-favorable fav-card">
                    <h4>Favorable</h4>
                    @if (fig.FavorableFor?.Any() == true)
                    {
                        <ul class="bullet-list compact bullet-favorable">
                            @foreach (var x in fig.FavorableFor) { <li>@x</li> }
                        </ul>
                    }
                    else
                    {
                        <p class="mini-empty">No entries.</p>
                    }
                </div>
                <div class="verdict-col is-unfavorable unfav-card">
                    <h4>Unfavorable</h4>
                    @if (fig.UnfavorableFor?.Any() == true)
                    {
                        <ul class="bullet-list compact bullet-unfavorable">
                            @foreach (var x in fig.UnfavorableFor) { <li>@x</li> }
                        </ul>
                    }
                    else
                    {
                        <p class="mini-empty">No entries.</p>
                    }
                </div>
            </div>
        </section>
        }

        @if (showInterpretation)
        {
            <section id="section-interpretation" class="detail-card">
                <details open="@openInterpretation">
                    <summary class="details-summary">Interpretation &amp; Imagery</summary>
                    <div class="details-body">
                        @if (!string.IsNullOrWhiteSpace(fig.Imagery) || fig.TraditionalImagery?.Any() == true)
                        {
                            <div class="context-block imagery-card">
                                <h4 class="prose-heading">Imagery</h4>
                                @if (!string.IsNullOrWhiteSpace(fig.Imagery))
                                {
                                    <p class="imagery-primary prose-text">@fig.Imagery</p>
                                }
                                @if (fig.TraditionalImagery?.Any() == true)
                                {
                                    <ul class="bullet-list compact imagery-bullets">
                                        @foreach (var im in fig.TraditionalImagery) { <li>@im</li> }
                                    </ul>
                                }
                            </div>
                        }
                        @if (showGreerAlongside && !string.IsNullOrWhiteSpace(greerRef?.Imagery))
                        {
                            <div class="greer-reference-block">
                                <p class="greer-reference-eyebrow">Greer (2009) · Imagery</p>
                                <p class="prose-text">@greerRef!.Imagery</p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(fig.ElementalSynthesis))
                        {
                            <div class="context-block prose-card">
                                <h4 class="prose-heading">Elemental Synthesis</h4>
                                <p class="prose-text">@fig.ElementalSynthesis</p>
                            </div>
                        }
                        @if (fig.Interpretation?.Any() == true)
                        {
                            <div class="context-block corpus-interpretation">
                                <h4 class="prose-heading">Structured Interpretation</h4>
                                @foreach (var para in fig.Interpretation)
                                {
                                    <p class="prose-text interpretation-para">@para</p>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(fig.Commentary))
                        {
                            <div class="context-block prose-card">
                                <h4 class="prose-heading">Commentary</h4>
                                <p class="prose-text">@fig.Commentary</p>
                            </div>
                        }
                        @if (showGreerAlongside && !string.IsNullOrWhiteSpace(greerRef?.Commentary))
                        {
                            <div class="greer-reference-block">
                                <p class="greer-reference-eyebrow">Greer (2009) · Commentary</p>
                                <p class="prose-text">@greerRef!.Commentary</p>
                            </div>
                        }
                        @if (fig.ModernExamples?.Any() == true)
                        {
                            <div class="context-block callout-block">
                                <h4 class="prose-heading">Modern Examples</h4>
                                <ul class="bullet-list compact callout-list">
                                    @foreach (var ex in fig.ModernExamples) { <li>@ex</li> }
                                </ul>
                            </div>
                        }
                    </div>
                </details>
            </section>
        }

        <section id="section-correspondences" class="detail-card">
            <details open="@openCorrespondences">
                <summary class="details-summary">Body, Elements &amp; Correspondences</summary>
                <div class="details-body">
                    <div class="elements-card">
                        <h4 class="prose-heading">Elemental Composition</h4>
                        <div class="elements-grid">
                            @foreach (var el in BuildElements(fig))
                            {
                                <div class="element-badge @el.CssClass @(el.IsActive ? "is-active" : "is-dormant")">
                                    <div class="element-glyph">@el.Symbol</div>
                                    <div class="element-label">@el.Name</div>
                                    <div class="element-value">@el.Value</div>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(fig.InnerEl) || !string.IsNullOrWhiteSpace(fig.OuterEl) || !string.IsNullOrWhiteSpace(fig.ElementalPattern))
                        {
                            <div class="inner-outer-row">
                                @if (!string.IsNullOrWhiteSpace(fig.InnerEl))
                                {
                                    <span class="io-pill">
                                        <span class="io-label">Inner</span>
                                        <span class="io-glyph @GetElementCssClass(fig.InnerEl)">@GetElementSymbol(fig.InnerEl)</span>
                                        <span class="io-value">@fig.InnerEl</span>
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(fig.OuterEl))
                                {
                                    <span class="io-pill">
                                        <span class="io-label">Outer</span>
                                        <span class="io-glyph @GetElementCssClass(fig.OuterEl)">@GetElementSymbol(fig.OuterEl)</span>
                                        <span class="io-value">@fig.OuterEl</span>
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(fig.ElementalPattern))
                                {
                                    <span class="io-pill io-pill-pattern">
                                        <span class="io-label">Pattern</span>
                                        <span class="io-value">@fig.ElementalPattern</span>
                                    </span>
                                }
                            </div>
                        }
                        @if (showGreerAlongside && greerRef != null
                             && (!string.IsNullOrWhiteSpace(greerRef.InnerEl) || !string.IsNullOrWhiteSpace(greerRef.OuterEl)))
                        {
                            <div class="greer-reference-block">
                                <p class="greer-reference-eyebrow">Greer (2009) · Inner / Outer</p>
                                <div class="inner-outer-row">
                                    @if (!string.IsNullOrWhiteSpace(greerRef.InnerEl))
                                    {
                                        <span class="io-pill">
                                            <span class="io-label">Inner</span>
                                            <span class="io-glyph @GetElementCssClass(greerRef.InnerEl)">@GetElementSymbol(greerRef.InnerEl)</span>
                                            <span class="io-value">@greerRef.InnerEl</span>
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(greerRef.OuterEl))
                                    {
                                        <span class="io-pill">
                                            <span class="io-label">Outer</span>
                                            <span class="io-glyph @GetElementCssClass(greerRef.OuterEl)">@GetElementSymbol(greerRef.OuterEl)</span>
                                            <span class="io-value">@greerRef.OuterEl</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (showPerson)
                    {
                        <div class="person-card">
                            <h4 class="prose-heading">Person &amp; Body</h4>
                            @if (!string.IsNullOrWhiteSpace(fig.BodyType))
                            {
                                <div class="person-row">
                                    <p class="person-label">Body</p>
                                    <p class="prose-text person-body">@fig.BodyType</p>
                                </div>
                            }
                            @if (showGreerAlongside && !string.IsNullOrWhiteSpace(greerRef?.BodyType))
                            {
                                <div class="greer-reference-block">
                                    <p class="greer-reference-eyebrow">Greer (2009) · Body</p>
                                    <p class="prose-text">@greerRef!.BodyType</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(fig.TraditionalBodyType))
                            {
                                <div class="person-row">
                                    <p class="person-label">Body (Trad.)</p>
                                    <p class="prose-text person-body">@fig.TraditionalBodyType</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(fig.CharacterType))
                            {
                                <div class="person-row">
                                    <p class="person-label">Character</p>
                                    <p class="prose-text person-body">@fig.CharacterType</p>
                                </div>
                            }
                            @if (showGreerAlongside && !string.IsNullOrWhiteSpace(greerRef?.CharacterType))
                            {
                                <div class="greer-reference-block">
                                    <p class="greer-reference-eyebrow">Greer (2009) · Character</p>
                                    <p class="prose-text">@greerRef!.CharacterType</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(fig.TraditionalCharacterType))
                            {
                                <div class="person-row">
                                    <p class="person-label">Character (Trad.)</p>
                                    <p class="prose-text person-body">@fig.TraditionalCharacterType</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(fig.Anatomy) || !string.IsNullOrWhiteSpace(fig.Colors))
                            {
                                <div class="person-meta-row">
                                    @if (!string.IsNullOrWhiteSpace(fig.Anatomy))
                                    {
                                        <span class="person-meta">
                                            <span class="person-meta-label">Anatomy</span>
                                            <span class="person-meta-value">@fig.Anatomy</span>
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fig.Colors))
                                    {
                                        <span class="person-meta">
                                            <span class="person-meta-label">Colors</span>
                                            <span class="person-meta-value">@fig.Colors</span>
                                        </span>
                                    }
                                </div>
                            }
                            @if (showGreerAlongside && (!string.IsNullOrWhiteSpace(greerRef?.Anatomy) || !string.IsNullOrWhiteSpace(greerRef?.Colors)))
                            {
                                <div class="greer-reference-block">
                                    <p class="greer-reference-eyebrow">Greer (2009) · Person Details</p>
                                    <div class="person-meta-row">
                                        @if (!string.IsNullOrWhiteSpace(greerRef!.Anatomy))
                                        {
                                            <span class="person-meta">
                                                <span class="person-meta-label">Anatomy</span>
                                                <span class="person-meta-value">@greerRef.Anatomy</span>
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(greerRef.Colors))
                                        {
                                            <span class="person-meta">
                                                <span class="person-meta-label">Colors</span>
                                                <span class="person-meta-value">@greerRef.Colors</span>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (showHouseAffinity)
                    {
                        <div class="house-affinity-card">
                            <h4 class="prose-heading">House Affinity</h4>
                            <div class="affinity-row">
                                @if (!string.IsNullOrWhiteSpace(fig.StrongHouse))
                                {
                                    <div class="affinity-pill affinity-strong">
                                        <span class="affinity-glyph">▲</span>
                                        <span class="affinity-label">Strong</span>
                                        <span class="affinity-value">@fig.StrongHouse</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(fig.StrongHouse) && !string.IsNullOrWhiteSpace(fig.WeakHouse))
                                {
                                    <span class="affinity-vs">vs.</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(fig.WeakHouse))
                                {
                                    <div class="affinity-pill affinity-weak">
                                        <span class="affinity-glyph">▼</span>
                                        <span class="affinity-label">Weak</span>
                                        <span class="affinity-value">@fig.WeakHouse</span>
                                    </div>
                                }
                            </div>
                            @if (showGreerAlongside && greerRef != null
                                 && (!string.IsNullOrWhiteSpace(greerRef.StrongHouse) || !string.IsNullOrWhiteSpace(greerRef.WeakHouse)))
                            {
                                <div class="greer-reference-block">
                                    <p class="greer-reference-eyebrow">Greer (2009) · House Affinity</p>
                                    <div class="affinity-row">
                                        @if (!string.IsNullOrWhiteSpace(greerRef.StrongHouse))
                                        {
                                            <div class="affinity-pill affinity-strong">
                                                <span class="affinity-glyph">▲</span>
                                                <span class="affinity-label">Strong</span>
                                                <span class="affinity-value">@greerRef.StrongHouse</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(greerRef.StrongHouse) && !string.IsNullOrWhiteSpace(greerRef.WeakHouse))
                                        {
                                            <span class="affinity-vs">vs.</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(greerRef.WeakHouse))
                                        {
                                            <div class="affinity-pill affinity-weak">
                                                <span class="affinity-glyph">▼</span>
                                                <span class="affinity-label">Weak</span>
                                                <span class="affinity-value">@greerRef.WeakHouse</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (HasPlanetaryContent(fig))
                    {
                        <div class="correspondence-meta-block">
                            <h4 class="prose-heading">Planetary Correspondences</h4>
                            <div class="correspondence-meta-row">
                                @if (!string.IsNullOrWhiteSpace(fig.PlanetaryIntelligence))
                                {
                                    <span class="correspondence-meta">
                                        <span class="correspondence-meta-label">Intelligence</span>
                                        <span class="correspondence-meta-value">@fig.PlanetaryIntelligence</span>
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(fig.PlanetarySpirit))
                                {
                                    <span class="correspondence-meta">
                                        <span class="correspondence-meta-label">Spirit</span>
                                        <span class="correspondence-meta-value">@fig.PlanetarySpirit</span>
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(fig.PlanetaryAngel))
                                {
                                    <span class="correspondence-meta">
                                        <span class="correspondence-meta-label">Angel</span>
                                        <span class="correspondence-meta-value">@fig.PlanetaryAngel</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </details>
        </section>


        @if (showHouse)
        {
            <section id="section-house" class="detail-card reference-section">
                <details open="@openHouse">
                    <summary class="details-summary">House · @(houseEntry?.House ?? greerHouse?.Ordinal ?? "Reference")</summary>
                    <div class="details-body reference-stack">
                        @if (showGreerHousePrimary)
                        {
                            <p class="reference-section-eyebrow">Greer House Reference · @greerHouse!.Ordinal</p>
                            @if (houseBundle.Governs?.Any() == true)
                            {
                                <div class="reference-subcard detail-card governs-card">
                                    <h3 class="card-title">What it Governs</h3>
                                    <ul class="bullet-list two-col-bullets">
                                        @foreach (var g in houseBundle.Governs) { <li>@g</li> }
                                    </ul>
                                </div>
                            }
                            @if (houseBundle.QuestionInvolves?.Any() == true)
                            {
                                <div class="reference-subcard detail-card prose-card">
                                    <h3 class="card-title">Question Involves</h3>
                                    <ul class="bullet-list">
                                        @foreach (var q in houseBundle.QuestionInvolves) { <li>@q</li> }
                                    </ul>
                                </div>
                            }
