@using GeomancyWebUI.Client.Models
@using GeomancyWebUI.Client.Helpers
@using System.Linq

@*
    Reusable chart surface that renders the shield chart, the traditional 12-house
    chart, or both. Owns no chart state - the parent passes the HouseChartModel
    plus the four interactive Mother figures and gets EventCallbacks back when
    a Mother is mutated. Visual styles live in wwwroot/chart-surface.css so this
    component does not need a scoped .razor.css.
*@

<div class="charts-side-by-side @GetTutorialRootClass()">
    @if (View == ChartSurfaceView.Both || View == ChartSurfaceView.Shield)
    {
        <div class="shield-chart-container @GetShieldContainerClass()">
            @if (ShowTriplicates)
            {
                <div class="triplicate-overlay triplicate-1">
                    <div class="triplicate-top"><div class="triplicate-cell"></div><div class="triplicate-cell"></div></div>
                    <div class="triplicate-bottom"><div class="triplicate-cell"></div></div>
                </div>
                <div class="triplicate-overlay triplicate-2">
                    <div class="triplicate-top"><div class="triplicate-cell"></div><div class="triplicate-cell"></div></div>
                    <div class="triplicate-bottom"><div class="triplicate-cell"></div></div>
                </div>
                <div class="triplicate-overlay triplicate-3">
                    <div class="triplicate-top"><div class="triplicate-cell"></div><div class="triplicate-cell"></div></div>
                    <div class="triplicate-bottom"><div class="triplicate-cell"></div></div>
                </div>
                <div class="triplicate-overlay triplicate-4">
                    <div class="triplicate-top"><div class="triplicate-cell"></div><div class="triplicate-cell"></div></div>
                    <div class="triplicate-bottom"><div class="triplicate-cell"></div></div>
                </div>
            }

            @if (ShowRow1)
            {
                <div class="row mb-3 row-1 @GetRow1FocusClass()">
                    @if (ShowSectionLabels)
                    {
                        <div class="section-label-overlay section-label-mothers">Mothers</div>
                        <div class="section-label-overlay section-label-daughters">Daughters</div>
                    }
                    @ShieldHouseSlot(8, "col", "section-daughters", isMother: false)
                    @ShieldHouseSlot(7, "col", "section-daughters", isMother: false)
                    @ShieldHouseSlot(6, "col", "section-daughters", isMother: false)
                    @ShieldHouseSlot(5, "col", "section-daughters", isMother: false)
                    @ShieldHouseSlot(4, "col", "section-mothers", isMother: true)
                    @ShieldHouseSlot(3, "col", "section-mothers", isMother: true)
                    @ShieldHouseSlot(2, "col", "section-mothers", isMother: true)
                    @ShieldHouseSlot(1, "col", "section-mothers", isMother: true)
                </div>
            }

            @if (ShowNiecesRow)
            {
                <div class="row mb-3 row-2 @GetNiecesRowFocusClass()">
                    @if (ShowSectionLabels)
                    {
                        <div class="section-label-overlay section-label-nieces">Nieces</div>
                    }
                    @ShieldHouseSlot(12, "col-3", "section-nieces", isMother: false)
                    @ShieldHouseSlot(11, "col-3", "section-nieces", isMother: false)
                    @ShieldHouseSlot(10, "col-3", "section-nieces", isMother: false)
                    @ShieldHouseSlot(9, "col-3", "section-nieces", isMother: false)
                </div>
            }

            @if (ShowCourtRows)
            {
                <div class="row mb-3 section-court @GetCourtRowFocusClass()">
                    @if (ShowSectionLabels)
                    {
                        <div class="section-label-overlay section-label-court">Court</div>
                    }
                    <div class="col-6 text-center @GetCourtHighlightClass(ChartHighlightCourt.LeftWitness) @GetCourtLineSourceClass(ChartHighlightCourt.LeftWitness)" data-court="left-witness">
                        @RenderCourtSlot(ChartHighlightCourt.LeftWitness, ShouldShowCourtFigure(Chart?.LeftWitness), Chart?.LeftWitness, "Left Wit")
                    </div>
                    <div class="col-6 text-center @GetCourtHighlightClass(ChartHighlightCourt.RightWitness) @GetCourtLineSourceClass(ChartHighlightCourt.RightWitness)" data-court="right-witness">
                        @RenderCourtSlot(ChartHighlightCourt.RightWitness, ShouldShowCourtFigure(Chart?.RightWitness), Chart?.RightWitness, "Right Wit")
                    </div>
                </div>

                <div class="row section-court @GetCourtRowFocusClass()">
                    <div class="col-4 chart-empty-cell" aria-hidden="true"></div>
                    <div class="col-4 text-center @GetCourtHighlightClass(ChartHighlightCourt.Judge) @GetCourtLineSourceClass(ChartHighlightCourt.Judge)" data-court="judge">
                        @RenderCourtSlot(ChartHighlightCourt.Judge, ShouldShowCourtFigure(Chart?.Judge), Chart?.Judge, "Judge")
                    </div>
                    <div class="col-4 text-center @GetCourtHighlightClass(ChartHighlightCourt.Sentence) @GetCourtLineSourceClass(ChartHighlightCourt.Sentence)" data-court="sentence">
                        @RenderCourtSlot(ChartHighlightCourt.Sentence, ShouldShowCourtFigure(Chart?.Sentence), Chart?.Sentence, "Fallout")
                    </div>
                </div>
            }
        </div>
    }

    @if (View == ChartSurfaceView.Both || View == ChartSurfaceView.House)
    {
        <div class="traditional-house-chart-container">
            <svg class="house-chart-svg" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
                <rect x="0" y="0" width="1000" height="1000" fill="none" stroke="#333" stroke-width="2" />
                <polygon points="500,0 1000,500 500,1000 0,500" fill="none" stroke="#333" stroke-width="1" />
                <rect x="250" y="250" width="500" height="500" fill="none" stroke="#333" stroke-width="1" />
                <line x1="0" y1="0" x2="250" y2="250" stroke="#333" stroke-width="1" />
                <line x1="1000" y1="0" x2="750" y2="250" stroke="#333" stroke-width="1" />
                <line x1="1000" y1="1000" x2="750" y2="750" stroke="#333" stroke-width="1" />
                <line x1="0" y1="1000" x2="250" y2="750" stroke="#333" stroke-width="1" />

                @if (GetParticipatingHouses() is { Count: > 0 } participating)
                {
                    <g class="house-participation-fills" pointer-events="none">
                        @foreach (var h in participating)
                        {
                            @if (HouseChartGeometry.TryGetHouseFillPoints(h, out var fL, out var fR, out var fO))
                            {
                                var fillClass = GetHouseFillClass(h);
                                <polygon points="@($"{fL.X:0.##},{fL.Y:0.##} {fR.X:0.##},{fR.Y:0.##} {fO.X:0.##},{fO.Y:0.##}")"
                                         class="house-participation-fill @fillClass" />
                            }
                        }
                    </g>
                }

                @if (RelationshipOverlay?.Links is { Count: > 0 })
                {
                    <g class="house-chart-overlays" pointer-events="none">
                        <defs>
                            <marker id="aspect-arrow-end" viewBox="0 0 10 10" refX="9" refY="5"
                                    markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                                <path d="M 0 0 L 10 5 L 0 10 z" fill="#42a5f5" />
                            </marker>
                        </defs>
                        @foreach (var link in RelationshipOverlay.Links)
                        {
                            @if (HouseChartGeometry.TryGetNumberAnchor(link.FromHouse, out var from)
                                 && HouseChartGeometry.TryGetNumberAnchor(link.ToHouse, out var to))
                            {
                                var css = LinkCssClass(link);
                                // Endpoints snap to house numbers — light pull keeps arcs in the open center.
                                var pull = link.Kind == "company-pair" ? 0.12 : 0.32;
                                var path = HouseChartGeometry.ArcPath(from, to, pull);
                                var labelAt = HouseChartGeometry.LabelPoint(from, to, pull, link.Kind == "company-pair" ? 0.06 : 0.10);
                                var useArrow = link.Kind == "aspect"
                                    && !string.Equals(link.AspectType, "Opposition", StringComparison.OrdinalIgnoreCase);
                                var midCount = link.Kind == "aspect" ? (link.IntermediateHouses?.Count ?? 0) : 0;
                                <g class="house-chart-link-group">
                                    <path d="@path"
                                          class="house-chart-link @css"
                                          marker-end="@(useArrow ? "url(#aspect-arrow-end)" : null)">
                                        @if (!string.IsNullOrEmpty(link.Description))
                                        {
                                            <title>@link.Description</title>
                                        }
                                    </path>
                                    @if (midCount > 0)
                                    {
                                        @for (var ti = 0; ti < midCount; ti++)
                                        {
                                            var t = (ti + 1) / (double)(midCount + 1);
                                            var tick = HouseChartGeometry.PointOnArc(from, to, t, pull);
                                            <circle cx="@tick.X.ToString("0.##")"
                                                    cy="@tick.Y.ToString("0.##")"
                                                    r="4.5"
                                                    class="house-chart-intermediate @css" />
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(link.Label))
                                    {
                                        var titleXml = string.IsNullOrEmpty(link.Description)
                                            ? string.Empty
                                            : $"<title>{System.Net.WebUtility.HtmlEncode(link.Description)}</title>";
                                        @((MarkupString)$"<text x=\"{labelAt.X:0.##}\" y=\"{labelAt.Y:0.##}\" class=\"house-chart-link-label {css}\" text-anchor=\"middle\" dominant-baseline=\"middle\">{titleXml}{System.Net.WebUtility.HtmlEncode(link.Label)}</text>")
                                    }
                                </g>
                            }
                        }
                    </g>
                }

                <foreignObject x="500" y="200" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(10)">
                        <FigureContainer Figure="@GetHouseFigure(10)" IsInteractive="false" ShowFigureName="true" />
                    </div></div>
                </foreignObject>
                <foreignObject x="150" y="550" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(1)">
                        <FigureContainer Figure="@House1Figure" IsInteractive="@InteractiveMothers" ShowFigureName="true" OnFigureChanged="OnHouse1Changed" />
                    </div></div>
                </foreignObject>
                <foreignObject x="850" y="550" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(7)">
                        <FigureContainer Figure="@GetHouseFigure(7)" IsInteractive="false" ShowFigureName="true" />
                    </div></div>
                </foreignObject>
                <foreignObject x="500" y="900" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(4)">
                        <FigureContainer Figure="@House4Figure" IsInteractive="@InteractiveMothers" ShowFigureName="true" OnFigureChanged="OnHouse4Changed" />
                    </div></div>
                </foreignObject>
                <foreignObject x="250" y="150" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(11)">
                        <FigureContainer Figure="@GetHouseFigure(11)" IsInteractive="false" ShowFigureName="true" />
                    </div></div>
                </foreignObject>
                <foreignObject x="100" y="300" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(12)">
                        <FigureContainer Figure="@GetHouseFigure(12)" IsInteractive="false" ShowFigureName="true" />
                    </div></div>
                </foreignObject>
                <foreignObject x="750" y="150" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(9)">
                        <FigureContainer Figure="@GetHouseFigure(9)" IsInteractive="false" ShowFigureName="true" />
                    </div></div>
                </foreignObject>
                <foreignObject x="920" y="286" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(8)">
                        <FigureContainer Figure="@GetHouseFigure(8)" IsInteractive="false" ShowFigureName="true" />
                    </div></div>
                </foreignObject>
                <foreignObject x="920" y="814" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(6)">
                        <FigureContainer Figure="@GetHouseFigure(6)" IsInteractive="false" ShowFigureName="true" />
                    </div></div>
                </foreignObject>
                <foreignObject x="750" y="935" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(5)">
                        <FigureContainer Figure="@GetHouseFigure(5)" IsInteractive="false" ShowFigureName="true" />
                    </div></div>
                </foreignObject>
                <foreignObject x="80" y="814" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(2)">
                        <FigureContainer Figure="@House2Figure" IsInteractive="@InteractiveMothers" ShowFigureName="true" OnFigureChanged="OnHouse2Changed" />
                    </div></div>
                </foreignObject>
                <foreignObject x="250" y="935" width="1" height="1">
                    <div class="house-anchor"><div class="house-card-container @GetHouseChartSlotClass(3)">
                        <FigureContainer Figure="@House3Figure" IsInteractive="@InteractiveMothers" ShowFigureName="true" OnFigureChanged="OnHouse3Changed" />
                    </div></div>
                </foreignObject>

                @* House numbers — overlay arcs snap to these same seats. *@
                <g class="house-numbers" pointer-events="none">
                    @for (var h = 1; h <= 12; h++)
                    {
                        @if (HouseChartGeometry.TryGetNumberAnchor(h, out var numAt))
                        {
                            var roleClass = GetHouseNumberRoleClass(h);
                            @((MarkupString)$"<text x=\"{numAt.X:0.##}\" y=\"{numAt.Y:0.##}\" class=\"house-number{roleClass}\" text-anchor=\"middle\" dominant-baseline=\"middle\">{h}</text>")
                        }
                    }
                </g>

                @if (RelationshipOverlay != null)
                {
                    <g class="house-role-tags" pointer-events="none">
                        @if (RelationshipOverlay.QuerentHouse is >= 1 and <= 12
                            && HouseChartGeometry.TryGetRoleTagPoint(RelationshipOverlay.QuerentHouse, out var qTag))
                        {
                            @((MarkupString)$"<text x=\"{qTag.X:0.##}\" y=\"{qTag.Y:0.##}\" class=\"house-role-tag house-role-tag-querent\" text-anchor=\"middle\" dominant-baseline=\"middle\">Querent</text>")
                        }
                        @if (RelationshipOverlay.QuesitedHouse is >= 1 and <= 12
                            && RelationshipOverlay.QuesitedHouse != RelationshipOverlay.QuerentHouse
                            && HouseChartGeometry.TryGetRoleTagPoint(RelationshipOverlay.QuesitedHouse, out var xTag))
                        {
                            @((MarkupString)$"<text x=\"{xTag.X:0.##}\" y=\"{xTag.Y:0.##}\" class=\"house-role-tag house-role-tag-quesited\" text-anchor=\"middle\" dominant-baseline=\"middle\">Quesited</text>")
                        }
                    </g>
                }
            </svg>
        </div>
    }
</div>

@code {
    [Parameter] public HouseChartModel? Chart { get; set; }
    [Parameter] public FigureModel? House1Figure { get; set; }
    [Parameter] public FigureModel? House2Figure { get; set; }
    [Parameter] public FigureModel? House3Figure { get; set; }
    [Parameter] public FigureModel? House4Figure { get; set; }

    [Parameter] public EventCallback<FigureModel> OnHouse1Changed { get; set; }
    [Parameter] public EventCallback<FigureModel> OnHouse2Changed { get; set; }
    [Parameter] public EventCallback<FigureModel> OnHouse3Changed { get; set; }
    [Parameter] public EventCallback<FigureModel> OnHouse4Changed { get; set; }

    [Parameter] public ChartSurfaceView View { get; set; } = ChartSurfaceView.Both;
    [Parameter] public bool ShowSectionLabels { get; set; } = false;
    [Parameter] public bool ShowTriplicates { get; set; } = false;
    [Parameter] public ShieldRowVisibility ShieldRowVisibility { get; set; } = ShieldRowVisibility.All;
    [Parameter] public ShieldSectionFocus SectionFocus { get; set; } = ShieldSectionFocus.Full;
    [Parameter] public bool ShowEmptyDerivedSlots { get; set; } = false;
    [Parameter] public bool LayoutOnly { get; set; }
    [Parameter] public bool InteractiveMothers { get; set; } = true;
    [Parameter] public bool IsWikiLayout { get; set; }
    [Parameter] public bool ShowCourtFigures { get; set; } = true;
    [Parameter] public IReadOnlySet<int>? VisibleHouseNumbers { get; set; }
    [Parameter] public IReadOnlyDictionary<int, int>? HouseHighlightedLines { get; set; }
    [Parameter] public IReadOnlyDictionary<int, int>? HouseRevealLineCounts { get; set; }
    [Parameter] public IReadOnlyDictionary<int, string>? HouseLineHighlightThemes { get; set; }
    [Parameter] public IReadOnlyDictionary<ChartHighlightCourt, int>? CourtHighlightedLines { get; set; }
    [Parameter] public IReadOnlyDictionary<ChartHighlightCourt, int>? CourtRevealLineCounts { get; set; }
    [Parameter] public IReadOnlyDictionary<ChartHighlightCourt, string>? CourtLineHighlightThemes { get; set; }
    [Parameter] public IReadOnlySet<int>? HighlightedHouseNumbers { get; set; }
    [Parameter] public IReadOnlySet<ChartHighlightCourt>? HighlightedCourt { get; set; }
    /// <summary>
    /// Selected perfection/aspect geometry drawn on the 12-house chart.
    /// </summary>
    [Parameter] public ChartRelationshipOverlay? RelationshipOverlay { get; set; }

    private bool ShowRow1 => SectionFocus is ShieldSectionFocus.Full or ShieldSectionFocus.Mothers or ShieldSectionFocus.Daughters
        || ShieldRowVisibility == ShieldRowVisibility.MothersRowOnly;

    private bool ShowNiecesRow => SectionFocus is ShieldSectionFocus.Full or ShieldSectionFocus.Nieces;

    private bool ShowCourtRows => SectionFocus is ShieldSectionFocus.Full or ShieldSectionFocus.Court;

    private RenderFragment ShieldHouseSlot(int houseNumber, string colClass, string sectionClass, bool isMother) => builder =>
    {
        var figure = GetShieldSlotFigure(houseNumber);
        var useEmpty = ShouldRenderEmptySlot(houseNumber, figure);
        var isMuted = SectionFocus != ShieldSectionFocus.Full && !IsHouseInSectionFocus(houseNumber);
        var seq = 0;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class",
            $"{colClass} text-center {sectionClass} {GetHouseHighlightClass(houseNumber)} {GetLineSourceClass(houseNumber)} {(isMuted ? "chart-slot-muted" : "")}");
        builder.AddAttribute(seq++, "data-house", houseNumber.ToString());

        if (useEmpty)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", isMuted ? "chart-slot-empty chart-slot-muted" : "chart-slot-empty");
            builder.AddAttribute(seq++, "aria-label", $"House {houseNumber}, awaiting figure");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "chart-slot-empty-label");
            builder.AddContent(seq++, houseNumber.ToString());
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            builder.OpenComponent<FigureContainer>(seq++);
            builder.AddAttribute(seq++, "Figure", figure);
            builder.AddAttribute(seq++, "Label", houseNumber.ToString());
            builder.AddAttribute(seq++, "IsInteractive", isMother && InteractiveMothers);
            builder.AddAttribute(seq++, "ShowFigureName", true);
            builder.AddAttribute(seq++, "HighlightedLineNumber", GetHighlightedLine(houseNumber));
            builder.AddAttribute(seq++, "RevealLineCount", GetRevealLineCount(houseNumber));
            builder.AddAttribute(seq++, "HighlightTheme", GetHighlightTheme(houseNumber));
            if (isMother)
            {
                builder.AddAttribute(seq++, "OnFigureChanged", GetMotherChangedCallback(houseNumber));
            }
            builder.CloseComponent();
        }

        builder.CloseElement();
    };

    private RenderFragment RenderCourtSlot(ChartHighlightCourt court, bool showFigure, FigureModel? figure, string label) => builder =>
    {
        var seq = 0;
        var courtFocused = SectionFocus is ShieldSectionFocus.Full or ShieldSectionFocus.Court;

        if (!showFigure || figure == null)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class",
                courtFocused ? "chart-slot-empty" : "chart-slot-empty chart-slot-muted");
            builder.AddAttribute(seq++, "aria-label", $"{label}, awaiting figure");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "chart-slot-empty-label");
            builder.AddContent(seq++, label);
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            builder.OpenComponent<FigureContainer>(seq++);
            builder.AddAttribute(seq++, "Figure", figure);
            builder.AddAttribute(seq++, "Label", label);
            builder.AddAttribute(seq++, "IsInteractive", false);
            builder.AddAttribute(seq++, "ShowFigureName", true);
            builder.AddAttribute(seq++, "ShowHouseStrength", false);
            builder.AddAttribute(seq++, "HighlightedLineNumber", GetCourtHighlightedLine(court));
            builder.AddAttribute(seq++, "RevealLineCount", GetCourtRevealLineCount(court));
            builder.AddAttribute(seq++, "HighlightTheme", GetCourtHighlightTheme(court));
            builder.CloseComponent();
        }
    };

    private bool ShouldShowCourtFigure(FigureModel? figure) =>
        ShowCourtFigures && !LayoutOnly && (SectionFocus is ShieldSectionFocus.Full or ShieldSectionFocus.Court);

    private bool IsHouseInSectionFocus(int houseNumber) => SectionFocus switch
    {
        ShieldSectionFocus.Mothers => houseNumber is >= 1 and <= 4,
        ShieldSectionFocus.Daughters => houseNumber is >= 5 and <= 8,
        ShieldSectionFocus.Nieces => houseNumber is >= 9 and <= 12,
        _ => true
    };

    private bool ShouldRenderEmptySlot(int houseNumber, FigureModel? figure)
    {
        if (!IsHouseVisible(houseNumber))
        {
            return true;
        }

        if (LayoutOnly)
        {
            return true;
        }

        if (SectionFocus != ShieldSectionFocus.Full && !IsHouseInSectionFocus(houseNumber))
        {
            return true;
        }

        if (figure != null)
        {
            return false;
        }

        return ShowEmptyDerivedSlots || SectionFocus != ShieldSectionFocus.Full;
    }

    private FigureModel? GetShieldSlotFigure(int houseNumber)
    {
        if (!IsHouseVisible(houseNumber))
        {
            return null;
        }

        if (LayoutOnly)
        {
            return null;
        }

        if (SectionFocus != ShieldSectionFocus.Full && !IsHouseInSectionFocus(houseNumber))
        {
            return null;
        }

        return houseNumber switch
        {
            1 => House1Figure,
            2 => House2Figure,
            3 => House3Figure,
            4 => House4Figure,
            _ => GetHouseFigure(houseNumber)
        };
    }

    private EventCallback<FigureModel> GetMotherChangedCallback(int houseNumber) => houseNumber switch
    {
        1 => OnHouse1Changed,
        2 => OnHouse2Changed,
        3 => OnHouse3Changed,
        4 => OnHouse4Changed,
        _ => default
    };

    private string GetShieldContainerClass()
    {
        var classes = new List<string>();
        if (IsWikiLayout)
        {
            classes.Add("is-wiki");
        }

        if (ShieldRowVisibility == ShieldRowVisibility.MothersRowOnly)
        {
            classes.Add("shield-chart-mothers-row-only");
        }

        if (SectionFocus != ShieldSectionFocus.Full)
        {
            classes.Add($"shield-section-focus-{SectionFocus.ToString().ToLowerInvariant()}");
        }

        return string.Join(" ", classes);
    }

    private string GetRow1FocusClass() =>
        SectionFocus is ShieldSectionFocus.Mothers or ShieldSectionFocus.Daughters
            ? "chart-row-section-active"
            : string.Empty;

    private string GetNiecesRowFocusClass() =>
        SectionFocus == ShieldSectionFocus.Nieces ? "chart-row-section-active" : string.Empty;

    private string GetCourtRowFocusClass() =>
        SectionFocus == ShieldSectionFocus.Court ? "chart-row-section-active" : string.Empty;

    private FigureModel? GetHouseFigure(int houseNumber)
    {
        if (Chart == null)
        {
            return null;
        }

        return Chart.Houses?.FirstOrDefault(h => h.HouseNumber == houseNumber)?.Figure;
    }

    private string GetTutorialRootClass()
    {
        var classes = new List<string>();
        if (SectionFocus != ShieldSectionFocus.Full || HasTutorialHighlights())
        {
            classes.Add("chart-surface-tutorial-active");
        }

        if (SectionFocus != ShieldSectionFocus.Full)
        {
            classes.Add("chart-surface-section-focus");
        }

        return string.Join(" ", classes);
    }

    private bool HasTutorialHighlights()
    {
        return (HighlightedHouseNumbers != null && HighlightedHouseNumbers.Count > 0)
            || (HighlightedCourt != null && HighlightedCourt.Count > 0);
    }

    private string GetHouseHighlightClass(int houseNumber)
    {
        if (SectionFocus != ShieldSectionFocus.Full && IsHouseInSectionFocus(houseNumber))
        {
            return "wiki-section-highlight wiki-tutorial-highlight";
        }

        if (HighlightedHouseNumbers != null && HighlightedHouseNumbers.Contains(houseNumber))
        {
            return "wiki-tutorial-highlight";
        }

        return string.Empty;
    }

    private string GetHouseChartSlotClass(int houseNumber)
    {
        var parts = new List<string>();
        if (HighlightedHouseNumbers != null && HighlightedHouseNumbers.Contains(houseNumber))
            parts.Add("house-chart-slot-highlight");

        if (RelationshipOverlay != null)
        {
            if (houseNumber == RelationshipOverlay.QuerentHouse)
                parts.Add("house-chart-slot-querent");
            if (houseNumber == RelationshipOverlay.QuesitedHouse)
                parts.Add("house-chart-slot-quesited");
            if (RelationshipOverlay.Links.Any(l =>
                    l.Kind == "aspect" && (l.FromHouse == houseNumber || l.ToHouse == houseNumber)))
                parts.Add("house-chart-slot-cast");
            if (RelationshipOverlay.Links.Any(l =>
                    l.Kind == "company-pair" && (l.FromHouse == houseNumber || l.ToHouse == houseNumber)))
                parts.Add("house-chart-slot-company");
        }

        return string.Join(' ', parts);
    }

    private string GetHouseNumberRoleClass(int houseNumber)
    {
        if (RelationshipOverlay == null) return string.Empty;
        if (houseNumber == RelationshipOverlay.QuerentHouse) return " house-number-querent";
        if (houseNumber == RelationshipOverlay.QuesitedHouse) return " house-number-quesited";
        return string.Empty;
    }

    private HashSet<int> GetParticipatingHouses()
    {
        var set = new HashSet<int>();
        if (HighlightedHouseNumbers != null)
        {
            foreach (var h in HighlightedHouseNumbers)
                set.Add(h);
        }

        if (RelationshipOverlay != null)
        {
            foreach (var h in ChartRelationshipOverlayBuilder.HighlightHouses(RelationshipOverlay))
                set.Add(h);
        }

        return set;
    }

    private string GetHouseFillClass(int houseNumber)
    {
        if (RelationshipOverlay != null)
        {
            if (houseNumber == RelationshipOverlay.QuerentHouse)
                return "is-querent";
            if (houseNumber == RelationshipOverlay.QuesitedHouse)
                return "is-quesited";
            if (RelationshipOverlay.Links.Any(l =>
                    l.Kind == "company-pair" && (l.FromHouse == houseNumber || l.ToHouse == houseNumber)))
                return "is-company";
        }

        return "is-participant";
    }

    private static string LinkCssClass(ChartAspectLink link)
    {
        if (string.Equals(link.Kind, "company-pair", StringComparison.OrdinalIgnoreCase))
            return "link-company";
        if (string.Equals(link.Kind, "path", StringComparison.OrdinalIgnoreCase))
            return "link-path";

        var aspect = AspectDirectionHelper.AspectTypeClass(link.AspectType);
        var dir = AspectDirectionHelper.Resolve(link.Direction, link.AspectType).CssClass;
        return $"{aspect} {dir}".Trim();
    }

    private string GetCourtHighlightClass(ChartHighlightCourt court)
    {
        if (SectionFocus == ShieldSectionFocus.Court)
        {
            return "wiki-section-highlight wiki-tutorial-highlight";
        }

        if (HighlightedCourt != null && HighlightedCourt.Contains(court))
        {
            return "wiki-tutorial-highlight";
        }

        return string.Empty;
    }

    private bool IsHouseVisible(int houseNumber)
    {
        if (VisibleHouseNumbers == null || VisibleHouseNumbers.Count == 0)
        {
            return true;
        }

        return VisibleHouseNumbers.Contains(houseNumber);
    }

