@using GeomancyWebUI.Client.Components
@using GeomancyWebUI.Client.Helpers
@using GeomancyWebUI.Client.Models

<div class="wiki-figure-data-panel @(Figure == null ? "is-empty" : "is-populated")" aria-live="polite">
    @if (Figure == null)
    {
        <p class="wiki-figure-data-panel-empty">
            Mark dots and tap <strong>Generate figure</strong> to load this figure's corpus entry.
        </p>
    }
    else
    {
        var fig = Figure;
        var slug = WikiFigureSlug.ToSlug(fig.Name);
        var planetSymbol = FigureDisplayHelper.GetPlanetSymbol(fig.Planet);
        var zodiacSymbol = FigureDisplayHelper.GetZodiacSymbol(fig.Sign);
        var qualityChipClass = FigureDisplayHelper.GetQualityChipClass(fig.Quality);
        var favorablePreview = fig.FavorableFor?.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
        var unfavorablePreview = fig.UnfavorableFor?.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));

        <header class="wiki-figure-data-panel-header">
            <div class="wiki-figure-data-panel-emblem" aria-hidden="true">
                <FigureContainer Figure="@fig"
                                 Compact="true"
                                 IsInteractive="false"
                                 ShowFigureName="false"
                                 ShowHouseStrength="false" />
            </div>
            <div class="wiki-figure-data-panel-titles">
                <p class="wiki-figure-data-panel-eyebrow">Corpus entry</p>
                <h3 class="wiki-figure-data-panel-name">@fig.Name</h3>
                @if (!string.IsNullOrWhiteSpace(fig.EnglishName))
                {
                    <p class="wiki-figure-data-panel-english">@fig.EnglishName</p>
                }
                @if (!string.IsNullOrWhiteSpace(fig.Tagline))
                {
                    <p class="wiki-figure-data-panel-tagline">@fig.Tagline</p>
                }
                <p class="wiki-figure-data-panel-lines">@FigureDisplayHelper.GetLinePatternSummary(fig)</p>
            </div>
        </header>

        <div class="chip-row compact-chips wiki-figure-data-panel-chips">
            @if (!string.IsNullOrWhiteSpace(fig.Planet))
            {
                <span class="chip chip-planet">
                    <span class="chip-glyph">@planetSymbol</span>
                    <span class="chip-text">@fig.Planet</span>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(fig.Sign))
            {
                <span class="chip chip-sign">
                    <span class="chip-glyph">@zodiacSymbol</span>
                    <span class="chip-text">@fig.Sign</span>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(fig.Quality))
            {
                <span class="chip @qualityChipClass">@fig.Quality</span>
            }
            @if (!string.IsNullOrWhiteSpace(fig.Keyword))
            {
                <span class="chip chip-keyword">@fig.Keyword</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(fig.Humor))
        {
            <p class="wiki-figure-data-panel-meta">@fig.Humor</p>
        }

        @if (!string.IsNullOrWhiteSpace(fig.DivinatoryMeaning))
        {
            <div class="wiki-figure-data-panel-block">
                <h4 class="wiki-figure-data-panel-block-title">Divinatory meaning</h4>
                <p class="wiki-figure-data-panel-excerpt">@fig.DivinatoryMeaning</p>
            </div>
        }

        @if (fig.CoreMeaning?.Any() == true)
        {
            <div class="wiki-figure-data-panel-block">
                <h4 class="wiki-figure-data-panel-block-title">Core meaning</h4>
                <div class="pill-row wiki-figure-data-panel-pills">
                    @foreach (var tag in fig.CoreMeaning.Take(3))
                    {
                        <span class="meaning-pill">@tag</span>
                    }
                </div>
            </div>
        }

        @if (favorablePreview != null || unfavorablePreview != null)
        {
            <div class="wiki-figure-data-panel-verdict">
                @if (favorablePreview != null)
                {
                    <p class="wiki-figure-data-panel-verdict-line is-favorable">
                        <strong>Favorable</strong>
                        <span>@favorablePreview</span>
                    </p>
                }
                @if (unfavorablePreview != null)
                {
                    <p class="wiki-figure-data-panel-verdict-line is-unfavorable">
                        <strong>Unfavorable</strong>
                        <span>@unfavorablePreview</span>
                    </p>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(slug))
        {
            <a class="wiki-figure-data-panel-link" href="/wiki/glossary/figures/@slug">Open full figure article</a>
        }
    }
</div>

@code {
    [Parameter] public FigureModel? Figure { get; set; }
}
