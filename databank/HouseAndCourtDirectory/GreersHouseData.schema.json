{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geofancy.local/databank/HouseAndCourtDirectory/GreersHouseData.schema.json",
  "title": "Greer House Reference Directory",
  "type": "object",
  "required": ["GreerHouseData"],
  "properties": {
    "GreerHouseData": {
      "type": "object",
      "required": ["schema_version", "license", "chart_cautions", "houses"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "license": { "$ref": "#/$defs/license" },
        "chart_cautions": { "type": "string", "minLength": 1 },
        "houses": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/greer_house" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "license": {
      "type": "object",
      "required": ["work", "author", "publisher", "permission_date", "attribution", "approved_pages"],
      "properties": {
        "work": { "type": "string" },
        "author": { "type": "string" },
        "publisher": { "type": "string" },
        "permission_date": { "type": "string" },
        "attribution": { "type": "string" },
        "approved_pages": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["work", "chapter", "pages", "attribution"],
      "properties": {
        "work": { "type": "string" },
        "chapter": { "type": "string" },
        "pages": { "type": "string" },
        "attribution": { "type": "string" }
      },
      "additionalProperties": false
    },
    "greer_house": {
      "type": "object",
      "required": ["id", "ordinal", "description", "example_questions", "source"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 12 },
        "ordinal": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "example_questions": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    }
  }
}
